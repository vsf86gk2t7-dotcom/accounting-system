@model AccountingSystem.Models.ViewModels.Reports.CustomerStatementViewModel

@{
	ViewData["Title"] = "كشف حساب عميل";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>كشف حساب عميل</h3>

	<a asp-action="CustomerBalancesReport"
	   asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
	   asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
	   class="btn btn-outline-secondary">
		رجوع لأرصدة العملاء
	</a>
</div>

<form method="get" class="card shadow-sm mb-3">

	<div class="card-body">

		<div class="row g-3 align-items-end">

			<div class="col-md-3">

				<label class="form-label fw-semibold">العميل</label>

				<select name="customerId"
						class="form-select">

					<option value="">
						-- اختر العميل --
					</option>

					@foreach (var customer in Model.Customers)
					{
						<option value="@customer.Key"
								selected="@(Model.CustomerId == customer.Key ? "selected" : null)">
							@customer.Value
						</option>
					}

				</select>

			</div>

			<div class="col-md-2">

				<label class="form-label fw-semibold">من تاريخ</label>

				<input type="date"
					   name="fromDate"
					   class="form-control"
					   value="@Model.FromDate.ToString("yyyy-MM-dd")" />

			</div>

			<div class="col-md-2">

				<label class="form-label fw-semibold">إلى تاريخ</label>

				<input type="date"
					   name="toDate"
					   class="form-control"
					   value="@Model.ToDate.ToString("yyyy-MM-dd")" />

			</div>

			<div class="col-md-2">

				<button type="submit"
						class="btn btn-primary">
					عرض الكشف
				</button>

			</div>

		</div>

	</div>

</form>

@if (Model.CustomerId == 0)
{
	<div class="alert alert-info">
		اختر عميلا ثم اضغط «عرض الكشف».
	</div>
}
else
{
	<h5 class="mb-3">
		العميل: <strong>@Model.CustomerName</strong>
	</h5>

	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>التاريخ</th>
					<th>البيان</th>
					<th>مدين</th>
					<th>دائن</th>
					<th>الرصيد</th>
				</tr>
			</thead>
			<tbody>
				<tr class="table-secondary">
					<td colspan="2"><strong>رصيد افتتاحي</strong></td>
					<td></td>
					<td></td>
					<td>@Model.OpeningBalance.ToString("N2")</td>
				</tr>

				@foreach (var row in Model.Rows)
				{
					<tr>
						<td>@row.Date.ToString("yyyy-MM-dd")</td>
						<td>@row.Description</td>
						<td>@row.Debit.ToString("N2")</td>
						<td>@row.Credit.ToString("N2")</td>
						<td>@row.Balance.ToString("N2")</td>
					</tr>
				}
			</tbody>
			<tfoot class="table-dark fw-bold">
				<tr>
					<td colspan="4">الرصيد الختامي</td>
					<td>@Model.ClosingBalance.ToString("N2")</td>
				</tr>
			</tfoot>
		</table>
	</div>
}