@model AccountingSystem.Models.ViewModels.Reports.InvoiceProfitReportViewModel

@{
	ViewData["Title"] = "تحليل ربحية الفاتورة";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>تحليل ربحية الفاتورة</h3>

	<a asp-action="Index" class="btn btn-outline-secondary">كل التقارير</a>
</div>

<form method="get" class="card shadow-sm mb-3">
	<div class="card-body">
		<div class="row g-3 align-items-end">
			<div class="col-md-3">
				<label class="form-label fw-semibold">من تاريخ</label>
				<input type="date"
					   name="fromDate"
					   class="form-control"
					   value="@Model.FromDate.ToString("yyyy-MM-dd")" />
			</div>

			<div class="col-md-3">
				<label class="form-label fw-semibold">إلى تاريخ</label>
				<input type="date"
					   name="toDate"
					   class="form-control"
					   value="@Model.ToDate.ToString("yyyy-MM-dd")" />
			</div>

			<div class="col-md-3">
				<button type="submit" class="btn btn-primary">عرض التقرير</button>
			</div>
		</div>
	</div>
</form>

<div class="card shadow-sm mb-3">
	<div class="card-body">
		<div class="text-muted small mb-1">
			التكلفة محسوبة من مخصصات الدفعات الفعلية لكل بند.
		</div>

		<div class="table-responsive">
			<table class="table table-striped table-hover mb-0">
				<thead class="table-dark">
					<tr>
						<th>رقم الفاتورة</th>
						<th>التاريخ</th>
						<th>العميل</th>
						<th class="text-end">الإجمالي</th>
						<th class="text-end">الخصم</th>
						<th class="text-end">الصافي</th>
						<th class="text-end">التكلفة</th>
						<th class="text-end">الربح</th>
						<th class="text-end">الهامش %</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var row in Model.Rows)
					{
						<tr>
							<td>@row.InvoiceNumber</td>
							<td>@row.InvoiceDate.ToString("dd/MM/yyyy")</td>
							<td>@row.CustomerName</td>
							<td class="text-end">@row.GrossSales.ToString("N2")</td>
							<td class="text-end">@row.Discount.ToString("N2")</td>
							<td class="text-end">@row.NetSales.ToString("N2")</td>
							<td class="text-end">@row.COGS.ToString("N2")</td>
							<td class="text-end fw-bold @(row.Profit < 0 ? "text-danger" : "text-success")">
								@row.Profit.ToString("N2")
							</td>
							<td class="text-end @(row.MarginPercent < 0 ? "text-danger" : "text-success")">
								@row.MarginPercent.ToString("N2")%
							</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr class="table-light fw-bold">
						<td colspan="2">الإجمالي</td>
						<td></td>
						<td class="text-end">@Model.TotalGrossSales.ToString("N2")</td>
						<td class="text-end">@Model.TotalDiscounts.ToString("N2")</td>
						<td class="text-end">@Model.TotalNetSales.ToString("N2")</td>
						<td class="text-end">@Model.TotalCOGS.ToString("N2")</td>
						<td class="text-end fw-bold @(Model.TotalProfit < 0 ? "text-danger" : "text-success")">
							@Model.TotalProfit.ToString("N2")
						</td>
						<td class="text-end @(Model.OverallMarginPercent < 0 ? "text-danger" : "text-success")">
							@Model.OverallMarginPercent.ToString("N2")%
						</td>
					</tr>
				</tfoot>
			</table>
		</div>

		@if (!Model.Rows.Any())
		{
			<div class="alert alert-info mt-3 mb-0">
				لا توجد فواتير مؤكدة في هذه الفترة.
			</div>
		}
	</div>
</div>

<div class="card shadow-sm">
	<div class="card-header bg-info text-white">
		تفاصيل الصنف - الفاتورة @Model.Rows.Count > 0 ? Model.Rows[0].InvoiceNumber : "-"
	</div>
	<div class="card-body p-3">
		<div class="table-responsive">
			<table class="table table-striped mb-0">
				<thead class="table-dark">
					<tr>
						<th>الصنف</th>
						<th class="text-end">الكمية</th>
						<th class="text-end">صافي البيع</th>
						<th class="text-end">التكلفة</th>
						<th class="text-end">الربح</th>
						<th class="text-end">الهامش %</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var row in Model.Rows.SelectMany(x => x.Items))
					{
						<tr>
							<td>@row.ProductName</td>
							<td class="text-end">@row.Quantity.ToString("N2")</td>
							<td class="text-end">@row.NetSale.ToString("N2")</td>
							<td class="text-end">@row.Cost.ToString("N2")</td>
							<td class="text-end fw-bold @(row.Profit < 0 ? "text-danger" : "text-success")">
								@row.Profit.ToString("N2")
							</td>
							<td class="text-end @(row.MarginPercent < 0 ? "text-danger" : "text-success")">
								@row.MarginPercent.ToString("N2")%
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>