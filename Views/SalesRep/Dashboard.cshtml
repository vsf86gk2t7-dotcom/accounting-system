@model AccountingSystem.ViewModels.SalesRepDashboardViewModel

@{
ViewData["Title"] = "لوحة تحكم المندوب";
var targetPct = Model.MonthlyTarget > 0
? Math.Min(100, (int)(Model.MonthSales * 100 / Model.MonthlyTarget)) : 0;

string CommissionLabel(CommissionType t, decimal r) => t switch
{
CommissionType.PercentOfSales => $"{r:0.##}% من المبيعات",
CommissionType.PercentOfCollections => $"{r:0.##}% من التحصيل",
_ => $"{r:0.##} ج لكل فاتورة"
};

string StatusLabel(SalesInvoiceStatus s) => s switch
{
SalesInvoiceStatus.Draft => "مسودة",
SalesInvoiceStatus.Confirmed => "معتمدة",
SalesInvoiceStatus.Cancelled => "ملغاة",
_ => s.ToString()
};

string StatusBadge(SalesInvoiceStatus s) => s switch
{
SalesInvoiceStatus.Draft => "bg-warning text-dark",
SalesInvoiceStatus.Confirmed => "bg-success",
SalesInvoiceStatus.Cancelled => "bg-danger",
_ => "bg-secondary"
};
}

<style>
.stat-icon {
width: 52px;
height: 52px;
border-radius: 14px;
display: grid;
place-items: center;
font-size: 1.4rem;
flex-shrink: 0;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h2 class="mb-1">مرحبًا، @Model.RepName</h2>
<p class="text-muted mb-0 small">نظرة عامة على أدائك اليومي والشهري @(Model.EmployeePhone != null ? $"— {Model.EmployeePhone}" : "")</p>
</div>
<div class="d-flex gap-2">
<a asp-action="MyCustomers" class="btn btn-outline-primary"><i class="bi bi-people"></i> عملائي</a>
<a asp-action="MyInvoices" class="btn btn-outline-secondary"><i class="bi bi-receipt"></i> فواتيري</a>
</div>
</div>

<div class="row g-3 mb-4">
<div class="col-md-6 col-xl-3">
<div class="card shadow-sm border-0 h-100">
<div class="card-body d-flex align-items-center gap-3">
<div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-calendar-day"></i></div>
<div>
<div class="text-muted small">مبيعات اليوم</div>
<div class="fs-4 fw-bold">@Model.TodaySales.ToString("N2")</div>
</div>
</div>
</div>
</div>
<div class="col-md-6 col-xl-3">
<div class="card shadow-sm border-0 h-100">
<div class="card-body d-flex align-items-center gap-3">
<div class="stat-icon bg-success-subtle text-success"><i class="bi bi-calendar-month"></i></div>
<div>
<div class="text-muted small">مبيعات الشهر</div>
<div class="fs-4 fw-bold">@Model.MonthSales.ToString("N2")</div>
</div>
</div>
</div>
</div>
<div class="col-md-6 col-xl-3">
<div class="card shadow-sm border-0 h-100">
<div class="card-body d-flex align-items-center gap-3">
<div class="stat-icon bg-info-subtle text-info"><i class="bi bi-boxes"></i></div>
<div>
<div class="text-muted small">رصيد العهدة</div>
<div class="fs-4 fw-bold">@Model.CustodyBalance.ToString("N2")</div>
</div>
</div>
</div>
</div>
<div class="col-md-6 col-xl-3">
<div class="card shadow-sm border-0 h-100">
<div class="card-body d-flex align-items-center gap-3">
<div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-wallet2"></i></div>
<div>
<div class="text-muted small">الرصيد النقدي</div>
<div class="fs-4 fw-bold">@Model.CashBalance.ToString("N2")</div>
</div>
</div>
</div>
</div>
</div>

<div class="row g-4">
<div class="col-lg-4">
<div class="card shadow-sm border-0 mb-4">
<div class="card-header bg-white fw-bold"><i class="bi bi-percent"></i> عمولة الشهر</div>
<div class="card-body">
<div class="d-flex justify-content-between align-items-center mb-2">
<span class="text-muted small">العمولة المكتسبة</span>
<span class="fs-4 fw-bold text-success">@Model.CommissionEarned.ToString("N2")</span>
</div>
<div class="d-flex justify-content-between align-items-center">
<span class="text-muted small">نظام العمولة</span>
<span class="badge bg-primary-subtle text-primary">@CommissionLabel(Model.CommissionType, Model.CommissionRate)</span>
</div>
</div>
</div>

<div class="card shadow-sm border-0">
<div class="card-header bg-white fw-bold"><i class="bi bi-bullseye"></i> الهدف الشهري</div>
<div class="card-body">
@if (Model.MonthlyTarget > 0)
{
<div class="d-flex justify-content-between small mb-1">
<span class="text-muted">@Model.MonthSales.ToString("N2") من @Model.MonthlyTarget.ToString("N0")</span>
<span>@targetPct%</span>
</div>
<div class="progress" style="height:8px">
<div class="progress-bar @(targetPct >= 100 ? "bg-success" : "bg-primary")" style="width:@targetPct%"></div>
</div>
}
else
{
<span class="text-muted small">لم يتم تحديد هدف شهري.</span>
}
</div>
</div>
</div>

<div class="col-lg-8">
<div class="card shadow-sm border-0">
<div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
<span><i class="bi bi-receipt"></i> أحدث الفواتير</span>
<a asp-action="MyInvoices" class="small">عرض الكل</a>
</div>
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>الفاتورة</th>
<th>التاريخ</th>
<th>العميل</th>
<th>الحالة</th>
<th class="text-end">الإجمالي</th>
</tr>
</thead>
<tbody>
@foreach (var inv in Model.RecentInvoices)
{
<tr>
<td>
<a asp-controller="SalesInvoice" asp-action="Details" asp-route-id="@inv.Id">@inv.InvoiceNumber</a>
</td>
<td class="small text-muted">@inv.InvoiceDate.ToString("yyyy/MM/dd")</td>
<td>@(inv.Customer?.Name ?? "نقدي")</td>
<td>
<span class="badge @StatusBadge(inv.Status)">@StatusLabel(inv.Status)</span>
</td>
<td class="text-end fw-bold">@inv.TotalAmount.ToString("N2")</td>
</tr>
}
@if (!Model.RecentInvoices.Any())
{
<tr><td colspan="5" class="text-center text-muted py-4">لا توجد فواتير بعد</td></tr>
}
</tbody>
</table>
</div>
</div>
</div>
</div>
