@model AccountingSystem.Models.Category

@{
    ViewData["Title"] = "إضافة تصنيف";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                إضافة تصنيف
            </h2>

            <p class="text-muted mb-0">
                إنشاء تصنيف جديد للمنتجات
            </p>
        </div>

        <a asp-controller="Category"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة للتصنيفات
        </a>

    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="Category"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                        اسم التصنيف
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="مثال: مياه" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                        الوصف
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="وصف اختياري"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Category"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        إلغاء
                    </a>

                    <button type="submit"
                            class="btn btn-success px-4">
                        حفظ التصنيف
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}