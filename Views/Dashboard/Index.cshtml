@model AccountingSystem.Models.ViewModels.Dashboard.DashboardViewModel

@{
	ViewData["Title"] = "لوحة التحكم";
}

<div class="container-fluid px-4 py-4">
	<div class="row g-4">

		<!-- === Summary Cards Row === -->
		<div class="col-md-6 col-xl-3">
			<div class="card bg-primary text-white shadow-sm h-100">
				<div class="card-body">
					<div class="text-muted small">إجمالي المبيعات</div>
					<h4 class="fw-bold mb-0">@Model.GrossSales.ToString("N2") ج.م</h4>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-xl-3">
			<div class="card bg-warning text-dark shadow-sm h-100">
				<div class="card-body">
					<div class="text-muted small">خصومات المبيعات</div>
					<h4 class="fw-bold mb-0">@Model.Discounts.ToString("N2") ج.م</h4>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-xl-3">
			<div class="card bg-success text-white shadow-sm h-100">
				<div class="card-body">
					<div class="text-muted small">صافي المبيعات</div>
					<h4 class="fw-bold mb-0">@Model.NetSales.ToString("N2") ج.م</h4>
				</div>
			</div>
		</div>

		<div class="col-md-6 col-xl-3">
			<div class="card bg-danger text-white shadow-sm h-100">
				<div class="card-body">
					<div class="text-muted small">إجمالي الربح</div>
					<h4 class="fw-bold mb-0">@Model.GrossProfit.ToString("N2") ج.م</h4>
				</div>
			</div>
		</div>

	</div>

	<!-- === Profit Margin === -->
	<div class="col-12 mt-4">
		<div class="card shadow-sm">
			<div class="card-body">
				<h5 class="card-title">هامش الربح الإجمالي</h5>
				<p class="fs-3 mb-0">
					<span class="@(Model.GrossProfit >= 0 ? "text-success" : "text-danger") fw-bold">
						@Model.GrossMarginPercent.ToString("N2")%
					</span>
				</p>
				<p class="text-muted small">
					(صافي المبيعات @Model.NetSales.ToString("N2") ج.م — تكلفة المبيعات @Model.CostOfGoodsSold.ToString("N2") ج.م)
				</p>
			</div>
		</div>
	</div>

	</div>

	<!-- === Loss Analysis Section === -->
	<div class="row mt-5">
		<div class="col-12">
			<div class="card shadow-sm">
				<div class="card-header bg-warning text-dark">
					<h4 class="mb-0">
						<i class="bi bi-exclamation-triangle me-2"></i>
						تحليل الفواتير الخاسرة
					</h4>
				</div>
				<div class="card-body">
					<div class="row g-3">

						@if (Model.LossInvoiceCount == 0)
						{
							<p class="text-success mb-0">لا توجد فواتير خاسرة في الفترة المحددة.</p>
						}
						else
						{
							<div class="col-12">
								<p class="text-muted small mb-2">
									{fmt: "فواتير خاسرة: {0}" - Model.LossInvoiceCount}
								</p>
								<p class="text-muted small mb-2">
									{fmt: "إجمالي الخسائر: {0} ج.م" - Model.TotalLossAmount}
								</p>
							</div>

							<!-- Causes of loss -->
							<div class="col-12 mt-3">
								<h6 class="fw-normal mb-2">أسباب الخسارة:</h6>
								<ul class="list-unstyled">
									@foreach (var reason in Model.LossReasons)
									{
										<li class="d-flex justify-content-between align-items-baseline">
											<span>@reason.Key:</span>
											<span class="text-danger fw-bold">@reason.Value.ToString("N2") ج.م</span>
										</li>
									}
								</ul>
							</div>

							<!-- Top loss invoices table -->
							<div class="col-12 mt-3">
								<h6 class="fw-normal mb-2">أحدث الفواتير الخاسرة:</h6>
								<table class="table table-sm table-striped mb-0">
									<thead class="table-light">
										<tr>
											<th>رقم الفاتورة</th>
											<th>التاريخ</th>
											<th>العميل</th>
											<th class="text-end">الربح</th>
											<th class="text-end">الهامش%</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var loss in Model.LossInvoices)
										{
											<tr>
												<td>@loss.InvoiceNumber</td>
												<td>@loss.InvoiceDate.ToString("dd/MM/yyyy")</td>
												<td>@loss.CustomerName</td>
												<td class="text-end fw-bold @(loss.Profit < 0 ? "text-danger" : "text-success")">
													@loss.Profit.ToString("N2")
												</td>
												<td class="text-end @(loss.MarginPercent < 0 ? "text-danger" : "text-success")">
													@loss.MarginPercent.ToString("N2")%
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- === Action Buttons / Links === -->
	<div class="row mt-4">
		<div class="col-12">
			<a asp-action="LossInvoiceDetails" asp-route-invoiceNumber=""
			   class="btn btn-outline-primary w-100 mt-2">
				<i class="bi bi-eye me-2"></i>
				عرض تفاصيل فاتورة خاسرة
			</a>
		</div>
	</div>
</div>

<script>
    // Helper function for formatted strings in Razor
    function fmt(template) {
        var args = Array.prototype.slice.call(arguments, 1);
        return template.replace(/{(\d+)}/g, function(match, index) {
            return args[index] !== undefined ? args[index] : match;
        });
    }
</script>