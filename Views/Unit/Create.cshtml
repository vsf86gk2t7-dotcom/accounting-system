@model AccountingSystem.Models.Unit

@{
    ViewData["Title"] = "إضافة وحدة";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                إضافة وحدة
            </h2>

            <p class="text-muted mb-0">
                إضافة وحدة جديدة لاستخدامها مع المنتجات
            </p>
        </div>

        <a asp-controller="Unit"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة للوحدات
        </a>

    </div>

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-controller="Unit"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                        اسم الوحدة
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="مثال: قطعة" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="ShortName"
                           class="form-label fw-semibold">
                        الاختصار
                    </label>

                    <input asp-for="ShortName"
                           class="form-control"
                           placeholder="مثال: ق" />

                    <span asp-validation-for="ShortName"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Unit"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        إلغاء
                    </a>

                    <button type="submit"
                            class="btn btn-success px-4">
                        حفظ الوحدة
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}