@model List<AccountingSystem.Models.Unit>

@{
    ViewData["Title"] = "الوحدات";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                الوحدات
            </h2>

            <p class="text-muted mb-0">
                إدارة وحدات قياس وبيع المنتجات
            </p>
        </div>

        <a asp-controller="Unit"
           asp-action="Create"
           class="btn btn-primary">
            + إضافة وحدة
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            لا توجد وحدات مسجلة حاليًا.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    اسم الوحدة
                                </th>

                                <th>
                                    الاختصار
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    الإجراء
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var unit in Model)
                            {
                                <tr>

                                    <td>
                                        @unit.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @unit.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(unit.ShortName)
                                            ? "-"
                                            : unit.ShortName)
                                    </td>

                                    <td>

                                        @if (unit.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                نشطة
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                غير نشطة
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Unit"
                                           asp-action="Edit"
                                           asp-route-id="@unit.Id"
                                           class="btn btn-warning btn-sm">
                                            ✏ تعديل
                                        </a>

                                        <form asp-controller="Unit"
                                              asp-action="ToggleActive"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@unit.Id" />

                                            @if (unit.IsActive)
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">
                                                    تعطيل
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm">
                                                    تفعيل
                                                </button>
                                            }

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>