@using AccountingSystem.Models.ViewModels.Inventory
@model InventoryTransactionsViewModel

@{
	ViewData["Title"] = "سجل حركات المخزون";

	string TypeLabel(AccountingSystem.Models.StockTransactionType t)
	{
		return t switch
		{
			AccountingSystem.Models.StockTransactionType.Receive => "استلام",
			AccountingSystem.Models.StockTransactionType.Issue => "صرف",
			AccountingSystem.Models.StockTransactionType.Transfer => "تحويل",
			AccountingSystem.Models.StockTransactionType.Adjust => "تسوية",
			AccountingSystem.Models.StockTransactionType.Count => "جرد",
			_ => "حركة"
		};
	}

	string TypeBadge(AccountingSystem.Models.StockTransactionType t)
	{
		return t switch
		{
			AccountingSystem.Models.StockTransactionType.Receive => "bg-success",
			AccountingSystem.Models.StockTransactionType.Issue => "bg-danger",
			AccountingSystem.Models.StockTransactionType.Transfer => "bg-primary",
			AccountingSystem.Models.StockTransactionType.Adjust => "bg-warning text-dark",
			AccountingSystem.Models.StockTransactionType.Count => "bg-secondary",
			_ => "bg-dark"
		};
	}
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>سجل حركات المخزون</h3>

	<a asp-action="Index" class="btn btn-outline-secondary">
		العودة للأرصدة
	</a>
</div>

<form method="get"
	  asp-action="Transactions"
	  class="card shadow-sm mb-3">
	<div class="card-body py-3">
		<div class="row g-2 align-items-end">

			<div class="col-md-4">

				<label class="form-label mb-1">
					المخزن
				</label>

				<select name="storeId"
						class="form-select">

					<option value="">
						جميع المخازن
					</option>

					@foreach (var store in Model.Stores)
					{
						<option value="@store.Key"
								selected=@(store.Key == Model.StoreId ? "selected" : null)>
							@store.Value
						</option>
					}

				</select>

			</div>

			<div class="col-md-4">

				<label class="form-label mb-1">
					نوع الحركة
				</label>

				<select name="type"
						class="form-select">

					<option value="">
						جميع الحركات
					</option>

					@foreach (var t in Enum.GetValues<AccountingSystem.Models.StockTransactionType>())
					{
						<option value="@((int)t)"
								selected=@(Model.Type.HasValue && Model.Type.Value == t ? "selected" : null)>
							@TypeLabel(t)
						</option>
					}

				</select>

			</div>

			<div class="col-md-4 d-flex gap-2 align-items-end">

				<button type="submit"
						class="btn btn-primary w-100">
					عرض
				</button>

				<a asp-action="Transactions"
				   class="btn btn-outline-secondary">
					مسح
				</a>

			</div>

		</div>
	</div>
</form>

@if (Model.Rows == null || Model.Rows.Count == 0)
{
	<div class="alert alert-info">
		لا توجد حركات مخزون مطابقة.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>المستند</th>
					<th>النوع</th>
					<th>من</th>
					<th>إلى</th>
					<th>عدد البنود</th>
					<th>بواسطة</th>
					<th>التاريخ</th>
					<th>تفاصيل</th>
				</tr>
			</thead>
			<tbody>

				@foreach (var row in Model.Rows)
				{
					<tr>
						<td>
							<strong>@row.TransactionNumber</strong>
						</td>
						<td>
							<span class="badge @TypeBadge(row.Type)">
								@TypeLabel(row.Type)
							</span>
						</td>
						<td>@(row.FromStoreName ?? "-")</td>
						<td>@(row.ToStoreName ?? "-")</td>
						<td>@row.ItemCount</td>
						<td>@(row.CreatedByUserName ?? "-")</td>
						<td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
						<td>

							<button type="button"
									class="btn btn-outline-primary btn-sm"
									data-bs-toggle="collapse"
									data-bs-target="#tx@(row.Id)">
								عرض البنود
							</button>

						</td>
					</tr>

					<tr class="collapse"
						id="tx@(row.Id)">
						<td colspan="8">

							<div class="p-3">

								@if (!string.IsNullOrWhiteSpace(row.Notes))
								{
									<p class="mb-2">
										<small>
											<strong>ملاحظات:</strong>
											@row.Notes
										</small>
									</p>
								}

								<table class="table table-sm table-bordered mb-0">

									<thead class="table-light">
										<tr>
											<th>المنتج</th>
											<th>الكمية</th>
											<th>تكلفة الوحدة</th>
											<th>التكلفة الإجمالية</th>
										</tr>
									</thead>

									<tbody>

										@foreach (var line in row.Items)
										{
											<tr>
												<td>@line.ProductName</td>
												<td>@line.Quantity.ToString("N3")</td>
												<td>@line.UnitCost.ToString("N4")</td>
												<td>@((line.Quantity * line.UnitCost).ToString("N2"))</td>
											</tr>
										}

									</tbody>

								</table>

							</div>

						</td>
					</tr>
				}

			</tbody>
		</table>
	</div>
}