@model AccountingSystem.Models.ViewModels.Accounting.ChartAccountsViewModel

@{
	ViewData["Title"] = "شجرة الحسابات";

	string TypeLabel(AccountingSystem.Models.AccountType t)
	{
		return t switch
		{
			AccountingSystem.Models.AccountType.Asset => "أصل",
			AccountingSystem.Models.AccountType.Liability => "التزام",
			AccountingSystem.Models.AccountType.Equity => "حقوق ملكية",
			AccountingSystem.Models.AccountType.Revenue => "إيراد",
			AccountingSystem.Models.AccountType.Expense => "مصروف",
			_ => "-"
		};
	}
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>شجرة الحسابات</h3>

	<div>
		<a asp-action="Journal" class="btn btn-outline-primary">القيود</a>
		<a asp-action="Ledger" class="btn btn-outline-primary">دفتر الأستاذ</a>
		<a asp-action="TrialBalance" class="btn btn-outline-secondary">ميزان المراجعة</a>
		<a asp-action="IncomeStatement" class="btn btn-outline-secondary">قائمة الدخل</a>
		<a asp-action="BalanceSheet" class="btn btn-outline-secondary">الميزانية</a>
	</div>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<form asp-action="CreateAccount"
	  method="post"
	  class="card shadow-sm mb-3">

	@Html.AntiForgeryToken()

	<div class="card-header">
		<h5 class="mb-0">إضافة حساب جديد</h5>
	</div>

	<div class="card-body">

		<div class="row g-3">

			<div class="col-md-2">

				<label class="form-label fw-semibold">
					الكود (اختياري)
				</label>

				<input name="Code"
					   class="form-control"
					   placeholder="مثال: 1100" />

			</div>

			<div class="col-md-3">

				<label class="form-label fw-semibold">
					اسم الحساب
				</label>

				<input name="Name"
					   class="form-control"
					   placeholder="مثال: الصندوق" />

			</div>

			<div class="col-md-2">

				<label class="form-label fw-semibold">
					نوع الحساب
				</label>

				<select name="Type"
						class="form-select">

					<option value="">— اختر النوع —</option>

					@foreach (var t in Enum.GetValues<AccountingSystem.Models.AccountType>())
					{
						<option value="@((int)t)">@TypeLabel(t)</option>
					}

				</select>

			</div>

			<div class="col-md-3">

				<label class="form-label fw-semibold">
					الحساب الأب (اختياري)
				</label>

				<select name="ParentId"
						class="form-select">

					<option value="">— بدون أب (جذر) —</option>

					@foreach (var p in Model.ParentOptions)
					{
						<option value="@p.Id"
								data-type="@((int)p.Type)">
							@(new string('\u00A0', p.Depth * 3))@p.Name
						</option>
					}

				</select>

			</div>

			<div class="col-md-2 d-flex align-items-end">

				<button type="submit"
						class="btn btn-success w-100">
					إضافة
				</button>

			</div>

		</div>

	</div>

</form>

@if (Model.Rows.Count == 0)
{
	<div class="alert alert-info">
		لا توجد حسابات بعد. أضف أول حساب من النموذج أعلاه.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>الكود</th>
					<th>اسم الحساب</th>
					<th>النوع</th>
					<th>الحالة</th>
					<th>إجراء</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var row in Model.Rows)
				{
					<tr style="@(row.Depth == 0 ? "background-color:#f2f5fc;" : "")">
						<td>@(row.Code ?? "-")</td>
						<td>
							<div style="margin-inline-start: @(row.Depth * 22)px;">
								<strong>@row.Name</strong>

								@if (row.IsSystem)
								{
									<span class="badge bg-info ms-1">نظامي</span>
								}
							</div>
						</td>
						<td>@TypeLabel(row.Type)</td>
						<td>
							@if (row.IsActive)
							{
								<span class="badge bg-success">نشط</span>
							}
							else
							{
								<span class="badge bg-secondary">معطل</span>
							}
						</td>
						<td>
							@if (!row.IsSystem)
							{
								<form asp-action="ToggleAccount"
									  asp-route-id="@row.Id"
									  method="post"
									  class="d-inline">

									@Html.AntiForgeryToken()

									<button type="submit"
											class="btn btn-outline-warning btn-sm">
										@(row.IsActive ? "إيقاف" : "تفعيل")
									</button>

								</form>
							}
							else
							{
								<span class="text-muted small">—</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}