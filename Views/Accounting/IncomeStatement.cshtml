@model AccountingSystem.Models.ViewModels.Accounting.IncomeStatementViewModel

@{
	ViewData["Title"] = "قائمة الدخل";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>قائمة الدخل</h3>

	<div>
		<a asp-action="BalanceSheet" class="btn btn-outline-primary">الميزانية العمومية</a>
		<a asp-action="TrialBalance" class="btn btn-outline-secondary">ميزان المراجعة</a>
	</div>
</div>

<!-- الفلتر -->
<form method="get" class="card mb-3">
	<div class="card-body row g-2 align-items-end">
		<div class="col-md-4">
			<label class="form-label">من تاريخ</label>
			<input type="date"
				   name="fromDate"
				   class="form-control"
				   value="@Model.FromDate.ToString("yyyy-MM-dd")" />
		</div>

		<div class="col-md-4">
			<label class="form-label">إلى تاريخ</label>
			<input type="date"
				   name="toDate"
				   class="form-control"
				   value="@Model.ToDate.ToString("yyyy-MM-dd")" />
		</div>

		<div class="col-md-4">
			<button type="submit" class="btn btn-primary w-100">عرض</button>
		</div>
	</div>
</form>

<div class="card mb-3">
	<div class="card-header bg-dark text-white">
		الإيرادات
	</div>
	<div class="card-body">
		@if (Model.RevenueLines.Count == 0 && Model.TotalDiscounts == 0)
		{
			<p class="text-muted mb-0">لا توجد إيرادات في الفترة.</p>
		}
		else
		{
			<table class="table table-sm mb-2">
				<tbody>
					@foreach (var line in Model.RevenueLines)
					{
						<tr>
							<td>
								@(line.Code != null ? $"[{line.Code}] " : "")
								@line.Name
							</td>
							<td class="text-end">@line.Amount.ToString("N2")</td>
						</tr>
					}
					@if (Model.TotalDiscounts > 0)
					{
						<tr>
							<td>
								[4901] خصومات المبيعات
							</td>
							<td class="text-end text-danger">
								(−@Model.TotalDiscounts.ToString("N2"))
							</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr class="fw-bold table-light">
						<td>صافي الإيرادات</td>
						<td class="text-end text-success">
							@Model.TotalRevenue.ToString("N2")
						</td>
					</tr>
				</tfoot>
			</table>
		}
	</div>
</div>

<div class="card mb-3">
	<div class="card-header bg-dark text-white">
		المصروفات
	</div>
	<div class="card-body">
		@if (Model.ExpenseCategories.Count == 0)
		{
			<p class="text-muted mb-0">لا توجد مصروفات في الفترة.</p>
		}
		else
		{
			@foreach (var category in Model.ExpenseCategories)
			{
				<h6 class="fw-bold border-bottom border-secondary pb-1 mt-3 mb-1">
					@category.Name
					<span class="text-danger">(@category.Amount.ToString("N2"))</span>
				</h6>

				<table class="table table-sm mb-2">
					<tbody>
						@foreach (var line in category.Lines)
						{
							<tr>
								<td>
									@(line.Code != null ? $"[{line.Code}] " : "")
									@line.Name
								</td>
								<td class="text-end">@line.Amount.ToString("N2")</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<table class="table table-sm mb-0">
				<tfoot>
					<tr class="fw-bold table-light">
						<td>إجمالي المصروفات</td>
						<td class="text-end text-danger">
							@Model.TotalExpenses.ToString("N2")
						</td>
					</tr>
				</tfoot>
			</table>
		}
	</div>
</div>

<div class="alert @(Model.NetIncome >= 0 ? "alert-success" : "alert-danger") fs-5">
	<div class="d-flex justify-content-between">
		<strong>صافي الربح (الخسارة)</strong>
		<strong>@Model.NetIncome.ToString("N2")</strong>
	</div>
</div>