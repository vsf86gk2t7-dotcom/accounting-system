@model List<AccountingSystem.Models.EmployeeDeduction>

@{
	ViewData["Title"] = "خصومات الموظفين";

	var employees = ViewBag.Employees as List<AccountingSystem.Models.Employee>
		?? new List<AccountingSystem.Models.Employee>();

	var search = ViewBag.Search as string ?? "";
	var employeeId = ViewBag.EmployeeId as int?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="mb-1">خصومات الموظفين</h2>
		<p class="text-muted mb-0 small">إدارة خصومات رواتب الموظفين</p>
	</div>
	<a asp-action="Create" class="btn btn-success">إضافة خصم</a>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="card mb-3 shadow-sm border-0">
	<div class="card-body">
		<form asp-action="Index" method="get">
			<div class="row g-2">
				<div class="col-md-4">
					<input type="text" name="search" value="@search"
						   class="form-control" placeholder="🔎 بحث باسم الموظف أو السبب" />
				</div>
				<div class="col-md-3">
					<select name="employeeId" class="form-select">
						<option value="">كل الموظفين</option>
						@foreach (var emp in employees)
						{
							<option value="@emp.Id" selected="@(employeeId == emp.Id)">@emp.Name</option>
						}
					</select>
				</div>
				<div class="col-md-2">
					<button type="submit" class="btn btn-secondary w-100">تصفية</button>
				</div>
			</div>
		</form>
	</div>
</div>

@if (Model == null || !Model.Any())
{
	<div class="alert alert-info">لا يوجد خصومات مسجلة حتى الآن.</div>
}
else
{
	<div class="card border-0 shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover mb-0">
					<thead class="table-light">
						<tr>
							<th>الموظف</th>
							<th>المبلغ</th>
							<th>السبب</th>
							<th>التاريخ</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>
									<div class="fw-semibold">@(item.Employee?.Name ?? "-")</div>
								</td>
								<td>@item.Amount.ToString("N2")</td>
								<td>@item.Reason</td>
								<td>@item.Date.ToString("yyyy-MM-dd")</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
