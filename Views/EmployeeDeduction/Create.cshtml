@model AccountingSystem.Models.EmployeeDeduction

@{
	ViewData["Title"] = "إضافة خصم";

	var employees = ViewBag.Employees as List<AccountingSystem.Models.Employee>
		?? new List<AccountingSystem.Models.Employee>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="mb-1">إضافة خصم جديد</h2>
		<p class="text-muted mb-0 small">تسجيل خصم على راتب موظف</p>
	</div>
	<a asp-action="Index" class="btn btn-outline-secondary">← رجوع</a>
</div>

<div class="card shadow-sm border-0">
	<div class="card-body">
		<form asp-action="Create" method="post">
			@Html.AntiForgeryToken()

			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="row g-3">
				<div class="col-md-6">
					<label asp-for="EmployeeId" class="form-label">الموظف <span class="text-danger">*</span></label>
					<select asp-for="EmployeeId" class="form-select" required>
						<option value="">اختر الموظف</option>
						@foreach (var emp in employees)
						{
							<option value="@emp.Id">@emp.Name</option>
						}
					</select>
					<span asp-validation-for="EmployeeId" class="text-danger small"></span>
				</div>

				<div class="col-md-6">
					<label asp-for="Amount" class="form-label">المبلغ <span class="text-danger">*</span></label>
					<input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
					<span asp-validation-for="Amount" class="text-danger small"></span>
				</div>

				<div class="col-md-6">
					<label asp-for="Date" class="form-label">التاريخ <span class="text-danger">*</span></label>
					<input asp-for="Date" type="date" class="form-control" required />
					<span asp-validation-for="Date" class="text-danger small"></span>
				</div>

				<div class="col-12">
					<label asp-for="Reason" class="form-label">السبب <span class="text-danger">*</span></label>
					<textarea asp-for="Reason" class="form-control" rows="3" maxlength="500"
							  placeholder="اكتب سبب الخصم" required></textarea>
					<span asp-validation-for="Reason" class="text-danger small"></span>
				</div>
			</div>

			<hr class="my-4" />

			<button type="submit" class="btn btn-success">حفظ الخصم</button>
		</form>
	</div>
</div>
