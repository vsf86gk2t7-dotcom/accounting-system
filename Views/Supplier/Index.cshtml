@model List<AccountingSystem.Models.Supplier>

@{
	ViewData["Title"] = "الموردون";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>الموردون</h3>

	<div>
		<a asp-action="PortalRequests" class="btn btn-outline-info">
			طلبات الحسابات
		</a>
		<a asp-controller="Reports"
		   asp-action="SupplierBalancesReport"
		   class="btn btn-primary">
			أرصدة الموردين
		</a>
		<a asp-action="Create" class="btn btn-primary">
			+ إضافة مورد
		</a>
	</div>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (Model == null || !Model.Any())
{
	<div class="alert alert-info">
		لا يوجد موردون حتى الآن.
	</div>
}
else
{
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				<th>#</th>
				<th>الاسم</th>
				<th>الهاتف</th>
				<th>البريد</th>
				<th>الرصيد الافتتاحي</th>
				<th>الحالة</th>
				<th>حساب البوابة</th>
				<th>إجراءات</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var supplier in Model)
			{
				<tr>
					<td>@supplier.Id</td>
					<td>@supplier.Name</td>
					<td>@(supplier.Phone ?? "-")</td>
					<td>@(supplier.Email ?? "-")</td>
					<td>@supplier.OpeningBalance.ToString("N2")</td>
					<td>
						@if (supplier.IsActive)
						{
							<span class="badge bg-success">نشط</span>
						}
						else
						{
							<span class="badge bg-secondary">معطل</span>
						}
					</td>
					<td>
						@if (supplier.HasPortalAccount)
						{
							<span class="badge bg-primary">مُنشأ</span>
						}
						else if (supplier.PortalApproved)
						{
							<span class="badge bg-info text-dark">تمت الموافقة</span>
						}
						else if (supplier.PortalRequested)
						{
							<span class="badge bg-warning text-dark">في انتظار الموافقة</span>
						}
						else
						{
							<span class="badge bg-light text-dark">لا يوجد</span>
						}
					</td>
					<td>
						<a asp-action="Edit"
						   asp-route-id="@supplier.Id"
						   class="btn btn-sm btn-outline-primary">
							تعديل
						</a>

						<form asp-action="ToggleActive"
							  asp-route-id="@supplier.Id"
							  method="post"
							  class="d-inline">
							@Html.AntiForgeryToken()
							<button type="submit"
									class="btn btn-sm @(supplier.IsActive ? "btn-outline-warning" : "btn-outline-success")">
								@(supplier.IsActive ? "تعطيل" : "تفعيل")
							</button>
						</form>

						@if (!supplier.PortalRequested &&
							 !supplier.HasPortalAccount &&
							 supplier.IsActive &&
							 !string.IsNullOrWhiteSpace(supplier.Phone))
						{
							<form asp-action="RequestPortal"
								  asp-route-id="@supplier.Id"
								  method="post"
								  class="d-inline">
								@Html.AntiForgeryToken()
								<button type="submit"
										class="btn btn-sm btn-outline-info"
										onclick="return confirm('سيتم إرسال طلب حساب بوابة لهذا المورد. متابعة؟');">
									طلب حساب بوابة
								</button>
							</form>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}