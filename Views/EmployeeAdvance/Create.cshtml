@{
ViewData["Title"] = "صرف سلفة";

var employees = ViewBag.Employees as IEnumerable<dynamic>
?? Enumerable.Empty<dynamic>();

var cashAccounts = ViewBag.CashAccounts as IEnumerable<dynamic>
?? Enumerable.Empty<dynamic>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
<h2 class="mb-0">صرف سلفة لموظف</h2>
<a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
</div>

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0">
<div class="card-body">
<form asp-action="Create" method="post">
@Html.AntiForgeryToken()

<div class="row g-3">
<div class="col-md-6">
<label class="form-label">الموظف *</label>
<select name="employeeId" class="form-select" required>
<option value="">— اختر الموظف —</option>
@foreach (var e in employees)
{
<option value="@e.Id">@e.Name</option>
}
</select>
</div>

<div class="col-md-6">
<label class="form-label">المبلغ *</label>
<input name="amount" type="number" step="0.01" min="0.01"
   class="form-control" required />
</div>

<div class="col-md-6">
<label class="form-label">التاريخ *</label>
<input name="date" type="date" class="form-control"
   value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
</div>

<div class="col-md-6">
<label class="form-label">الخزنة *</label>
<select name="cashAccountId" class="form-select" required>
<option value="">— اختر الخزنة —</option>
@foreach (var c in cashAccounts)
{
<option value="@c.Id">@c.Name</option>
}
</select>
</div>

<div class="col-12">
<label class="form-label">السبب (اختياري)</label>
<textarea name="reason" class="form-control" rows="2" maxlength="500"></textarea>
</div>
</div>

<div class="alert alert-info mt-3 small">
<i class="bi bi-info-circle"></i>
سيتم ترحيل قيد: مدين سلف موظفين (1107) / دائن الخزنة.
</div>

<button type="submit" class="btn btn-primary">حفظ وصرف</button>
</form>
</div>
</div>