@model List<AccountingSystem.Models.Product>

@{
    ViewData["Title"] = "المنتجات";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                المنتجات
            </h2>

            <p class="text-muted mb-0">
                إدارة المنتجات والوحدات وأسعار البيع
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Create"
           class="btn btn-primary">
            إضافة منتج
        </a>

    </div>


    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            لا توجد منتجات مسجلة حاليًا.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    المنتج
                                </th>

                                <th>
                                    الباركود
                                </th>

                                <th>
                                    الكود
                                </th>

                                <th>
                                    الوحدات
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    إجراءات
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var product in Model)
                            {
                                <tr>

                                    <td>
                                        @product.Id
                                    </td>

                                    <td>
                                        <strong>
                                            @product.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(product.Barcode)
                                            ? "-"
                                            : product.Barcode)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(product.Code)
                                            ? "-"
                                            : product.Code)
                                    </td>

                                    <td>

                                        @if (product.ProductUnits != null &&
                                             product.ProductUnits.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">

                                                @foreach (var productUnit in product.ProductUnits)
                                                {
                                                    <span class="badge bg-secondary">
                                                        @(productUnit.Unit?.Name ?? "وحدة")
                                                        -
                                                        @productUnit.SalePrice.ToString("N2")
                                                    </span>
                                                }

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                لا توجد وحدات
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (product.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                نشط
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                غير نشط
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            تعديل
                                        </a>

                                        <form asp-controller="Product"
                                              asp-action="ToggleActive"
                                              asp-route-id="@product.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-warning btn-sm">
                                                @(product.IsActive ? "إيقاف" : "تفعيل")
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>