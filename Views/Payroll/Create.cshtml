@{
ViewData["Title"] = "شهر رواتب جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
<h2 class="mb-0">شهر رواتب جديد</h2>
<a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
</div>

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0">
<div class="card-body">
<form asp-action="Create" method="post">
@Html.AntiForgeryToken()

<div class="row g-3">
<div class="col-md-4">
<label class="form-label">اسم الشهر *</label>
<input name="periodName" class="form-control" required
   value="@ViewBag.PeriodName" placeholder="2026-10" />
<small class="text-muted">مثال: 2026-10</small>
</div>

<div class="col-md-4">
<label class="form-label">من تاريخ *</label>
<input name="periodStart" type="date" class="form-control" required
   value="@ViewBag.PeriodStart" />
</div>

<div class="col-md-4">
<label class="form-label">إلى تاريخ *</label>
<input name="periodEnd" type="date" class="form-control" required
   value="@ViewBag.PeriodEnd" />
</div>
</div>

<div class="alert alert-info mt-3 small">
<i class="bi bi-info-circle"></i>
سيتم إنشاء مسودة برواتب كل الموظفين النشطين مع:
<ul class="mb-0 mt-1">
<li>خصومات الغياب محسوبة من الحضور</li>
<li>خصومات التأخير محسوبة من ساعة الحضور</li>
<li>الخصومات اليدوية من سجل الموظف</li>
<li>السلف غير المخصومة</li>
<li>عمولات المناديب</li>
</ul>
</div>

<button type="submit" class="btn btn-primary">إنشاء المسودة</button>
</form>
</div>
</div>