@{
ViewData["Title"] = "صرف رواتب " + ViewBag.PeriodName;

var cashAccounts = ViewBag.CashAccounts as IEnumerable<dynamic>
?? Enumerable.Empty<dynamic>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
<h2 class="mb-0">صرف رواتب @ViewBag.PeriodName</h2>
<a asp-action="Details" asp-route-id="@ViewBag.RunId" class="btn btn-outline-secondary">رجوع</a>
</div>

@if (TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0">
<div class="card-body">
<form asp-action="Pay" asp-route-id="@ViewBag.RunId" method="post">
@Html.AntiForgeryToken()

<div class="alert alert-warning">
<i class="bi bi-exclamation-triangle"></i>
سيتم صرف <strong>@(((decimal)ViewBag.TotalNet).ToString("N2"))</strong> جنيه من الخزنة المختارة.
</div>

<div class="mb-3">
<label class="form-label">الخزنة / البنك *</label>
<select name="cashAccountId" class="form-select" required>
<option value="">— اختر الخزنة —</option>
@foreach (var c in cashAccounts)
{
<option value="@c.Id">@c.Name</option>
}
</select>
</div>

<button type="submit" class="btn btn-primary"
onclick="return confirm('تأكيد صرف الرواتب؟')">
<i class="bi bi-cash-stack"></i> صرف الآن
</button>
</form>
</div>
</div>