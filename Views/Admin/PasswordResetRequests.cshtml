@model List<AccountingSystem.Models.PasswordResetRequest>

@{
	ViewData["Title"] = "طلبات استعادة كلمة المرور";
	var filter = ViewBag.Filter as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<h2>طلبات استعادة كلمة المرور</h2>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<!-- الفلتر -->
<div class="btn-group mb-4">
	<a asp-action="PasswordResetRequests"
	   class="btn @(string.IsNullOrEmpty(filter) ? "btn-primary" : "btn-outline-primary")">
		الكل
	</a>

	<a asp-action="PasswordResetRequests"
	   asp-route-filter="pending"
	   class="btn @(filter == "pending" ? "btn-primary" : "btn-outline-primary")">
		⏳ معلّقة
	</a>

	<a asp-action="PasswordResetRequests"
	   asp-route-filter="expired"
	   class="btn @(filter == "expired" ? "btn-primary" : "btn-outline-primary")">
		⚠️ منتهية
	</a>

	<a asp-action="PasswordResetRequests"
	   asp-route-filter="sent"
	   class="btn @(filter == "sent" ? "btn-primary" : "btn-outline-primary")">
		📤 تم الإرسال
	</a>

	<a asp-action="PasswordResetRequests"
	   asp-route-filter="completed"
	   class="btn @(filter == "completed" ? "btn-primary" : "btn-outline-primary")">
		✅ مكتملة
	</a>
</div>

@if (Model == null || !Model.Any())
{
	<div class="alert alert-info">
		لا يوجد طلبات استعادة كلمة مرور حاليًا.
	</div>
}
else
{
	<div class="row">
		@foreach (var request in Model)
		{
			var isExpired =
				!request.IsCompleted &&
				request.ExpiresAt < DateTime.Now;

			var statusColor = request.IsCompleted
				? "success"
				: isExpired
					? "danger"
					: request.IsSent
						? "info"
						: "warning";

			var statusText = request.IsCompleted
				? "✅ مكتملة"
				: isExpired
					? "⚠️ منتهية"
					: request.IsSent
						? "📤 تم الإرسال"
						: "⏳ في الانتظار";

			<div class="col-lg-6 mb-4">
				<div class="card border-@statusColor">
					<div class="card-header bg-@statusColor text-white d-flex justify-content-between align-items-center">
						<span>@request.UserName</span>
						<span class="badge bg-light text-dark">@statusText</span>
					</div>

					<div class="card-body">

						<div class="row">
							<div class="col-md-7">

								<p class="mb-2">
									<strong>الهاتف:</strong>
									@request.Phone
								</p>

								<p class="mb-2">
									<strong>النوع:</strong>
									@switch (request.UserType)
									{
										case AccountingSystem.Models.UserType.Customer:
											<span>👤 عميل</span>
											break;
										case AccountingSystem.Models.UserType.Supplier:
											<span>🧑‍💼 مورد</span>
											break;
										case AccountingSystem.Models.UserType.Employee:
											<span>👨‍💼 موظف</span>
											break;
										default:
											<span>@request.UserType</span>
											break;
									}
								</p>

								<p class="mb-2">
									<strong>تاريخ الطلب:</strong>
									@request.RequestedAt.ToString("yyyy-MM-dd HH:mm")
								</p>

								<p class="mb-3">
									<strong>ينتهي:</strong>
									@request.ExpiresAt.ToString("yyyy-MM-dd HH:mm")
								</p>

								<!-- الكود -->
								<div class="alert alert-secondary mb-3">
									<small class="text-muted d-block mb-1">الكود (مُهشّر):</small>
									<span style="font-size: 0.85rem; font-family: monospace;">
										@request.CodeHash.Substring(0, Math.Min(16, @request.CodeHash.Length))...
									</span>
								</div>

								<!-- لينك الاستعادة -->
								<p class="mb-2">
									<strong>لينك الاستعادة:</strong>
								</p>

								@{
									var resetUrl =
										$"{Context.Request.Scheme}://{Context.Request.Host}/Account/ResetPassword?phone={request.Phone}";
								}

								<a href="@resetUrl"
								   target="_blank"
								   style="word-break: break-all; font-size: 0.85rem;">
									@resetUrl
								</a>

								<!-- أزرار -->
								<div class="mt-3 d-flex gap-2 flex-wrap">

									<button type="button"
											class="btn btn-sm btn-outline-primary"
											onclick="navigator.clipboard.writeText('@request.CodeHash'); this.textContent='✅ تم';">
										📋 نسخ الكود
									</button>

									<button type="button"
											class="btn btn-sm btn-outline-primary"
											onclick="navigator.clipboard.writeText('@resetUrl'); this.textContent='✅ تم';">
										📋 نسخ اللينك
									</button>

									@if (!request.IsSent && !request.IsCompleted)
									{
										<form asp-action="MarkAsSent"
											  asp-route-id="@request.Id"
											  method="post"
											  class="d-inline">
											@Html.AntiForgeryToken()
											<button type="submit"
													class="btn btn-sm btn-success">
												📤 تم الإرسال
											</button>
										</form>
									}

								</div>

								@if (request.IsSent && request.SentAt.HasValue)
								{
									<p class="text-muted small mt-2 mb-0">
										📤 تم الإرسال في: @request.SentAt.Value.ToString("yyyy-MM-dd HH:mm")
									</p>
								}

							</div>

							<div class="col-md-5 text-center">

								<p class="mb-2">
									<strong>QR Code</strong>
								</p>

								@{
									var qrService = Context.RequestServices
										.GetService<AccountingSystem.Services.QrCode.IQrCodeService>();

									var qr = qrService?.GenerateQrCode(resetUrl) ?? "";
								}

								@if (!string.IsNullOrEmpty(qr))
								{
									<a href="@resetUrl" target="_blank">
										<img src="data:image/png;base64,@qr"
											 alt="QR"
											 style="max-width: 180px; border: 1px solid #e5e7eb; border-radius: 12px; padding: 8px; cursor: pointer;" />
									</a>

									<p class="text-muted small mt-2">
										(اضغط لفتح اللينك)
									</p>
								}

							</div>
						</div>

					</div>
				</div>
			</div>
		}
	</div>
}