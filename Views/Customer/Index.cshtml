@model IEnumerable<AccountingSystem.Models.Customer>

@{
    ViewData["Title"] = "العملاء";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>العملاء</h2>

        <div class="d-flex gap-2">
            <a asp-action="PortalRequests"
               class="btn btn-outline-info">
                🔔 طلبات الحسابات
            </a>
            <a asp-controller="Reports"
               asp-action="CustomerBalancesReport"
               class="btn btn-primary">
                أرصدة العملاء
            </a>
            <a asp-action="Create"
               class="btn btn-primary">
                + إضافة عميل
            </a>
        </div>
    </div>
    <form asp-action="Index"
          method="get"
          class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="ابحث بالاسم أو الهاتف أو البريد..." />

            <button type="submit"
                    class="btn btn-secondary">
                بحث
            </button>

        </div>

    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead>
                        <tr>
                            <th>الرقم</th>
                            <th>الاسم</th>
                            <th>الهاتف</th>
                            <th>البريد</th>
                            <th>الرصيد الافتتاحي</th>
                            <th>الحالة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var customer in Model)
                        {
                            <tr>

                                <td>@customer.Id</td>

                                <td>@customer.Name</td>

                                <td>@customer.Phone</td>

                                <td>@customer.Email</td>

                                <td>
                                    @customer.OpeningBalance.ToString("N2")
                                    ج.م
                                </td>

                                <td>
                                    @if (customer.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            غير نشط
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (customer.PortalApproved)
                                    {
                                        <span class="badge bg-success">
                                            الحساب مفعل
                                        </span>
                                    }
                                    else if (customer.PortalRequested)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            في انتظار الموافقة
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-action="RequestPortal"
                                              asp-route-id="@customer.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-primary">
                                                طلب حساب دخول
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit"
                                       asp-route-id="@customer.Id"
                                       class="btn btn-warning btn-sm">
                                        ✏ تعديل
                                    </a>

                                    <form asp-action="ToggleActive"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@customer.Id" />

                                        @if (customer.IsActive)
                                        {
                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm">
                                                تعطيل
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit"
                                                    class="btn btn-outline-success btn-sm">
                                                تفعيل
                                            </button>
                                        }

                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8"
                                    class="text-center">
                                    لا يوجد عملاء
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>