@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            'use strict';

            // ═══════════ Server data ═══════════
            // ملاحظة مهمة: Html.Raw تمنع Razor من ترميز JSON إلى HTML entities
            const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Model.AvailableProducts,
                                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));

            const stores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Model.AvailableStores,
                                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));

            const serverItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                Model.Items ?? new System.Collections.Generic.List<AccountingSystem.Models.ViewModels.Sales.SalesInvoiceItemCreateViewModel>(),
                                new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));

            // ═══════════ Elements ═══════════
            const itemsBody        = document.getElementById('itemsBody');
            const emptyRow         = document.getElementById('emptyRow');
            const addItemBtn       = document.getElementById('addItemBtn');
            const barcodeInput     = document.getElementById('barcodeInput');

            const customerSelect   = document.getElementById('customerSelect');
            const branchSelect     = document.getElementById('branchSelect');
            const storeSelect      = document.getElementById('storeSelect');
            const paymentSelect    = document.getElementById('PaymentMethod');
            const cashAccountField = document.getElementById('cashAccountField');
            const cashAccountSel   = document.getElementById('CashAccountId');
            const dueDateField     = document.getElementById('dueDateField');
            const dueDateInput     = document.getElementById('dueDateInput');

            const discountInput    = document.getElementById('discountInput');
            const subTotalEl       = document.getElementById('subTotal');
            const grandTotalEl     = document.getElementById('grandTotal');
            const itemsCountEl     = document.getElementById('itemsCount');

            const customerStats    = document.getElementById('customerStats');
            const customerBalance  = document.getElementById('customerBalance');
            const customerPortal   = document.getElementById('customerPortal');

            const salesTaxToggle        = document.getElementById('salesTaxToggle');
            const salesTaxBody          = document.getElementById('salesTaxBody');
            const salesTaxRateInput     = document.getElementById('salesTaxRateInput');
            const salesTaxInput         = document.getElementById('salesTaxInput');
            const salesTaxAmountDisplay = document.getElementById('salesTaxAmountDisplay');

            const vatToggle        = document.getElementById('vatToggle');
            const vatBody          = document.getElementById('vatBody');
            const taxRateInput     = document.getElementById('taxRateInput');
            const taxInput         = document.getElementById('taxInput');
            const taxAmountDisplay = document.getElementById('taxAmountDisplay');

            const token = () => {
                const el = document.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            };

            // ═══════════ Payment method ═══════════
            const cashMethods = [
                '@((int)AccountingSystem.Models.SalesPaymentMethod.Cash)',
                '@((int)AccountingSystem.Models.SalesPaymentMethod.BankTransfer)',
                '@((int)AccountingSystem.Models.SalesPaymentMethod.Wallet)'
            ];
            const creditMethod = '@((int)AccountingSystem.Models.SalesPaymentMethod.Credit)';

            function togglePaymentFields() {
                const val = paymentSelect.value;
                const isCash   = cashMethods.includes(val);
                const isCredit = val === creditMethod;

                if (isCash) {
                    cashAccountField.style.display = 'block';
                    if (cashAccountSel) {
                        cashAccountSel.required = true;
                        if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                            window.jQuery(cashAccountSel).rules('add', {
                                required: true,
                                messages: { required: 'لابد من اختيار المركز النقدي.' }
                            });
                        }
                    }
                } else {
                    cashAccountField.style.display = 'none';
                    if (cashAccountSel) {
                        cashAccountSel.required = false;
                        if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                            window.jQuery(cashAccountSel).rules('remove', 'required');
                        }
                        if (window.jQuery) {
                            window.jQuery(cashAccountSel).removeClass('input-validation-error');
                            window.jQuery(cashAccountSel).siblings('.text-danger').text('');
                        }
                        cashAccountSel.value = '';
                    }
                }

                if (isCredit) {
                    dueDateField.style.display = 'block';
                    if (dueDateInput) {
                        dueDateInput.required = true;
                        if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                            window.jQuery(dueDateInput).rules('add', {
                                required: true,
                                messages: { required: 'لابد من تحديد تاريخ الاستحقاق.' }
                            });
                        }
                    }
                } else {
                    dueDateField.style.display = 'none';
                    if (dueDateInput) {
                        dueDateInput.required = false;
                        if (window.jQuery && window.jQuery.validator && window.jQuery.validator.unobtrusive) {
                            window.jQuery(dueDateInput).rules('remove', 'required');
                        }
                        if (window.jQuery) {
                            window.jQuery(dueDateInput).removeClass('input-validation-error');
                            window.jQuery(dueDateInput).siblings('.text-danger').text('');
                        }
                        dueDateInput.value = '';
                    }
                }
            }
            paymentSelect.addEventListener('change', togglePaymentFields);

            // ═══════════ Customer info ═══════════
            async function loadCustomerInfo(customerId) {
                if (!customerId || parseInt(customerId) <= 0) {
                    customerStats.style.display = 'none';
                    return;
                }
                customerStats.style.display = 'grid';
                customerBalance.innerHTML = '<span class="pi-loading"></span>';
                customerPortal.innerHTML = '<span class="pi-loading"></span>';

                try {
                    const res = await fetch(`/SalesInvoice/GetCustomerInfo?id=${customerId}`,
                        { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error();
                    const data = await res.json();
                    if (!data.ok) { customerStats.style.display = 'none'; return; }

                    const bal = parseFloat(data.balance) || 0;
                    if (bal > 0.005) {
                        customerBalance.className = 'pi-stat-val is-debit';
                        customerBalance.innerHTML = bal.toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' <small>مدين (لنا عنده)</small>';
                    } else if (bal < -0.005) {
                        customerBalance.className = 'pi-stat-val is-credit';
                        customerBalance.innerHTML = Math.abs(bal).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' <small>دائن (له عندنا)</small>';
                    } else {
                        customerBalance.className = 'pi-stat-val';
                        customerBalance.textContent = '0.00';
                    }

                    if (data.hasPortalAccount) {
                        customerPortal.innerHTML = '<span class="pi-portal-badge" style="color:var(--pi-green);"><i class="bi bi-check-circle-fill"></i> مُفعّل</span>';
                    } else if (data.portalApproved) {
                        customerPortal.innerHTML = '<span class="pi-portal-badge" style="color:var(--pi-amber);"><i class="bi bi-clock-history"></i> بانتظار الإنشاء</span>';
                    } else if (data.portalRequested) {
                        customerPortal.innerHTML = '<span class="pi-portal-badge" style="color:var(--pi-muted);"><i class="bi bi-hourglass-split"></i> قيد المراجعة</span>';
                    } else {
                        customerPortal.innerHTML = '<span class="pi-portal-badge" style="color:var(--pi-muted);"><i class="bi bi-dash-circle"></i> غير مُفعّل</span>';
                    }
                } catch {
                    customerBalance.textContent = '—';
                    customerPortal.textContent = '—';
                }
            }
            customerSelect.addEventListener('change', function () { loadCustomerInfo(this.value); });

            // ═══════════ Stores filter ═══════════
            function populateStores(branchId) {
                const current = storeSelect.value;
                storeSelect.innerHTML = '<option value="">— اختر المخزن —</option>';
                stores.filter(s => !branchId || s.BranchId === branchId).forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.Id;
                    opt.textContent = (s.BranchName ? s.BranchName + ' — ' : '') + s.Name;
                    opt.dataset.branch = s.BranchId;
                    storeSelect.appendChild(opt);
                });
                if (current && storeSelect.querySelector(`option[value="${current}"]`)) {
                    storeSelect.value = current;
                }
            }
            branchSelect.addEventListener('change', function () { populateStores(parseInt(this.value) || 0); });
            storeSelect.addEventListener('change', function () {
                const st = stores.find(s => s.Id === parseInt(this.value));
                if (st && String(st.BranchId) !== branchSelect.value) {
                    branchSelect.value = st.BranchId;
                    populateStores(st.BranchId);
                    storeSelect.value = st.Id;
                }
            });

            // ═══════════ Helpers ═══════════
            function formatNumber(n) { return (Math.round(n * 100) / 100).toFixed(2); }
            function escHtml(s) { const d = document.createElement('div'); d.textContent = (s == null ? '' : String(s)); return d.innerHTML; }
            function parseNum(v) { const n = parseFloat(String(v ?? '').replace(',', '.')); return isNaN(n) ? 0 : n; }

            // ═══════════ Lots cache ═══════════
            const lotsCache = {};
            function fetchLots(productId, storeId) {
                const key = productId + ':' + storeId;
                if (!lotsCache[key]) {
                    lotsCache[key] = fetch(`/SalesInvoice/GetAvailableLots?productId=${productId}&storeId=${storeId}`)
                        .then(r => (r.ok ? r.json() : []));
                }
                return lotsCache[key];
            }
            function fifoCost(lots, baseQty) {
                let need = baseQty, cost = 0, rows = [];
                for (const lot of lots) {
                    if (need <= 0) break;
                    const take = Math.min(lot.quantityRemaining, need);
                    cost += take * lot.unitCost;
                    rows.push(`دفعة ${lot.purchaseDate} (${lot.supplierName}): ${formatNumber(take)} × ${formatNumber(lot.unitCost)} = ${formatNumber(take * lot.unitCost)}`);
                    need -= take;
                }
                return { cost, rows, shortfall: need };
            }

            // ═══════════ Item Modal ═══════════
            const itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
            const mProduct   = document.getElementById('mProduct');
            const mUnit      = document.getElementById('mUnit');
            const mQty       = document.getElementById('mQty');
            const mPrice     = document.getElementById('mPrice');
            const mProfit    = document.getElementById('mProfit');
            const mSearch    = document.getElementById('mSearch');
            const mSearchMsg = document.getElementById('mSearchMsg');
            const mLot       = document.getElementById('mLot');

            products.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.Id;
                opt.textContent = p.Name;
                mProduct.appendChild(opt);
            });

            mSearch.addEventListener('input', function () {
                const q = this.value.trim().toLowerCase();
                let visibleCount = 0, firstVisible = null;
                Array.from(mProduct.options).forEach(opt => {
                    const p = products.find(pr => pr.Id == opt.value);
                    const name = (p && p.Name || '').toLowerCase();
                    const barcode = (p && p.Barcode || '').toLowerCase();
                    const hit = !q || name.includes(q) || barcode.includes(q);
                    opt.hidden = !hit;
                    if (hit) { visibleCount++; if (!firstVisible) firstVisible = opt; }
                });
                if (q && visibleCount === 1 && firstVisible) {
                    mProduct.value = firstVisible.value;
                    mProduct.dispatchEvent(new Event('change'));
                }
                mSearchMsg.style.display = (q && visibleCount === 0) ? '' : 'none';
                mSearchMsg.textContent = 'لا يوجد منتج بهذا الاسم أو الباركود.';
            });

            function fillUnits() {
                const product = products.find(p => p.Id == mProduct.value);
                mUnit.innerHTML = '';
                if (!product) return;
                (product.Units || []).forEach(u => {
                    const factor = parseFloat(u.ConversionFactor) || 1;
                    const opt = document.createElement('option');
                    opt.value = u.UnitId;
                    opt.textContent = u.UnitName + ' (' + formatNumber(factor) + ' ق)';
                    opt.dataset.price = u.SalePrice;
                    opt.dataset.factor = factor;
                    mUnit.appendChild(opt);
                });
                if (mUnit.options.length > 0) {
                    mUnit.selectedIndex = 0;
                    mUnit.dispatchEvent(new Event('change'));
                }
            }

            mProduct.addEventListener('change', () => { mQty.value = '1'; fillUnits(); updateProfit(); });

            mUnit.addEventListener('change', function () {
                const opt = this.options[this.selectedIndex];
                if (opt) {
                    const factor = parseFloat(opt.dataset.factor) || 1;
                    const piecePrice = (parseFloat(opt.dataset.price) || 0) / factor;
                    mPrice.value = piecePrice.toFixed(2);
                } else { mPrice.value = ''; }
                updateProfit();
            });

            mQty.addEventListener('input', updateProfit);
            mPrice.addEventListener('input', updateProfit);

            function fillLotOptions(lots) {
                const prev = mLot.value;
                mLot.innerHTML = '';
                const autoOpt = document.createElement('option');
                autoOpt.value = '0';
                autoOpt.textContent = 'تلقائي (من الأقدم — FIFO)';
                mLot.appendChild(autoOpt);
                lots.forEach(lot => {
                    const opt = document.createElement('option');
                    opt.value = lot.id;
                    opt.textContent = `دفعة ${lot.purchaseDate} (${lot.supplierName}) — متاح ${formatNumber(lot.quantityRemaining)} — تكلفة ${formatNumber(lot.unitCost)}`;
                    opt.dataset.qty = lot.quantityRemaining;
                    opt.dataset.cost = lot.unitCost;
                    mLot.appendChild(opt);
                });
                if (prev && Array.from(mLot.options).some(o => o.value === prev)) mLot.value = prev;
                else mLot.selectedIndex = 0;
            }

            function currentAvailable(lots) {
                if (mLot.selectedIndex > 0) return parseFloat(mLot.options[mLot.selectedIndex].dataset.qty) || 0;
                return lots.reduce((s, l) => s + l.quantityRemaining, 0);
            }

            function updateProfit() {
                const product = products.find(p => p.Id == mProduct.value);
                const opt = mUnit.options[mUnit.selectedIndex];
                const qty = parseFloat(mQty.value) || 0;
                const price = parseFloat(mPrice.value) || 0;
                const storeId = storeSelect.value;
                const factor = opt ? (parseFloat(opt.dataset.factor) || 1) : 1;

                if (!product || !opt || !storeId) { mProfit.innerHTML = ''; return; }
                if (qty <= 0) { mProfit.innerHTML = '<span class="text-muted">أدخل الكمية لعرض الربحية.</span>'; return; }

                fetchLots(product.Id, parseInt(storeId)).then(lots => {
                    fillLotOptions(lots);
                    if (!lots.length) {
                        mProfit.innerHTML = '<span class="text-danger fw-bold">لا توجد دفعات متاحة لهذا المنتج في المخزن — لا يمكن الإضافة.</span>';
                        return;
                    }
                    const baseQty = qty * factor;
                    const lineTotal = baseQty * price;
                    const available = currentAvailable(lots);
                    const isManual = mLot.selectedIndex > 0;
                    let cost = 0, rows = [];
                    if (isManual) {
                        const lotObj = lots.find(l => l.id == mLot.value);
                        const unitCost = lotObj ? lotObj.unitCost : 0;
                        cost = Math.min(available, baseQty) * unitCost;
                        rows = lotObj ? [`دفعة ${lotObj.purchaseDate} (${lotObj.supplierName}): ${formatNumber(Math.min(available, baseQty))} × ${formatNumber(unitCost)} = ${formatNumber(cost)}`] : [];
                    } else {
                        const f = fifoCost(lots, baseQty);
                        cost = f.cost; rows = f.rows;
                    }
                    const profit = lineTotal - cost;
                    let html = '';
                    if (baseQty > available) {
                        html += `<div class="text-danger fw-bold mb-1">لا يمكن الإضافة — المطلوب (${formatNumber(baseQty)}) أكبر من المتاح (${formatNumber(available)}) قطعة أساسية.</div>`;
                    }
                    html += `المتوفر: <strong>${formatNumber(available)}</strong> — الإجمالي: <strong>${formatNumber(lineTotal)}</strong> — التكلفة: <strong>${formatNumber(cost)}</strong> — <span class="small text-muted">الربح: ${formatNumber(profit)}</span>`;
                    html += `<div class="text-muted mt-1" style="max-height: 90px; overflow: auto;">${rows.join('<br>')}</div>`;
                    mProfit.innerHTML = html;
                }).catch(() => { mProfit.innerHTML = ''; });
            }

            mLot.addEventListener('change', updateProfit);

            function openItemModal(productId) {
                if (!storeSelect.value) { alert('اختر الفرع والمخزن أولًا.'); return; }
                mSearch.value = '';
                mSearchMsg.style.display = 'none';
                Array.from(mProduct.options).forEach(o => o.hidden = false);
                mLot.innerHTML = '<option value="0">تلقائي (من الأقدم — FIFO)</option>';
                if (productId) mProduct.value = productId;
                if (!mProduct.value) mProduct.selectedIndex = 0;
                fillUnits();
                mQty.value = '1';
                itemModal.show();
                updateProfit();
            }
            addItemBtn.addEventListener('click', () => openItemModal());

            function findProductByBarcode(code) {
                code = (code || '').trim().toLowerCase();
                if (!code) return null;
                return products.find(p => (p.Barcode || '').trim().toLowerCase() === code);
            }
            function findProductByName(name) {
                name = (name || '').trim().toLowerCase();
                if (!name) return null;
                return products.find(p => (p.Name || '').trim().toLowerCase() === name);
            }

            barcodeInput.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                const val = this.value.trim();
                if (!val) return;
                const p = findProductByBarcode(val) || findProductByName(val);
                if (p) { openItemModal(p.Id); this.value = ''; }
                else {
                    this.classList.add('is-invalid');
                    this.setAttribute('title', 'لا يوجد منتج بهذا الاسم/الباركود');
                    setTimeout(() => this.classList.remove('is-invalid'), 1500);
                }
            });

            // ═══════════ Add row ═══════════
            let rowIndex = 0;

            document.getElementById('mConfirm').addEventListener('click', function () {
                const product = products.find(p => p.Id == mProduct.value);
                const opt = mUnit.options[mUnit.selectedIndex];
                const qty = parseFloat(mQty.value) || 0;
                const price = parseFloat(mPrice.value) || 0;
                const storeId = parseInt(storeSelect.value) || 0;

                if (!product) { alert('اختر المنتج.'); return; }
                if (!opt) { alert('اختر الوحدة.'); return; }
                if (qty <= 0) { alert('الكمية يجب أن تكون أكبر من صفر.'); return; }

                const factor = parseFloat(opt.dataset.factor) || 1;
                const baseQty = qty * factor;
                const unitPrice = price * factor;
                const lineTotal = baseQty * price;

                fetchLots(product.Id, storeId).then(lots => {
                    fillLotOptions(lots);
                    const available = currentAvailable(lots);
                    if (!lots.length || baseQty > available) {
                        mProfit.innerHTML = `<div class="text-danger fw-bold mb-1">لا يمكن الإضافة — المطلوب (${formatNumber(baseQty)}) أكبر من المتاح (${formatNumber(available || 0)}) قطعة أساسية.</div>`;
                        return;
                    }
                    const isManual = mLot.selectedIndex > 0;
                    const idx = rowIndex++;
                    let cost = 0, lotRows = [];
                    if (isManual) {
                        const lotObj = lots.find(l => l.id == mLot.value);
                        cost = baseQty * (lotObj ? lotObj.unitCost : 0);
                        lotRows = lotObj ? [`دفعة ${lotObj.purchaseDate} (${lotObj.supplierName}): ${formatNumber(baseQty)} × ${formatNumber(lotObj.unitCost)} = ${formatNumber(cost)}`] : [];
                    } else {
                        const f = fifoCost(lots, baseQty);
                        cost = f.cost; lotRows = f.rows;
                    }
                    const profit = lineTotal - cost;
                    const profitClass = profit < 0 ? 'pi-profit is-loss' : (Math.abs(profit) < 0.005 ? 'pi-profit is-break' : 'pi-profit');

                    const tr = document.createElement('tr');
                    tr.className = 'pi-row';
                    tr.dataset.total = lineTotal;
                    tr.innerHTML = `
                        <td class="pi-idx">${idx + 1}</td>
                        <td>${escHtml(product.Name)}<input type="hidden" name="Items[${idx}].ProductId" value="${product.Id}" /></td>
                        <td>${escHtml(opt.textContent)}<input type="hidden" name="Items[${idx}].UnitId" value="${opt.value}" /></td>
                        <td>${formatNumber(qty)}</td>
                        <td class="text-end">
                            <span class="pi-linetotal">${formatNumber(unitPrice)}</span>
                            <input type="hidden" name="Items[${idx}].Quantity" value="${qty}" />
                            <input type="hidden" name="Items[${idx}].UnitPrice" value="${unitPrice.toFixed(4)}" />
                            <input type="hidden" name="Items[${idx}].IssueMethod" value="${isManual ? 2 : 1}" />
                            ${isManual ? `<input type="hidden" name="Items[${idx}].SelectedStockLotId" value="${mLot.value}" />` : ''}
                        </td>
                        <td class="text-end"><span class="pi-linetotal">${formatNumber(lineTotal)}</span></td>
                        <td class="text-end"><span class="pi-cost">${formatNumber(cost)}</span></td>
                        <td class="text-end"><span class="${profitClass}">${formatNumber(profit)}</span></td>
                        <td><div class="small text-muted" style="max-height: 64px; overflow: auto;">${lotRows.join('<br>')}</div></td>
                        <td><button type="button" class="pi-del" title="حذف">\u00d7</button></td>`;

                    itemsBody.appendChild(tr);
                    renumber();
                    updateTotals();
                    itemModal.hide();
                }).catch(() => { alert('تعذر التحقق من المتاح — حاول مرة أخرى.'); });
            });

            // ═══════════ Render existing items (Edit mode) ═══════════
            function renderExistingItems() {
                if (!serverItems || !serverItems.length) return;

                serverItems.forEach(item => {
                    const product = products.find(p => p.Id === item.ProductId);
                    if (!product) return;

                    const unit = (product.Units || []).find(u => u.UnitId === item.UnitId);
                    if (!unit) return;

                    const factor    = parseFloat(unit.ConversionFactor) || 1;
                    const unitPrice = parseFloat(item.UnitPrice) || 0;
                    const qty       = parseFloat(item.Quantity) || 0;
                    const lineTotal = qty * unitPrice;
                    const isManual  = item.IssueMethod === 2;
                    const idx       = rowIndex++;

                    const tr = document.createElement('tr');
                    tr.className = 'pi-row';
                    tr.dataset.total = lineTotal;

                    tr.innerHTML = `
                        <td class="pi-idx">${idx + 1}</td>
                        <td>
                            ${escHtml(product.Name)}
                            <input type="hidden" name="Items[${idx}].ProductId" value="${product.Id}" />
                        </td>
                        <td>
                            ${escHtml(unit.UnitName + ' (' + formatNumber(factor) + ' ق)')}
                            <input type="hidden" name="Items[${idx}].UnitId" value="${unit.UnitId}" />
                        </td>
                        <td>${formatNumber(qty)}</td>
                        <td class="text-end">
                            <span class="pi-linetotal">${formatNumber(unitPrice)}</span>
                            <input type="hidden" name="Items[${idx}].Quantity" value="${qty}" />
                            <input type="hidden" name="Items[${idx}].UnitPrice" value="${unitPrice.toFixed(4)}" />
                            <input type="hidden" name="Items[${idx}].IssueMethod" value="${isManual ? 2 : 1}" />
                            ${isManual && item.SelectedStockLotId ? `<input type="hidden" name="Items[${idx}].SelectedStockLotId" value="${item.SelectedStockLotId}" />` : ''}
                        </td>
                        <td class="text-end"><span class="pi-linetotal">${formatNumber(lineTotal)}</span></td>
                        <td class="text-end"><span class="pi-cost">—</span></td>
                        <td class="text-end"><span class="pi-profit">—</span></td>
                        <td><div class="small text-muted">—</div></td>
                        <td><button type="button" class="pi-del" title="حذف">\u00d7</button></td>`;

                    itemsBody.appendChild(tr);
                });

                renumber();
            }

            // ═══════════ Rows helpers ═══════════
            function renumber() {
                const rows = itemsBody.querySelectorAll('tr.pi-row');
                rows.forEach((tr, i) => {
                    const idx = tr.querySelector('.pi-idx');
                    if (idx) idx.textContent = i + 1;
                    tr.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Items\[\d+\]/, `Items[${i}]`);
                    });
                });
                const n = rows.length;
                itemsCountEl.textContent = `(${n})`;
                emptyRow.style.display = n ? 'none' : '';
            }

            itemsBody.addEventListener('click', function (e) {
                if (e.target.classList.contains('pi-del')) {
                    e.target.closest('tr').remove();
                    renumber();
                    updateTotals();
                }
            });

            // ═══════════ Totals ═══════════
            function updateTotals() {
                let sub = 0;
                itemsBody.querySelectorAll('tr.pi-row').forEach(tr => {
                    sub += parseFloat(tr.dataset.total) || 0;
                });

                const discount = Math.max(0, parseNum(discountInput.value));
                const taxable  = Math.max(0, sub - discount);

                let salesTaxAmount = 0;
                if (salesTaxToggle.checked) {
                    const rate = parseNum(salesTaxRateInput.value);
                    salesTaxAmount = Math.round(taxable * rate * 100) / 10000;
                }
                salesTaxInput.value = salesTaxAmount.toFixed(2);
                salesTaxAmountDisplay.textContent = salesTaxAmount.toFixed(2);

                let vatAmount = 0;
                if (vatToggle.checked) {
                    const rate = parseNum(taxRateInput.value);
                    vatAmount = Math.round(taxable * rate * 100) / 10000;
                }
                taxInput.value = vatAmount.toFixed(2);
                taxAmountDisplay.textContent = vatAmount.toFixed(2);

                subTotalEl.textContent   = sub.toFixed(2);
                grandTotalEl.textContent = (taxable + salesTaxAmount + vatAmount).toFixed(2);
            }

            discountInput.addEventListener('input', updateTotals);
            salesTaxRateInput.addEventListener('input', updateTotals);
            taxRateInput.addEventListener('input', updateTotals);

            salesTaxToggle.addEventListener('change', function () {
                if (this.checked) {
                    salesTaxBody.classList.add('is-on');
                    if (!parseNum(salesTaxRateInput.value)) salesTaxRateInput.value = '0';
                    salesTaxRateInput.focus();
                } else {
                    salesTaxBody.classList.remove('is-on');
                    salesTaxRateInput.value = '0';
                    salesTaxInput.value = '0';
                }
                updateTotals();
            });

            vatToggle.addEventListener('change', function () {
                if (this.checked) {
                    vatBody.classList.add('is-on');
                    if (!parseNum(taxRateInput.value)) taxRateInput.value = '14';
                    taxRateInput.focus();
                } else {
                    vatBody.classList.remove('is-on');
                    taxRateInput.value = '0';
                    taxInput.value = '0';
                }
                updateTotals();
            });

            // ═══════════ Tabs ═══════════
            document.querySelectorAll('.pi-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    const target = tab.dataset.tab;
                    document.querySelectorAll('.pi-tab').forEach(t => t.classList.toggle('is-active', t === tab));
                    document.querySelectorAll('.pi-tab-panel').forEach(p => p.classList.toggle('is-active', p.dataset.tabPanel === target));
                });
            });

            // ═══════════ Quick Customer ═══════════
            const quickCustomerModal = new bootstrap.Modal(document.getElementById('quickCustomerModal'));
            const qcName  = document.getElementById('qcName');
            const qcPhone = document.getElementById('qcPhone');
            const qcMsg   = document.getElementById('qcMsg');

            document.getElementById('quickCustomerBtn').addEventListener('click', () => {
                qcName.value = ''; qcPhone.value = ''; qcMsg.textContent = '';
                quickCustomerModal.show();
                setTimeout(() => qcName.focus(), 300);
            });

            async function submitQuickCustomer() {
                const name = qcName.value.trim();
                const phone = qcPhone.value.trim();
                if (!name) { qcMsg.textContent = 'اسم العميل مطلوب.'; return; }
                if (!phone) { qcMsg.textContent = 'رقم الهاتف مطلوب.'; return; }

                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', token());
                body.append('name', name);
                body.append('phone', phone);

                try {
                    const res = await fetch('@Url.Action("CreateQuickCustomer", "SalesInvoice")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: body.toString()
                    });
                    const data = await res.json();
                    if (!data.ok) { qcMsg.textContent = data.message || 'تعذر الحفظ.'; return; }

                    const opt = document.createElement('option');
                    opt.value = data.id;
                    opt.textContent = data.name + (data.phone ? ' — ' + data.phone : '');
                    opt.dataset.phone = data.phone || '';
                    customerSelect.appendChild(opt);
                    customerSelect.value = data.id;
                    loadCustomerInfo(data.id);
                    quickCustomerModal.hide();
                } catch { qcMsg.textContent = 'تعذر الاتصال بالخادم.'; }
            }
            document.getElementById('qcSave').addEventListener('click', submitQuickCustomer);
            qcName.addEventListener('keydown', e => { if (e.key === 'Enter') submitQuickCustomer(); });
            qcPhone.addEventListener('keydown', e => { if (e.key === 'Enter') submitQuickCustomer(); });

            // ═══════════ Quick Store ═══════════
            const quickStoreModal = new bootstrap.Modal(document.getElementById('quickStoreModal'));
            const qsStoreName   = document.getElementById('qsStoreName');
            const qsStoreBranch = document.getElementById('qsStoreBranch');
            const qsStoreMsg    = document.getElementById('qsStoreMsg');

            document.getElementById('quickStoreBtn').addEventListener('click', () => {
                qsStoreName.value = ''; qsStoreMsg.textContent = '';
                qsStoreBranch.innerHTML = '';
                Array.from(branchSelect.options).filter(o => o.value).forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value; opt.textContent = o.textContent;
                    qsStoreBranch.appendChild(opt);
                });
                if (branchSelect.value) qsStoreBranch.value = branchSelect.value;
                quickStoreModal.show();
                setTimeout(() => qsStoreName.focus(), 300);
            });

            async function submitQuickStore() {
                const name = qsStoreName.value.trim();
                if (!name) { qsStoreMsg.textContent = 'اسم المخزن مطلوب.'; return; }
                if (!qsStoreBranch.value) { qsStoreMsg.textContent = 'اختر الفرع.'; return; }

                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', token());
                body.append('name', name);
                body.append('branchId', qsStoreBranch.value);

                try {
                    const res = await fetch('@Url.Action("CreateQuickStore", "SalesInvoice")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: body.toString()
                    });
                    const data = await res.json();
                    if (!data.ok) { qsStoreMsg.textContent = data.message || 'تعذر الحفظ.'; return; }

                    const opt = document.createElement('option');
                    opt.value = data.id;
                    opt.textContent = (data.branchName ? data.branchName + ' — ' : '') + data.name;
                    opt.dataset.branch = data.branchId;
                    storeSelect.appendChild(opt);
                    storeSelect.value = data.id;
                    quickStoreModal.hide();
                } catch { qsStoreMsg.textContent = 'تعذر الاتصال بالخادم.'; }
            }
            document.getElementById('qsStoreSave').addEventListener('click', submitQuickStore);
            qsStoreName.addEventListener('keydown', e => { if (e.key === 'Enter') submitQuickStore(); });

            // ═══════════ Init from server Model ═══════════
            function initFromServer() {
                // طريقة الدفع
                const paymentRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethod));
                const paymentMap = {
                    'Cash':         '@((int)AccountingSystem.Models.SalesPaymentMethod.Cash)',
                    'BankTransfer': '@((int)AccountingSystem.Models.SalesPaymentMethod.BankTransfer)',
                    'Cheque':       '@((int)AccountingSystem.Models.SalesPaymentMethod.Cheque)',
                    'Credit':       '@((int)AccountingSystem.Models.SalesPaymentMethod.Credit)',
                    'Wallet':       '@((int)AccountingSystem.Models.SalesPaymentMethod.Wallet)'
                };
                const paymentVal = paymentMap[paymentRaw] || paymentRaw || '';
                if (paymentVal) paymentSelect.value = paymentVal;
                togglePaymentFields();

                // المركز النقدي
                const cashId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CashAccountId));
                if (cashId && cashAccountSel) cashAccountSel.value = cashId;

                // العميل / الفرع / المخزن
                @if (Model.CustomerId > 0)
                {
                    <text>customerSelect.value = '@Model.CustomerId';</text>
                }
                @if (Model.BranchId > 0)
                {
                    <text>branchSelect.value = '@Model.BranchId';</text>
                }

                populateStores(parseInt(branchSelect.value) || 0);

                @if (Model.StoreId > 0)
                {
                    <text>storeSelect.value = '@Model.StoreId';</text>
                }

                // الخصم
                const discountVal = @(Model.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
                if (discountVal > 0) discountInput.value = discountVal;

                // ═══ ضريبة المبيعات ═══
                const sTaxRate = @(Model.SalesTaxRate.ToString(System.Globalization.CultureInfo.InvariantCulture));
                const sTaxAmt  = @(Model.SalesTaxAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
                if (sTaxRate > 0) {
                    salesTaxToggle.checked = true;
                    salesTaxBody.classList.add('is-on');
                    salesTaxRateInput.value = sTaxRate;
                    salesTaxInput.value = sTaxAmt.toFixed(2);
                    salesTaxAmountDisplay.textContent = sTaxAmt.toFixed(2);
                }

                // ═══ ض.ق.م ═══
                const vatRate = @(Model.TaxRate.ToString(System.Globalization.CultureInfo.InvariantCulture));
                const vatAmt  = @(Model.TaxAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
                if (vatRate > 0) {
                    vatToggle.checked = true;
                    vatBody.classList.add('is-on');
                    taxRateInput.value = vatRate;
                    taxInput.value = vatAmt.toFixed(2);
                    taxAmountDisplay.textContent = vatAmt.toFixed(2);
                }

                // ═══ تحميل البنود الموجودة ═══
                renderExistingItems();

                // ═══ تحديث الإجماليات بعد تحميل البنود ═══
                updateTotals();

                if (customerSelect.value) loadCustomerInfo(customerSelect.value);
            }

            initFromServer();

            barcodeInput.focus();

            document.addEventListener('keydown', e => {
                if (e.ctrlKey && e.key === 'Enter') {
                    e.preventDefault();
                    const btn = document.querySelector('button[name="saveAndConfirm"][value="true"]');
                    if (btn) btn.click();
                }
            });

            document.getElementById('invoiceForm').addEventListener('submit', function (e) {
                if (!paymentSelect.value) {
                    e.preventDefault();
                    document.getElementById('paymentMethodError').textContent = 'لابد من اختيار طريقة الدفع.';
                    paymentSelect.focus();
                    return false;
                }

                if (cashMethods.includes(paymentSelect.value) && (!cashAccountSel || !cashAccountSel.value)) {
                    e.preventDefault();
                    alert('اختر المركز النقدي أولًا.');
                    if (cashAccountSel) cashAccountSel.focus();
                    return false;
                }

                if (paymentSelect.value === creditMethod && (!dueDateInput || !dueDateInput.value)) {
                    e.preventDefault();
                    alert('حدد تاريخ الاستحقاق أولًا.');
                    if (dueDateInput) dueDateInput.focus();
                    return false;
                }

                if (!storeSelect.value) {
                    e.preventDefault();
                    alert('اختر المخزن أولًا'); storeSelect.focus(); return false;
                }

                const hasItems = itemsBody.querySelectorAll('tr.pi-row').length > 0;
                if (!hasItems) {
                    e.preventDefault();
                    alert('أضف بندًا واحدًا على الأقل'); return false;
                }
            });
        })();
    </script>
}