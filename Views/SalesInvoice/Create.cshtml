@model AccountingSystem.Models.ViewModels.Sales.SalesInvoiceCreateViewModel

@{
    ViewData["Title"] = "فاتورة بيع جديدة";
    var formAction = ViewData["FormAction"]?.ToString() ?? "Create";
    var invoiceId = ViewData["InvoiceId"]?.ToString();
}

<style>
    .pi-shell {
        --pi-bg: #f4f6fa; --pi-surface: #fff; --pi-line: #e4e8f0; --pi-line-soft: #eef1f7;
        --pi-ink: #0f172a; --pi-body: #475569; --pi-muted: #94a3b8;
        --pi-primary: #2563eb; --pi-primary-dark: #1d4ed8; --pi-primary-soft: #eff6ff;
        --pi-green: #059669; --pi-amber: #d97706; --pi-red: #dc2626; --pi-cyan: #0891b2;
        max-width: 1240px; margin: 0 auto; padding: 12px;
        font-family: 'Segoe UI', Tahoma, system-ui, sans-serif; color: var(--pi-ink);
    }
    .pi-shell * { box-sizing: border-box; }

    .pi-actionbar {
        position: sticky; top: 12px; z-index: 100; display: flex; align-items: center;
        gap: 12px; flex-wrap: wrap; padding: 12px 18px; margin-bottom: 16px;
        background: rgba(255,255,255,.94); backdrop-filter: blur(14px);
        border: 1px solid var(--pi-line); border-radius: 14px;
        box-shadow: 0 6px 22px rgba(15,23,42,.06);
    }
    .pi-actionbar-title { display: flex; align-items: center; gap: 10px; }
    .pi-actionbar-title .pi-ico {
        width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center;
        background: linear-gradient(135deg, var(--pi-primary), #60a5fa);
        color: #fff; font-size: 1.05rem; overflow: hidden;
    }
    .pi-actionbar-title h1 { margin: 0; font-size: .98rem; font-weight: 800; line-height: 1.2; }
    .pi-actionbar-title p { margin: 0; font-size: .72rem; color: var(--pi-muted); }
    .pi-actionbar-spacer { flex: 1; }
    .pi-actionbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    .pi-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        border: 1px solid transparent; border-radius: 9px;
        padding: 8px 15px; font-size: .84rem; font-weight: 700;
        cursor: pointer; text-decoration: none; transition: .16s; white-space: nowrap;
    }
    .pi-btn:hover { transform: translateY(-1px); text-decoration: none; }
    .pi-btn-primary { background: var(--pi-primary); color: #fff; }
    .pi-btn-primary:hover { background: var(--pi-primary-dark); color: #fff; }
    .pi-btn-dark { background: #0f172a; color: #fff; }
    .pi-btn-dark:hover { background: #1e293b; color: #fff; }
    .pi-btn-light { background: #fff; color: var(--pi-body); border-color: var(--pi-line); }
    .pi-btn-light:hover { background: var(--pi-bg); color: var(--pi-ink); }

    .pi-topgrid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 16px; margin-bottom: 16px; }
    .pi-panel { background: var(--pi-surface); border: 1px solid var(--pi-line); border-radius: 14px; overflow: hidden; }
    .pi-panel-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 18px; background: #fafbfd; border-bottom: 1px solid var(--pi-line-soft);
    }
    .pi-panel-head h2 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: .85rem; font-weight: 800; color: var(--pi-ink); }
    .pi-panel-head h2 i { color: var(--pi-primary); }
    .pi-panel-body { padding: 16px 18px; }

    .pi-field { display: flex; flex-direction: column; gap: 5px; }
    .pi-field label { font-size: .74rem; font-weight: 700; color: var(--pi-body); }
    .pi-field label .req { color: var(--pi-red); }
    .pi-field .form-control, .pi-field .form-select {
        border-radius: 9px; border: 1.5px solid #dbe3f0; font-size: .88rem; padding: 8px 11px; transition: .16s;
    }
    .pi-field .form-control:focus, .pi-field .form-select:focus {
        border-color: var(--pi-primary); box-shadow: 0 0 0 .2rem rgba(37,99,235,.14); outline: none;
    }
    .pi-field .form-control[readonly] { background: var(--pi-bg); color: var(--pi-muted); }

    .pi-inputgroup { display: flex; gap: 6px; }
    .pi-inputgroup > select, .pi-inputgroup > input { flex: 1; min-width: 0; }
    .pi-icon-btn {
        flex: 0 0 auto; width: 38px; display: grid; place-items: center;
        background: #fff; color: var(--pi-primary); border: 1.5px solid #dbe3f0;
        border-radius: 9px; cursor: pointer; text-decoration: none; transition: .16s;
    }
    .pi-icon-btn:hover { background: var(--pi-primary-soft); border-color: var(--pi-primary); color: var(--pi-primary); }

    .pi-customer-stats {
        display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
        margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--pi-line);
    }
    .pi-stat { padding: 10px 12px; background: var(--pi-bg); border-radius: 10px; border: 1px solid var(--pi-line-soft); }
    .pi-stat-label {
        display: flex; align-items: center; gap: 5px; font-size: .68rem; font-weight: 700;
        color: var(--pi-muted); text-transform: uppercase; letter-spacing: .3px; margin-bottom: 4px;
    }
    .pi-stat-val {
        font-size: 1.05rem; font-weight: 800; color: var(--pi-ink); font-family: 'Consolas', monospace;
        display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
    }
    .pi-stat-val small { font-size: .68rem; font-weight: 700; font-family: 'Segoe UI', sans-serif; }
    .pi-stat-val.is-debit { color: var(--pi-amber); }
    .pi-stat-val.is-credit { color: var(--pi-cyan); }
    .pi-portal-badge { display: inline-flex; align-items: center; gap: 5px; font-size: .78rem; font-weight: 700; }

    .pi-metagrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .pi-quickbar {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        padding: 12px 18px; background: #fafbfd; border-bottom: 1px solid var(--pi-line-soft);
    }
    .pi-quickbar-search { position: relative; flex: 1 1 320px; min-width: 220px; }
    .pi-quickbar-search i {
        position: absolute; inset-inline-start: 11px; top: 50%; transform: translateY(-50%);
        color: var(--pi-primary); pointer-events: none;
    }
    .pi-quickbar-search input {
        width: 100%; border: 1.5px solid #cddcf7; border-radius: 10px;
        padding: 9px 36px 9px 12px; font-size: .87rem; font-weight: 600; background: #fff;
    }
    .pi-quickbar-search input:focus { outline: none; border-color: var(--pi-primary); box-shadow: 0 0 0 .2rem rgba(37,99,235,.14); }

    .pi-table-wrap { overflow-x: auto; }
    .pi-table { width: 100%; margin: 0; border-collapse: collapse; }
    .pi-table thead th {
        background: #f8fafc; color: var(--pi-body); font-size: .7rem; font-weight: 800;
        text-transform: uppercase; letter-spacing: .3px; padding: 10px 10px;
        border-bottom: 1.5px solid var(--pi-line); text-align: right; white-space: nowrap;
    }
    .pi-table tbody td {
        padding: 6px 10px; border-bottom: 1px solid var(--pi-line-soft);
        vertical-align: middle; font-size: .85rem;
    }
    .pi-table tbody tr:hover { background: #fafbfd; }
    .pi-table tbody tr:last-child td { border-bottom: 0; }

    .pi-idx { color: var(--pi-muted); font-weight: 700; font-size: .72rem; text-align: center; }
    .pi-table .pi-linetotal {
        font-weight: 800; color: var(--pi-primary-dark); font-family: 'Consolas', monospace;
        direction: ltr; text-align: left; display: block;
    }
    .pi-table .pi-cost { font-family: 'Consolas', monospace; color: var(--pi-body); }
    .pi-table .pi-profit { font-family: 'Consolas', monospace; font-weight: 700; }
    .pi-table .pi-profit.is-loss { color: var(--pi-red); }
    .pi-table .pi-profit.is-break { color: var(--pi-green); }
    .pi-table .pi-del {
        width: 26px; height: 26px; border: 0; border-radius: 7px;
        background: #fef2f2; color: var(--pi-red); cursor: pointer; font-weight: 800;
        line-height: 1; transition: .16s;
    }
    .pi-table .pi-del:hover { background: #fee2e2; }

    .pi-table-empty { text-align: center; padding: 40px 16px !important; color: var(--pi-muted); font-size: .85rem; }
    .pi-table-empty i { display: block; font-size: 1.6rem; margin-bottom: 8px; opacity: .4; }

    .pi-tax-block { margin-top: 10px; padding-top: 10px; border-top: 1px dashed var(--pi-line); animation: piFadeIn .25s ease; }
    .pi-tax-block:first-of-type { border-top: 0; padding-top: 0; }

    @@keyframes piFadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .pi-tax-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .pi-tax-head .form-check { display: flex; align-items: center; gap: 10px; margin: 0; min-width: 0; }
    .pi-tax-head .form-check-input {
        width: 2.6em; height: 1.4em; cursor: pointer; margin: 0;
        border-color: #cbd5e1; flex: 0 0 auto;
    }
    .pi-tax-head .form-check-input:checked { background-color: var(--pi-primary); border-color: var(--pi-primary); }
    .pi-tax-head label {
        font-size: .86rem; font-weight: 700; color: var(--pi-ink); cursor: pointer; margin: 0;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .pi-tax-head label i { color: var(--pi-primary); }
    .pi-tax-rate { display: inline-flex; align-items: center; gap: 5px; font-size: .78rem; color: var(--pi-body); }
    .pi-tax-rate input {
        width: 70px; text-align: center; border: 1.5px solid #dbe3f0; border-radius: 7px;
        padding: 4px 6px; font-size: .82rem;
    }
    .pi-tax-rate input:focus { outline: none; border-color: var(--pi-primary); box-shadow: 0 0 0 .16rem rgba(37,99,235,.14); }
    .pi-tax-amount {
        display: flex; align-items: center; justify-content: space-between;
        padding: 6px 0 0; font-size: .84rem; color: var(--pi-body);
    }
    .pi-tax-amount b { font-family: 'Consolas', monospace; color: var(--pi-primary-dark); }
    .pi-tax-body { display: none; margin-top: 6px; }
    .pi-tax-body.is-on { display: block; }

    .pi-tabs { display: flex; gap: 4px; padding: 0 18px; border-bottom: 1px solid var(--pi-line); background: #fafbfd; }
    .pi-tab {
        display: inline-flex; align-items: center; gap: 7px; padding: 12px 14px;
        font-size: .84rem; font-weight: 700; color: var(--pi-body);
        border: 0; background: transparent; cursor: pointer;
        border-bottom: 2px solid transparent; transition: .16s; margin-bottom: -1px;
    }
    .pi-tab:hover { color: var(--pi-ink); }
    .pi-tab.is-active { color: var(--pi-primary); border-bottom-color: var(--pi-primary); }
    .pi-tab-content { padding: 16px 18px; }
    .pi-tab-panel { display: none; }
    .pi-tab-panel.is-active { display: block; }

    .pi-footer { display: grid; grid-template-columns: 1fr 360px; gap: 16px; margin-top: 16px; }
    .pi-totals { background: var(--pi-surface); border: 1px solid var(--pi-line); border-radius: 14px; padding: 18px; }
    .pi-totals h3 { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: .88rem; font-weight: 800; }
    .pi-totals h3 i { color: var(--pi-primary); }

    .pi-total-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 7px 0; font-size: .88rem; color: var(--pi-body); gap: 12px;
    }
    .pi-total-row > span:first-child { font-weight: 600; }
    .pi-total-row input {
        width: 120px; text-align: center; border: 1.5px solid #dbe3f0; border-radius: 8px;
        padding: 6px 9px; font-size: .86rem;
    }
    .pi-total-row input:focus { outline: none; border-color: var(--pi-primary); box-shadow: 0 0 0 .18rem rgba(37,99,235,.14); }
    .pi-total-row .pi-num { font-family: 'Consolas', monospace; font-weight: 800; }

    .pi-total-grand {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: 12px; padding-top: 14px; border-top: 2px solid var(--pi-line);
    }
    .pi-total-grand span { font-weight: 800; font-size: .95rem; }
    .pi-total-grand strong {
        font-size: 1.55rem; font-weight: 900; color: var(--pi-primary);
        font-family: 'Segoe UI', sans-serif; direction: ltr;
    }

    .pi-save-actions {
        display: flex; flex-direction: column; gap: 10px;
        background: var(--pi-surface); border: 1px solid var(--pi-line);
        border-radius: 14px; padding: 18px;
    }
    .pi-save-actions .pi-btn { padding: 11px 15px; font-size: .88rem; }

    .pi-loading {
        display: inline-block; width: 6px; height: 6px; border-radius: 50%;
        background: currentColor; animation: piPulse 1.2s infinite; vertical-align: middle;
    }
    @@keyframes piPulse { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }

    @@media (max-width: 991.98px) {
        .pi-topgrid { grid-template-columns: 1fr; }
        .pi-footer  { grid-template-columns: 1fr; }
    }
    @@media (max-width: 767.98px) {
        .pi-actionbar { padding: 10px 12px; }
        .pi-actionbar-title h1 { font-size: .9rem; }
        .pi-btn { padding: 7px 12px; font-size: .8rem; }
        .pi-metagrid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 575.98px) {
        .pi-shell { padding: 8px; }
        .pi-panel-body, .pi-footer { padding: 14px; }
        .pi-customer-stats { grid-template-columns: 1fr; }
    }
    @@media print {
        .app-sidebar, .app-topbar, .app-footer, .pi-actionbar, .pi-quickbar,
        .pi-save-actions, .pi-tabs, .pi-icon-btn, .pi-del { display: none !important; }
        .pi-shell { padding: 0; max-width: 100%; }
        .pi-panel, .pi-totals { box-shadow: none; border-color: #ddd; }
    }
</style>

<div class="pi-shell">
    <form asp-action="@formAction"
          asp-route-id="@(formAction == "Edit" ? invoiceId : null)"
          method="post" id="invoiceForm" autocomplete="off">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <header class="pi-actionbar">
            <div class="pi-actionbar-title">
                <div class="pi-ico">
                    @if (!string.IsNullOrEmpty(Model.CompanyLogoPath))
                    {
                        <img src="@Model.CompanyLogoPath" alt="Logo" style="width:100%; height:100%; object-fit:contain; background:#fff;" />
                    }
                    else
                    {
                        <i class="bi bi-receipt"></i>
                    }
                </div>
                <div>
                    <h1>@(formAction == "Edit" ? "تعديل فاتورة بيع" : "فاتورة بيع جديدة")</h1>
                    <p>رقم: <span dir="ltr">@Model.InvoiceNumber</span></p>
                </div>
            </div>
            <div class="pi-actionbar-spacer"></div>
            <div class="pi-actionbar-actions">
                <button type="button" class="pi-btn pi-btn-light" onclick="window.print();">
                    <i class="bi bi-printer"></i> طباعة
                </button>
                <button type="submit" name="saveAndConfirm" value="false" class="pi-btn pi-btn-dark">
                    <i class="bi bi-file-earmark"></i> حفظ كمسودة
                </button>
                <button type="submit" name="saveAndConfirm" value="true" class="pi-btn pi-btn-primary">
                    <i class="bi bi-check2-circle"></i> حفظ وترحيل
                </button>
            </div>
        </header>

        <div class="pi-topgrid">
            <section class="pi-panel">
                <div class="pi-panel-head">
                    <h2><i class="bi bi-person-badge"></i> بيانات العميل</h2>
                </div>
                <div class="pi-panel-body">
                    <div class="pi-field">
                        <label asp-for="CustomerId">العميل</label>
                        <div class="pi-inputgroup">
                            <select asp-for="CustomerId" class="form-select" id="customerSelect">
                                <option value="">— بدون عميل (بيع نقدي مباشر) —</option>
                                @foreach (var customer in Model.AvailableCustomers)
                                {
                                    <option value="@customer.Id" data-phone="@customer.Phone">
                                        @customer.Name@(string.IsNullOrWhiteSpace(customer.Phone) ? "" : $" — {customer.Phone}")
                                    </option>
                                }
                            </select>
                            <button type="button" class="pi-icon-btn" id="quickCustomerBtn" title="عميل جديد">
                                <i class="bi bi-person-plus"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CustomerId" class="text-danger small"></span>
                    </div>
                    <div class="pi-customer-stats" id="customerStats" style="display:none;">
                        <div class="pi-stat">
                            <div class="pi-stat-label"><i class="bi bi-wallet2"></i> الرصيد الحالي</div>
                            <div class="pi-stat-val" id="customerBalance">0.00</div>
                        </div>
                        <div class="pi-stat">
                            <div class="pi-stat-label"><i class="bi bi-shield-check"></i> بوابة العميل</div>
                            <div class="pi-stat-val" id="customerPortal">
                                <span class="pi-portal-badge" style="color:var(--pi-muted);">
                                    <i class="bi bi-dash-circle"></i> غير مُفعّل
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="pi-panel">
                <div class="pi-panel-head">
                    <h2><i class="bi bi-file-earmark-text"></i> تفاصيل الفاتورة</h2>
                </div>
                <div class="pi-panel-body">
                    <div class="pi-metagrid">
                        <div class="pi-field">
                            <label asp-for="InvoiceDate">التاريخ</label>
                            <input asp-for="InvoiceDate" type="date" class="form-control"
                                   value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
                        </div>

                        <div class="pi-field" id="dueDateField" style="display:none;">
                            <label asp-for="DueDate">تاريخ الاستحقاق <span class="req">*</span></label>
                            <input asp-for="DueDate" type="date" class="form-control" id="dueDateInput" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="pi-field">
                            <label asp-for="BranchId">الفرع</label>
                            <div class="pi-inputgroup">
                                <select asp-for="BranchId" class="form-select" id="branchSelect">
                                    <option value="">— اختر الفرع —</option>
                                    @foreach (var branch in Model.AvailableBranches)
                                    {
                                        <option value="@branch.Id">@branch.Name</option>
                                    }
                                </select>
                                <a asp-controller="Branch" asp-action="Create" target="_blank"
                                   class="pi-icon-btn" title="فرع جديد">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            </div>
                        </div>

                        <div class="pi-field">
                            <label asp-for="StoreId">المخزن <span class="req">*</span></label>
                            <div class="pi-inputgroup">
                                <select asp-for="StoreId" class="form-select" id="storeSelect">
                                    <option value="">— اختر المخزن —</option>
                                    @foreach (var store in Model.AvailableStores)
                                    {
                                        <option value="@store.Id" data-branch="@store.BranchId">
                                            @store.Name
                                        </option>
                                    }
                                </select>
                                <button type="button" class="pi-icon-btn" id="quickStoreBtn" title="مخزن جديد">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                            <span asp-validation-for="StoreId" class="text-danger small"></span>
                        </div>

                        <div class="pi-field">
                            <label for="PaymentMethod">طريقة الدفع <span class="req">*</span></label>
                            <select id="PaymentMethod" name="PaymentMethod" class="form-select" required>
                                <option value="">— اختر طريقة الدفع —</option>
                                <option value="@((int)AccountingSystem.Models.SalesPaymentMethod.Cash)">نقدي</option>
                                <option value="@((int)AccountingSystem.Models.SalesPaymentMethod.BankTransfer)">تحويل بنكي</option>
                                <option value="@((int)AccountingSystem.Models.SalesPaymentMethod.Cheque)">شيك</option>
                                <option value="@((int)AccountingSystem.Models.SalesPaymentMethod.Credit)">آجل</option>
                                <option value="@((int)AccountingSystem.Models.SalesPaymentMethod.Wallet)">محفظة</option>
                            </select>
                            <span class="text-danger small" id="paymentMethodError"></span>
                        </div>

                        <div class="pi-field" id="cashAccountField" style="display:none;">
                            <label for="CashAccountId">المركز النقدي <span class="req">*</span></label>
                            <div class="pi-inputgroup">
                                <select id="CashAccountId" name="CashAccountId" class="form-select">
                                    <option value="">— اختر المركز النقدي —</option>
                                    @foreach (var acc in Model.AvailableCashAccounts)
                                    {
                                        <option value="@acc.Key">@acc.Value</option>
                                    }
                                </select>
                                <a asp-controller="Treasury"
                                   asp-action="Index"
                                   target="_blank"
                                   class="pi-icon-btn"
                                   title="مركز نقدي جديد">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            </div>
                            <span class="text-danger small" asp-validation-for="CashAccountId"></span>
                        </div>

                        <div class="pi-field">
                            <label asp-for="PaymentDetails">تفاصيل الدفع</label>
                            <input asp-for="PaymentDetails" class="form-control" />
                        </div>
                    </div>
                    <input asp-for="InvoiceNumber" type="hidden" />
                </div>
            </section>
        </div>

        <section class="pi-panel" style="margin-bottom: 16px;">
            <div class="pi-panel-head">
                <h2>
                    <i class="bi bi-box-seam"></i> البنود
                    <span class="text-muted" id="itemsCount" style="font-weight:600; font-size:.8rem;">(0)</span>
                </h2>
            </div>

            <div class="pi-quickbar">
                <div class="pi-quickbar-search">
                    <i class="bi bi-upc-scan"></i>
                    <input type="text" id="barcodeInput" autocomplete="off"
                           placeholder="امسح الباركود أو اكتب اسم الصنف ثم Enter..." />
                </div>
                <button type="button" class="pi-btn pi-btn-primary" id="addItemBtn">
                    <i class="bi bi-plus-lg"></i> إضافة بند
                </button>
            </div>

            <div class="pi-table-wrap">
                <table class="pi-table" id="itemsTable">
                    <thead>
                        <tr>
                            <th style="width:44px;">#</th>
                            <th style="min-width:180px;">المنتج</th>
                            <th style="width:110px;">الوحدة</th>
                            <th style="width:90px;">الكمية</th>
                            <th style="width:110px;">سعر الوحدة</th>
                            <th style="width:120px;">الإجمالي</th>
                            <th style="width:110px;">التكلفة</th>
                            <th style="width:110px;">الربح</th>
                            <th style="min-width:140px;">الدفعة</th>
                            <th style="width:44px;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        <tr class="pi-table-empty-row" id="emptyRow">
                            <td colspan="10" class="pi-table-empty">
                                <i class="bi bi-inboxes"></i>
                                لا توجد بنود بعد — استخدم شريط الإضافة السريعة أعلاه
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div asp-validation-for="Items" class="text-danger small p-2"></div>
        </section>

        <section class="pi-panel" style="margin-bottom: 16px;">
            <div class="pi-tabs">
                <button type="button" class="pi-tab is-active" data-tab="notes">
                    <i class="bi bi-journal-text"></i> ملاحظات
                </button>
                <button type="button" class="pi-tab" data-tab="shipping">
                    <i class="bi bi-truck"></i> تفاصيل إضافية
                </button>
            </div>
            <div class="pi-tab-content">
                <div class="pi-tab-panel is-active" data-tab-panel="notes">
                    <textarea asp-for="Notes" class="form-control" rows="4"
                              placeholder="أي ملاحظات تُطبع على الفاتورة..."></textarea>
                </div>
                <div class="pi-tab-panel" data-tab-panel="shipping">
                    <p class="text-muted mb-0" style="font-size:.86rem;">
                        <i class="bi bi-info-circle"></i>
                        هذه النسخة لا تحتوي على حقول شحن/مستندات في الموديل الحالي.
                    </p>
                </div>
            </div>
        </section>

        <div class="pi-footer">
            <div class="pi-totals">
                <h3><i class="bi bi-receipt"></i> ملخص الفاتورة</h3>

                <div class="pi-total-row">
                    <span>المجموع الفرعي</span>
                    <b id="subTotal" class="pi-num" style="color:var(--pi-ink);">0.00</b>
                </div>

                <div class="pi-total-row">
                    <span>الخصم</span>
                    <input asp-for="DiscountAmount" type="number" step="0.01" min="0"
                           id="discountInput" value="0" />
                </div>

                <div class="pi-tax-block">
                    <div class="pi-tax-head">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="salesTaxToggle" />
                            <label for="salesTaxToggle">
                                <i class="bi bi-percent"></i> تفعيل ضريبة المبيعات
                            </label>
                        </div>
                    </div>
                    <div class="pi-tax-body" id="salesTaxBody">
                        <div class="pi-tax-amount">
                            <div class="pi-tax-rate">
                                <span>النسبة</span>
                                <input asp-for="SalesTaxRate" type="number"
                                       step="0.01" min="0" max="100"
                                       id="salesTaxRateInput" />
                                <span>%</span>
                            </div>
                            <span>القيمة: <b id="salesTaxAmountDisplay">0.00</b></span>
                        </div>
                        <input asp-for="SalesTaxAmount" type="hidden" id="salesTaxInput" />
                    </div>
                </div>

                <div class="pi-tax-block">
                    <div class="pi-tax-head">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="vatToggle" />
                            <label for="vatToggle">
                                <i class="bi bi-percent"></i> تفعيل ضريبة القيمة المضافة
                            </label>
                        </div>
                    </div>
                    <div class="pi-tax-body" id="vatBody">
                        <div class="pi-tax-amount">
                            <div class="pi-tax-rate">
                                <span>النسبة</span>
                                <input asp-for="TaxRate" type="number"
                                       step="0.01" min="0" max="100"
                                       id="taxRateInput" />
                                <span>%</span>
                            </div>
                            <span>القيمة: <b id="taxAmountDisplay">0.00</b></span>
                        </div>
                        <input asp-for="TaxAmount" type="hidden" id="taxInput" />
                    </div>
                </div>

                <div class="pi-total-grand">
                    <span>الإجمالي النهائي</span>
                    <strong id="grandTotal">0.00</strong>
                </div>
            </div>

            <aside class="pi-save-actions">
                <button type="submit" name="saveAndConfirm" value="true" class="pi-btn pi-btn-primary">
                    <i class="bi bi-check2-circle"></i> حفظ وترحيل الفاتورة
                </button>
                <button type="submit" name="saveAndConfirm" value="false" class="pi-btn pi-btn-dark">
                    <i class="bi bi-file-earmark"></i> حفظ كمسودة
                </button>
                <a asp-action="Index" class="pi-btn pi-btn-light">
                    <i class="bi bi-x-lg"></i> إلغاء
                </a>
                <p class="text-muted text-center m-0" style="font-size:.72rem; margin-top:6px;">
                    جميع المبالغ بعملة النظام
                </p>
            </aside>
        </div>
    </form>
</div>

<!-- ═══════════ Modals ═══════════ -->

