                               placeholder="ابحث بالاسم أو الباركود..." autocomplete="off" />
                        <select id="mProduct" class="form-select" size="6"></select>
                        <div id="mSearchMsg" class="small text-danger mt-1" style="display:none;"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">الوحدة (معامل التحويل)</label>
