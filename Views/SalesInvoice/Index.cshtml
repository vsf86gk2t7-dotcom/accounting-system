@model AccountingSystem.Models.ViewModels.Pagination.PagedResult<AccountingSystem.Models.SalesInvoice>

@{
    ViewData["Title"] = "فواتير البيع";
}

<style>
    /* ✅ صفوف فواتير البيع: مؤشر يد + تمييز بصري */
    #salesInvoicesTable tbody tr.clickable-row {
        cursor: pointer;
        transition: background-color .15s ease, box-shadow .15s ease;
    }

        #salesInvoicesTable tbody tr.clickable-row:hover {
            background-color: #eef6ff !important;
            box-shadow: inset 3px 0 0 0 var(--bs-primary, #0d6efd);
        }

        #salesInvoicesTable tbody tr.clickable-row:active {
            background-color: #dbeafe !important;
        }

        #salesInvoicesTable tbody tr.clickable-row:hover td:nth-child(2) {
            color: var(--bs-primary, #0d6efd);
            font-weight: 700;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>فواتير البيع</h3>

    <a asp-action="Create" class="btn btn-primary">
        + فاتورة بيع جديدة
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null || !Model.Items.Any())
{
    <div class="alert alert-info">
        لا يوجد فواتير بيع حتى الآن.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="salesInvoicesTable">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>رقم الفاتورة</th>
                    <th>الفرع</th>
                    <th>المخزن</th>
                    <th>العميل</th>
                    <th>التاريخ</th>
                    <th>الإجمالي</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model.Items)
                {
                    <tr class="clickable-row"
                        data-href="@Url.Action("Details", "SalesInvoice", new { id = invoice.Id })"
                        title="اضغط مرتين لعرض تفاصيل الفاتورة">
                        <td>@invoice.Id</td>
                        <td>@invoice.InvoiceNumber</td>
                        <td>@(invoice.Branch?.Name ?? "-")</td>
                        <td>@(invoice.Store?.Name ?? "-")</td>
                        <td>@(invoice.Customer?.Name ?? "—")</td>
                        <td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
                        <td>@invoice.TotalAmount.ToString("N2")</td>
                        <td>
                            @switch (invoice.Status)
                            {
                                case AccountingSystem.Models.SalesInvoiceStatus.Draft:
                                    <span class="badge bg-warning text-dark">مسودة</span>
                                    break;
                                case AccountingSystem.Models.SalesInvoiceStatus.Confirmed:
                                    <span class="badge bg-success">مُعتمدة</span>
                                    break;
                                case AccountingSystem.Models.SalesInvoiceStatus.Cancelled:
                                    <span class="badge bg-danger">ملغاة</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@invoice.Id"
                               class="btn btn-sm btn-outline-primary">
                                تفاصيل
                            </a>

                            @if (invoice.Status == AccountingSystem.Models.SalesInvoiceStatus.Draft)
                            {
                                <form asp-action="Confirm"
                                      asp-route-id="@invoice.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-success"
                                            onclick="return confirm('سيتم اعتماد الفاتورة وصرف الكميات من المخزون. متابعة؟');">
                                        اعتماد
                                    </button>
                                </form>
                            }

                            @if (invoice.Status != AccountingSystem.Models.SalesInvoiceStatus.Cancelled)
                            {
                                <form asp-action="Cancel"
                                      asp-route-id="@invoice.Id"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('سيتم إلغاء الفاتورة. متابعة؟');">
                                        إلغاء
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="Model" />
}

@section Scripts {
    <script>
        (function() {
            'use strict';

            const table = document.getElementById('salesInvoicesTable');
            if (!table) return;

            table.addEventListener('dblclick', function(e) {
                if (e.target.closest('a, button, form, input, select, textarea')) return;

                const tr = e.target.closest('tr.clickable-row');
                if (!tr) return;

                const href = tr.dataset.href;
                if (!href) return;

                window.location.href = href;
            });

            table.addEventListener('mousedown', function(e) {
                const tr = e.target.closest('tr.clickable-row');
                if (tr && e.detail > 1) {
                    e.preventDefault();
                }
            });
        })();
    </script>
}