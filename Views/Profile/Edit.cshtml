@model AccountingSystem.Models.ViewModels.ProfileViewModel

@{
	ViewData["Title"] = "الملف الشخصي";
}

<div class="container py-4" style="max-width: 720px;">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h3 class="fw-bold mb-1">
				<i class="bi bi-person-circle text-primary"></i>
				الملف الشخصي
			</h3>
			<p class="text-muted mb-0">عدّل بياناتك الشخصية وصورة الملف</p>
		</div>
	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show">
			<i class="bi bi-check-circle-fill"></i>
			@TempData["Success"]
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	}

	<form asp-action="Edit"
		  method="post"
		  enctype="multipart/form-data">

		@Html.AntiForgeryToken()

		<div asp-validation-summary="ModelOnly"
			 class="alert alert-danger">
		</div>

		<div class="card shadow-sm mb-4">
			<div class="card-body text-center">

				<div class="mb-3">

					@if (!string.IsNullOrEmpty(Model.ExistingImagePath))
					{
						<img id="avatarPreview"
							 src="@Model.ExistingImagePath"
							 alt="Avatar"
							 class="rounded-circle shadow-sm"
							 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #e5e7eb;" />
					}
					else
					{
						<div id="avatarPlaceholder"
							 class="rounded-circle mx-auto d-flex align-items-center justify-content-center shadow-sm"
							 style="width: 120px; height: 120px; background: linear-gradient(135deg, #a06bff, #7de3ff); color: #fff; font-size: 3rem;">
							<i class="bi bi-person-fill"></i>
						</div>

						<img id="avatarPreview"
							 src=""
							 alt="Avatar"
							 class="rounded-circle shadow-sm d-none"
							 style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #e5e7eb;" />
					}

				</div>

				<label for="ImageFile"
					   class="btn btn-outline-primary btn-sm">
					<i class="bi bi-camera"></i>
					اختيار صورة
				</label>

				<input asp-for="ImageFile"
					   type="file"
					   id="ImageFile"
					   accept="image/jpeg,image/png,image/webp"
					   class="d-none" />

				<div class="small text-muted mt-2">
					صيغ مسموحة: jpg, png, webp — الحد الأقصى: 2 MB
				</div>

				<span asp-validation-for="ImageFile"
					  class="text-danger small d-block mt-1">
				</span>
			</div>
		</div>

		<div class="card shadow-sm mb-4">
			<div class="card-header bg-white">
				<h5 class="mb-0 fw-bold">
					<i class="bi bi-info-circle text-primary"></i>
					البيانات الأساسية
				</h5>
			</div>
			<div class="card-body">

				<div class="mb-3">
					<label asp-for="FullName"
						   class="form-label fw-semibold">
					</label>
					<input asp-for="FullName"
						   class="form-control"
						   placeholder="اكتب اسمك الكامل" />
					<span asp-validation-for="FullName"
						  class="text-danger small">
					</span>
				</div>

				<div class="mb-3">
					<label asp-for="Phone"
						   class="form-label fw-semibold">
					</label>
					<input asp-for="Phone"
						   class="form-control"
						   dir="ltr"
						   readonly
						   style="background:#f9fafb;" />
					<small class="text-muted">
						<i class="bi bi-lock-fill"></i>
						رقم الهاتف غير قابل للتعديل (يُستخدم لتسجيل الدخول)
					</small>
				</div>

				<div class="mb-3">
					<label asp-for="Address"
						   class="form-label fw-semibold">
					</label>
					<input asp-for="Address"
						   class="form-control"
						   placeholder="العنوان (اختياري)" />
					<span asp-validation-for="Address"
						  class="text-danger small">
					</span>
				</div>

				<div class="mb-0">
					<label asp-for="BirthDate"
						   class="form-label fw-semibold">
					</label>
					<input asp-for="BirthDate"
						   type="date"
						   class="form-control" />
					<span asp-validation-for="BirthDate"
						  class="text-danger small">
					</span>
				</div>

			</div>
		</div>

		<div class="d-flex justify-content-end gap-2">
			<a asp-controller="Home"
			   asp-action="Index"
			   class="btn btn-outline-secondary">
				إلغاء
			</a>

			<button type="submit"
					class="btn btn-primary px-4">
				<i class="bi bi-check2-circle"></i>
				حفظ التعديلات
			</button>
		</div>

	</form>

</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />

	<script>
		// معاينة الصورة قبل الرفع
		const fileInput =
			document.getElementById('ImageFile');

		const preview =
			document.getElementById('avatarPreview');

		const placeholder =
			document.getElementById('avatarPlaceholder');

		if (fileInput) {
			fileInput.addEventListener(
				'change',
				function () {
					const file = this.files[0];

					if (!file) return;

					const reader = new FileReader();

					reader.onload = function (e) {
						preview.src = e.target.result;
						preview.classList.remove('d-none');

						if (placeholder) {
							placeholder.classList.add('d-none');
						}
					};

					reader.readAsDataURL(file);
				}
			);
		}
	</script>
}
