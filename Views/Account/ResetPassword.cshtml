@model AccountingSystem.Models.ViewModels.ResetPasswordViewModel

@{
	ViewData["Title"] = "تعيين كلمة مرور جديدة";
}

<div class="auth-page">
	<div class="auth-container">

		<!-- Header -->
		<div class="auth-header">
			<div class="auth-logo">
				<i class="bi bi-shield-lock-fill"></i>
			</div>

			<h1>كلمة مرور جديدة</h1>

			<p>أدخل الكود وكلمة المرور الجديدة</p>
		</div>

		<!-- Card -->
		<div class="auth-card">
			<div class="auth-card-body">

				@if (TempData["Success"] != null)
				{
					<div class="alert alert-success mb-3">
						@TempData["Success"]
					</div>
				}

				<form asp-action="ResetPassword" method="post">
					@Html.AntiForgeryToken()

					<div asp-validation-summary="ModelOnly"
						 class="alert alert-danger mb-3">
					</div>

					<!-- Phone (readonly) -->
					<div class="auth-form-section">
						<label asp-for="Phone" class="auth-label">
							رقم الهاتف
						</label>

						<div class="auth-input">
							<i class="bi bi-telephone"></i>

							<input asp-for="Phone"
								   class="form-control"
								   readonly
								   style="cursor: not-allowed;" />
						</div>

						<span asp-validation-for="Phone"
							  class="auth-error">
						</span>
					</div>

					<!-- Code -->
					<div class="auth-form-section">
						<label asp-for="VerificationCode" class="auth-label">
							كود التحقق (6 أرقام)
							<span class="required">*</span>
						</label>

						<div class="auth-input">
							<i class="bi bi-shield-lock"></i>

							<input asp-for="VerificationCode"
								   class="form-control"
								   maxlength="6"
								   placeholder="XXXXXX"
								   style="font-family: monospace; letter-spacing: 4px; text-align: center; font-size: 18px; font-weight: 700;" />
						</div>

						<span asp-validation-for="VerificationCode"
							  class="auth-error">
						</span>
					</div>

					<!-- New Password -->
					<div class="auth-form-section">
						<label asp-for="Password" class="auth-label">
							كلمة المرور الجديدة
							<span class="required">*</span>
						</label>

						<div class="auth-input">
							<i class="bi bi-lock"></i>

							<input asp-for="Password"
								   type="password"
								   class="form-control"
								   placeholder="8 أحرف على الأقل" />
						</div>

						<span asp-validation-for="Password"
							  class="auth-error">
						</span>
					</div>

					<!-- Confirm -->
					<div class="auth-form-section">
						<label asp-for="ConfirmPassword" class="auth-label">
							تأكيد كلمة المرور
							<span class="required">*</span>
						</label>

						<div class="auth-input">
							<i class="bi bi-lock-fill"></i>

							<input asp-for="ConfirmPassword"
								   type="password"
								   class="form-control"
								   placeholder="••••••••" />
						</div>

						<span asp-validation-for="ConfirmPassword"
							  class="auth-error">
						</span>
					</div>

					<button type="submit"
							class="auth-submit">
						<i class="bi bi-check-circle-fill"></i>
						تعيين كلمة المرور
					</button>

				</form>

				<div class="auth-footer">
					<a asp-action="Login" class="auth-link">
						<i class="bi bi-arrow-right"></i>
						رجوع لتسجيل الدخول
					</a>
				</div>

			</div>
		</div>

	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}