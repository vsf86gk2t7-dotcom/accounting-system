@{
	ViewData["Title"] = "تسجيل الدخول";
}

<canvas id="authNeuralBg"></canvas>
<div class="auth-orb auth-orb-1"></div>
<div class="auth-orb auth-orb-2"></div>
<div class="auth-orb auth-orb-3"></div>

<div class="auth-page">
	<div class="auth-container">

		<div class="auth-status">
			<span class="auth-status-dot"></span>
			<span id="authStatusText">النظام جاهز للاتصال</span>
		</div>

		<div class="auth-type-line" id="authTypeLine"></div>

		<div class="auth-header">
			<div class="auth-logo">
				<i class="bi bi-box-arrow-in-right"></i>
			</div>

			<h1>تسجيل الدخول</h1>

			<p>أدخل بياناتك للدخول إلى حسابك</p>
		</div>

		<div class="auth-card">
			<div class="auth-card-body">

				@if (ViewBag.Error != null)
				{
					<div class="alert alert-danger mb-3">
						@ViewBag.Error
					</div>
				}

				@if (TempData["Success"] != null)
				{
					<div class="alert alert-success mb-3">
						@TempData["Success"]
					</div>
				}

				<form asp-controller="Account"
					  asp-action="Login"
					  method="post"
					  id="authForm">

					@Html.AntiForgeryToken()

					<div class="auth-form-section">
						<label class="auth-label">
							رقم الهاتف
							<span class="required">*</span>
						</label>

						<div class="auth-input">
							<i class="bi bi-telephone"></i>

							<input type="tel"
								   name="username"
								   id="authPhone"
								   class="form-control"
								   placeholder="01xxxxxxxxx"
								   autocomplete="tel"
								   required />
						</div>
					</div>

					<div class="auth-form-section">
						<label class="auth-label">
							كلمة المرور
							<span class="required">*</span>
						</label>

						<div class="auth-input">
							<i class="bi bi-lock"></i>

							<input type="password"
								   name="password"
								   id="authPassword"
								   class="form-control"
								   placeholder="••••••••"
								   autocomplete="current-password"
								   required />

							<button type="button"
									class="auth-toggle-pass"
									id="authTogglePass">
								إظهار
							</button>
						</div>

						<div class="auth-strength" id="authStrength">
							<span></span><span></span><span></span><span></span>
						</div>
						<div class="auth-strength-label" id="authStrengthLabel"></div>
					</div>

					<div class="auth-msg" id="authMsg"></div>

					<button type="submit"
							class="auth-submit"
							id="authSubmit">
						<i class="bi bi-box-arrow-in-right"></i>
						دخول
					</button>

				</form>

				<div class="auth-footer">

					<div class="auth-footer-text mb-2">
						<a asp-action="ForgotPassword"
						   class="auth-link">
							🔑 نسيت كلمة المرور؟
						</a>
					</div>

					<div class="auth-footer-text mt-3">
						ما عندكش حساب؟
					</div>

					<a asp-action="Register"
					   class="auth-link mb-3"
					   style="display: block;">
						<i class="bi bi-person-plus"></i>
						تسجيل جديد
					</a>

					<div class="auth-footer-text mt-3">
						عندك كود تفعيل؟
					</div>

					<a asp-controller="Activation"
					   asp-action="Account"
					   class="auth-secondary-btn">
						<i class="bi bi-key"></i>
						تفعيل الحساب
					</a>

				</div>

			</div>
		</div>

		<div class="auth-page-footer">
			<i class="bi bi-shield-check"></i>
			بياناتك محمية ومشفرة
		</div>

	</div>
</div>

@section Scripts {
	<script>
		(function () {
			/* ---------- الخلفية: شبكة عصبية تفاعلية ---------- */
			var canvas = document.getElementById("authNeuralBg");
			if (!canvas) return;
			var ctx = canvas.getContext("2d");
			var W, H, particles = [];
			var COUNT = 70;
			var LINK_DIST = 150;

			function resize() {
				W = canvas.width = window.innerWidth;
				H = canvas.height = window.innerHeight;
			}
			resize();
			window.addEventListener("resize", resize);

			function random(min, max) { return Math.random() * (max - min) + min; }

			for (var i = 0; i < COUNT; i++) {
				particles.push({
					x: random(0, window.innerWidth),
					y: random(0, window.innerHeight),
					vx: random(-0.35, 0.35),
					vy: random(-0.35, 0.35),
					r: random(1.2, 2.6)
				});
			}

			var mouse = { x: -9999, y: -9999 };

			function draw() {
				ctx.clearRect(0, 0, W, H);
				for (var i = 0; i < particles.length; i++) {
					var p = particles[i];
					var dxm = mouse.x - p.x, dym = mouse.y - p.y;
					var dm = Math.hypot(dxm, dym);
					if (dm < 200) {
						p.vx += (dxm / dm) * 0.02;
						p.vy += (dym / dm) * 0.02;
					}
					var speed = Math.hypot(p.vx, p.vy);
					if (speed > 0.8) { p.vx *= 0.95; p.vy *= 0.95; }

					p.x += p.vx;
					p.y += p.vy;

					if (p.x < 0 || p.x > W) p.vx *= -1;
					if (p.y < 0 || p.y > H) p.vy *= -1;

					for (var j = 0; j < particles.length; j++) {
						var q = particles[j];
						var d = Math.hypot(p.x - q.x, p.y - q.y);
						if (d < LINK_DIST) {
							var alpha = (1 - d / LINK_DIST) * 0.35;
							ctx.strokeStyle = "rgba(125, 227, 255, " + alpha + ")";
							ctx.lineWidth = 1;
							ctx.beginPath();
							ctx.moveTo(p.x, p.y);
							ctx.lineTo(q.x, q.y);
							ctx.stroke();
						}
					}

					ctx.fillStyle = "#7de3ff";
					ctx.beginPath();
					ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
					ctx.fill();
				}
				requestAnimationFrame(draw);
			}
			draw();

			window.addEventListener("pointermove", function (e) {
				mouse.x = e.clientX;
				mouse.y = e.clientY;
			});

			/* ---------- تأثير الآلة الكاتبة ---------- */
			var phrases = [
				"> initialize_session() ... OK",
				"> loading secure data ... done",
				"> encrypting connection ... TLS 1.3",
				"> verification complete. welcome!"
			];
			var typeLine = document.getElementById("authTypeLine");
			if (typeLine) {
				var phraseIdx = 0, charIdx = 0, deleting = false;
				function type() {
					var current = phrases[phraseIdx];
					if (!deleting) {
						charIdx++;
						typeLine.textContent = current.slice(0, charIdx);
						if (charIdx === current.length) {
							deleting = true;
							setTimeout(type, 2200);
							return;
						}
						setTimeout(type, 40);
					} else {
						charIdx--;
						typeLine.textContent = current.slice(0, charIdx);
						if (charIdx === 0) {
							deleting = false;
							phraseIdx = (phraseIdx + 1) % phrases.length;
						}
						setTimeout(type, 16);
					}
				}
				setTimeout(type, 600);
			}

			/* ---------- منطق النموذج ---------- */
			var form = document.getElementById("authForm");
			var phoneInput = document.getElementById("authPhone");
			var passInput = document.getElementById("authPassword");
			var msg = document.getElementById("authMsg");
			var statusText = document.getElementById("authStatusText");
			var submitBtn = document.getElementById("authSubmit");
			var strength = document.getElementById("authStrength");
			var strengthLabel = document.getElementById("authStrengthLabel");
			if (!form || !phoneInput || !passInput) return;

			var togglePass = document.getElementById("authTogglePass");
			if (togglePass) {
				togglePass.addEventListener("click", function () {
					var hidden = passInput.type === "password";
					passInput.type = hidden ? "text" : "password";
					togglePass.textContent = hidden ? "إخفاء" : "إظهار";
				});
			}

			/* مقياس قوة كلمة المرور */
			passInput.addEventListener("input", function () {
				var v = passInput.value;
				var score = 0;
				if (v.length >= 8) score++;
				if (/[A-Z]/.test(v)) score++;
				if (/\d/.test(v)) score++;
				if (/[^A-Za-z0-9]/.test(v)) score++;

				var colors = ["#ff7a8a", "#ffb454", "#ffd54f", "#5be39a"];
				var labels = ["ضعيفة جداً", "ضعيفة", "متوسطة", "قوية", "ممتازة"];
				var bars = strength.children;
				for (var i = 0; i < bars.length; i++) {
					bars[i].style.background = i < score ? colors[score - 1] : "";
				}
				strengthLabel.textContent = v ? labels[score] : "";
			});

			/* شريط الحالة التفاعلي */
			function setStatus(text) { statusText.textContent = text; }
			form.addEventListener("input", function () { setStatus("كتابة نشطة ..."); });
			phoneInput.addEventListener("focus", function () { setStatus("تشفير الاتصال آمن (TLS 1.3)"); });
			passInput.addEventListener("focus", function () { setStatus("بياناتك محمية بالكامل"); });

			function showMsg(text, ok) {
				msg.textContent = text;
				msg.className = "auth-msg " + (ok ? "auth-msg-text-success" : "auth-msg-text-danger");
			}

			/* تحقق سريع قبل الإرسال للخادم */
			form.addEventListener("submit", function (e) {
				var phone = phoneInput.value.trim();
				var pass = passInput.value;

				if (!/^01[0-9]{9}$/.test(phone)) {
					e.preventDefault();
					showMsg("رقم الهاتف لازم يبدأ بـ 01 ويكون 11 رقم", false);
					phoneInput.focus();
					return;
				}
				if (pass.length < 6) {
					e.preventDefault();
					showMsg("كلمة المرور يجب أن تكون 6 أحرف على الأقل", false);
					passInput.focus();
					return;
				}

				/* حالة الانتظار أثناء التحقق على الخادم */
				submitBtn.disabled = true;
				submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جاري التحقق الأمني...';
				setStatus("التحقق من الهوية ...");
				msg.className = "auth-msg";
				msg.textContent = "";
			});

			/* إعادة تفعيل الزر عند رجوع الصفحة (رسائل الخطأ من الخادم) */
			window.addEventListener("pageshow", function () {
				submitBtn.disabled = false;
				submitBtn.innerHTML = '<i class="bi bi-box-arrow-in-right"></i> دخول';
			});
		})();
	</script>
}