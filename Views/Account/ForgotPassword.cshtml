@model AccountingSystem.Models.ViewModels.ForgotPasswordViewModel

@{
	ViewData["Title"] = "نسيت كلمة المرور";
}

<div class="auth-page">
	<div class="auth-container">

		<!-- Header -->
		<div class="auth-header">
			<div class="auth-logo">
				<i class="bi bi-key-fill"></i>
			</div>

			<h1>نسيت كلمة المرور؟</h1>

			<p>أدخل رقم هاتفك لإرسال كود التحقق</p>
		</div>

		<!-- Card -->
		<div class="auth-card">
			<div class="auth-card-body">

				@if (TempData["Info"] != null)
				{
					<div class="alert alert-info mb-3">
						@TempData["Info"]
					</div>
				}

				@if (TempData["Error"] != null)
				{
					<div class="alert alert-danger mb-3">
						@TempData["Error"]
					</div>
				}

				<form asp-action="ForgotPassword" method="post">
					@Html.AntiForgeryToken()

					<div asp-validation-summary="ModelOnly"
						 class="alert alert-danger mb-3">
					</div>

					<div class="auth-form-section">
						<label asp-for="Phone" class="auth-label">
							رقم الهاتف
							<span class="required">*</span>
						</label>

						<div class="auth-input">
							<i class="bi bi-telephone"></i>

							<input asp-for="Phone"
								   class="form-control"
								   placeholder="01xxxxxxxxx"
								   autocomplete="tel" />
						</div>

						<span asp-validation-for="Phone"
							  class="auth-error">
						</span>
					</div>

					<button type="submit"
							class="auth-submit">
						<i class="bi bi-send"></i>
						إرسال كود التحقق
					</button>

				</form>

				<div class="auth-footer">
					<a asp-action="Login" class="auth-link">
						<i class="bi bi-arrow-right"></i>
						رجوع لتسجيل الدخول
					</a>
				</div>

			</div>
		</div>

	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}