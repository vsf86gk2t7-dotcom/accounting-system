@model AccountingSystem.Models.PurchaseInvoice

@{
    ViewData["Title"] = $"تفاصيل فاتورة شراء #{Model.InvoiceNumber}";
}

<style>
    .pd-shell {
        --pd-bg: #f4f6fa;
        --pd-surface: #fff;
        --pd-line: #e4e8f0;
        --pd-line-soft: #eef1f7;
        --pd-ink: #0f172a;
        --pd-body: #475569;
        --pd-muted: #94a3b8;
        --pd-primary: #2563eb;
        --pd-primary-dark: #1d4ed8;
        --pd-green: #059669;
        --pd-amber: #d97706;
        --pd-red: #dc2626;
        max-width: 1100px;
        margin: 0 auto;
        padding: 12px;
        font-family: 'Segoe UI', Tahoma, system-ui, sans-serif;
        color: var(--pd-ink);
    }

        .pd-shell * {
            box-sizing: border-box;
        }

    .pd-actionbar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 18px;
        margin-bottom: 16px;
        background: #fff;
        border: 1px solid var(--pd-line);
        border-radius: 14px;
        box-shadow: 0 6px 22px rgba(15,23,42,.06);
    }

        .pd-actionbar h1 {
            margin: 0;
            font-size: 1rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pd-actionbar h1 i {
                color: var(--pd-primary);
            }

    .pd-spacer {
        flex: 1;
    }

    .pd-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 800;
    }

        .pd-status.draft {
            background: #fef3c7;
            color: #92400e;
        }

        .pd-status.posted {
            background: #d1fae5;
            color: #065f46;
        }

        .pd-status.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

    .pd-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 9px;
        font-size: .84rem;
        font-weight: 700;
        border: 1px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: .16s;
    }

        .pd-btn:hover {
            transform: translateY(-1px);
            text-decoration: none;
        }

    .pd-btn-primary {
        background: var(--pd-primary);
        color: #fff;
    }

        .pd-btn-primary:hover {
            background: var(--pd-primary-dark);
            color: #fff;
        }

    .pd-btn-dark {
        background: #0f172a;
        color: #fff;
    }

        .pd-btn-dark:hover {
            background: #1e293b;
            color: #fff;
        }

    .pd-btn-light {
        background: #fff;
        color: var(--pd-body);
        border-color: var(--pd-line);
    }

        .pd-btn-light:hover {
            background: var(--pd-bg);
            color: var(--pd-ink);
        }

    .pd-btn-danger {
        background: var(--pd-red);
        color: #fff;
    }

        .pd-btn-danger:hover {
            background: #b91c1c;
            color: #fff;
        }

    .pd-btn-success {
        background: var(--pd-green);
        color: #fff;
    }

        .pd-btn-success:hover {
            background: #047857;
            color: #fff;
        }

    .pd-card {
        background: var(--pd-surface);
        border: 1px solid var(--pd-line);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .pd-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        background: #fafbfd;
        border-bottom: 1px solid var(--pd-line-soft);
    }

        .pd-card-head h2 {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            font-size: .88rem;
            font-weight: 800;
        }

            .pd-card-head h2 i {
                color: var(--pd-primary);
            }

    .pd-card-body {
        padding: 16px 18px;
    }

    .pd-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
    }

    .pd-info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .pd-info-label {
        font-size: .72rem;
        font-weight: 700;
        color: var(--pd-muted);
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .pd-info-value {
        font-size: .9rem;
        font-weight: 700;
        color: var(--pd-ink);
    }

        .pd-info-value.mono {
            font-family: 'Consolas', monospace;
            direction: ltr;
        }

    .pd-table {
        width: 100%;
        border-collapse: collapse;
    }

        .pd-table thead th {
            background: #f8fafc;
            color: var(--pd-body);
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .3px;
            padding: 10px 12px;
            border-bottom: 1.5px solid var(--pd-line);
            text-align: right;
            white-space: nowrap;
        }

        .pd-table tbody td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--pd-line-soft);
            font-size: .86rem;
            vertical-align: middle;
        }

        .pd-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .pd-table tbody tr:hover {
            background: #fafbfd;
        }

        .pd-table .pd-num {
            font-family: 'Consolas', monospace;
            direction: ltr;
            text-align: left;
        }

    .pd-total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        font-size: .9rem;
        color: var(--pd-body);
        gap: 12px;
        border-bottom: 1px solid var(--pd-line-soft);
    }

        .pd-total-row:last-child {
            border-bottom: 0;
        }

        .pd-total-row > span:first-child {
            font-weight: 600;
        }

        .pd-total-row b {
            font-family: 'Consolas', monospace;
            font-weight: 800;
            color: var(--pd-ink);
            direction: ltr;
            min-width: 110px;
            text-align: left;
        }

        .pd-total-row .pd-tax-label {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .pd-total-row .pd-tax-label i {
                color: var(--pd-primary);
            }

        .pd-total-row .pd-rate {
            font-size: .72rem;
            background: #eff6ff;
            color: var(--pd-primary-dark);
            padding: 2px 7px;
            border-radius: 5px;
            font-weight: 700;
        }

        .pd-total-row.sales-tax b {
            color: #7c3aed;
        }

        .pd-total-row.vat b {
            color: var(--pd-primary);
        }

    .pd-total-grand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0 4px;
        margin-top: 8px;
        border-top: 2px solid var(--pd-line);
    }

        .pd-total-grand span {
            font-weight: 800;
            font-size: 1rem;
        }

        .pd-total-grand strong {
            font-size: 1.6rem;
            font-weight: 900;
            color: var(--pd-primary);
            font-family: 'Segoe UI', sans-serif;
            direction: ltr;
        }

    .pd-notes {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: .86rem;
        color: #78350f;
        line-height: 1.7;
    }

        .pd-notes i {
            color: var(--pd-amber);
            margin-left: 6px;
        }

    @@media print {
        .app-sidebar, .app-topbar, .app-footer,
        .pd-actionbar {
            display: none !important;
        }

        .pd-shell {
            padding: 0;
            max-width: 100%;
        }

        .pd-card {
            box-shadow: none;
            border-color: #ddd;
            page-break-inside: avoid;
        }
    }
</style>

<div class="pd-shell">

    @{
        var statusClass = Model.Status switch
        {
            AccountingSystem.Models.PurchaseInvoiceStatus.Draft => "draft",
            AccountingSystem.Models.PurchaseInvoiceStatus.Posted => "posted",
            AccountingSystem.Models.PurchaseInvoiceStatus.Cancelled => "cancelled",
            _ => "draft"
        };
        var statusText = Model.Status switch
        {
            AccountingSystem.Models.PurchaseInvoiceStatus.Draft => "مسودة",
            AccountingSystem.Models.PurchaseInvoiceStatus.Posted => "مُرحّلة",
            AccountingSystem.Models.PurchaseInvoiceStatus.Cancelled => "ملغاة",
            _ => "—"
        };
    }

    <!-- ═══════════ Action bar ═══════════ -->
    <div class="pd-actionbar">
        <h1>
            <i class="bi bi-receipt"></i>
            فاتورة شراء <span dir="ltr">@Model.InvoiceNumber</span>
            <span class="pd-status @statusClass">
                <i class="bi bi-circle-fill" style="font-size:.4rem;"></i>
                @statusText
            </span>
        </h1>

        <div class="pd-spacer"></div>

        <button type="button" class="pd-btn pd-btn-light" onclick="window.print();">
            <i class="bi bi-printer"></i> طباعة
        </button>

        @if (Model.Status == AccountingSystem.Models.PurchaseInvoiceStatus.Posted)
        {
            <form asp-action="SendWhatsApp" asp-route-id="@Model.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="pd-btn pd-btn-success">
                    <i class="bi bi-whatsapp"></i> إرسال واتساب
                </button>
            </form>
        }

        @if (Model.Status == AccountingSystem.Models.PurchaseInvoiceStatus.Draft)
        {
            <form asp-action="Post" asp-route-id="@Model.Id" method="post" style="display:inline;"
                  onsubmit="return confirm('هل تريد ترحيل الفاتورة؟ سيتم إضافة الكميات للمخزون وترحيل القيد المحاسبي.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="pd-btn pd-btn-primary">
                    <i class="bi bi-check2-circle"></i> ترحيل
                </button>
            </form>
        }

        @if (Model.Status != AccountingSystem.Models.PurchaseInvoiceStatus.Cancelled)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" style="display:inline;"
                  onsubmit="return confirm('هل أنت متأكد من إلغاء الفاتورة؟');">
                @Html.AntiForgeryToken()
                <button type="submit" class="pd-btn pd-btn-danger">
                    <i class="bi bi-x-circle"></i> إلغاء
                </button>
            </form>
        }

        <a asp-action="Index" class="pd-btn pd-btn-light">
            <i class="bi bi-arrow-right"></i> رجوع
        </a>
    </div>

    <!-- ═══════════ بيانات أساسية ═══════════ -->
    <div class="pd-card">
        <div class="pd-card-head">
            <h2><i class="bi bi-info-circle"></i> بيانات الفاتورة</h2>
        </div>
        <div class="pd-card-body">
            <div class="pd-info-grid">
                <div class="pd-info-item">
                    <span class="pd-info-label">المورد</span>
                    <span class="pd-info-value">@(Model.Supplier?.Name ?? "—")</span>
                </div>
                <div class="pd-info-item">
                    <span class="pd-info-label">هاتف المورد</span>
                    <span class="pd-info-value mono">@(Model.Supplier?.Phone ?? "—")</span>
                </div>
                <div class="pd-info-item">
                    <span class="pd-info-label">المخزن</span>
                    <span class="pd-info-value">@(Model.Store?.Name ?? "—")</span>
                </div>
                <div class="pd-info-item">
                    <span class="pd-info-label">الفرع</span>
                    <span class="pd-info-value">@(Model.Store?.Branch?.Name ?? "—")</span>
                </div>
                <div class="pd-info-item">
                    <span class="pd-info-label">تاريخ الفاتورة</span>
                    <span class="pd-info-value mono">@Model.InvoiceDate.ToString("yyyy-MM-dd")</span>
                </div>
                <div class="pd-info-item">
                    <span class="pd-info-label">تاريخ الاستحقاق</span>
                    <span class="pd-info-value mono">@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                </div>
                @if (Model.PostedAt.HasValue)
                {
                    <div class="pd-info-item">
                        <span class="pd-info-label">تاريخ الترحيل</span>
                        <span class="pd-info-value mono">@Model.PostedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ═══════════ البنود ═══════════ -->
    <div class="pd-card">
        <div class="pd-card-head">
            <h2><i class="bi bi-box-seam"></i> البنود (@Model.Items.Count)</h2>
        </div>
        <div style="overflow-x:auto;">
            <table class="pd-table">
                <thead>
                    <tr>
                        <th style="width:40px;">#</th>
                        <th>الصنف</th>
                        <th style="width:100px;">الوحدة</th>
                        <th style="width:80px;">الكمية</th>
                        <th style="width:100px;">قطع/وحدة</th>
                        <th style="width:100px;">كمية أساسية</th>
                        <th style="width:110px;">سعر القطعة</th>
                        <th style="width:120px;">الإجمالي</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idx = 1;
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="text-align:center; color:var(--pd-muted); font-weight:700;">
                                @idx
                            </td>
                            <td style="font-weight:700;">@(item.Product?.Name ?? "—")</td>
                            <td>@(item.Unit?.Name ?? "—")</td>
                            <td class="pd-num">@item.Quantity.ToString("N3")</td>
                            <td class="pd-num">@item.ConversionFactor.ToString("N3")</td>
                            <td class="pd-num">@item.QuantityInBaseUnit.ToString("N3")</td>
                            <td class="pd-num">@item.UnitPrice.ToString("N4")</td>
                            <td class="pd-num" style="font-weight:800; color:var(--pd-primary-dark);">
                                @item.LineTotal.ToString("N2")
                            </td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ═══════════ الإجماليات ═══════════ -->
    <div class="pd-card">
        <div class="pd-card-head">
            <h2><i class="bi bi-calculator"></i> الإجماليات</h2>
        </div>
        <div class="pd-card-body">

            <div class="pd-total-row">
                <span>المجموع الفرعي</span>
                <b>@Model.SubTotal.ToString("N2")</b>
            </div>

            @if (Model.DiscountAmount > 0)
            {
                <div class="pd-total-row">
                    <span>الخصم</span>
                    <b style="color: var(--pd-red);">− @Model.DiscountAmount.ToString("N2")</b>
                </div>
            }

            @* ═════════ ضريبة المبيعات ═════════ *@
            @if (Model.SalesTaxRate > 0 || Model.SalesTaxAmount > 0)
            {
                <div class="pd-total-row sales-tax">
                    <span class="pd-tax-label">
                        <i class="bi bi-percent"></i>
                        ضريبة المبيعات
                        <span class="pd-rate">@Model.SalesTaxRate.ToString("N2")%</span>
                    </span>
                    <b>@Model.SalesTaxAmount.ToString("N2")</b>
                </div>
            }

            @* ═════════ ضريبة القيمة المضافة ═════════ *@
            @if (Model.TaxRate > 0 || Model.TaxAmount > 0)
            {
                <div class="pd-total-row vat">
                    <span class="pd-tax-label">
                        <i class="bi bi-percent"></i>
                        ضريبة القيمة المضافة
                        <span class="pd-rate">@Model.TaxRate.ToString("N2")%</span>
                    </span>
                    <b>@Model.TaxAmount.ToString("N2")</b>
                </div>
            }

            @if (Model.SalesTaxAmount == 0 && Model.TaxAmount == 0)
            {
                <div class="pd-total-row" style="color: var(--pd-muted); font-size:.82rem;">
                    <span><i class="bi bi-info-circle"></i> لا توجد ضرائب مفعّلة على هذه الفاتورة</span>
                    <b>—</b>
                </div>
            }

            <div class="pd-total-grand">
                <span>الإجمالي النهائي</span>
                <strong>@Model.TotalAmount.ToString("N2")</strong>
            </div>
        </div>
    </div>

    <!-- ═══════════ ملاحظات ═══════════ -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="pd-card">
            <div class="pd-card-head">
                <h2><i class="bi bi-journal-text"></i> ملاحظات</h2>
            </div>
            <div class="pd-card-body">
                <div class="pd-notes">
                    <i class="bi bi-sticky"></i>
                    @Model.Notes
                </div>
            </div>
        </div>
    }

</div>