@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            'use strict';

            // ═══════════ Server data ═══════════
            const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.AvailableProducts,
                            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));

            const stores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.AvailableStores,
                            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = null, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));

            // ═══════════ Elements ═══════════
            const itemsBody = document.getElementById('itemsBody');
            const emptyRow = document.getElementById('emptyRow');
            const addItemBtn = document.getElementById('addItemBtn');
            const barcodeInput = document.getElementById('barcodeInput');
            const quickQty = document.getElementById('quickQty');
            const quickPrice = document.getElementById('quickPrice');

            const supplierSelect = document.getElementById('supplierSelect');
            const branchSelect = document.getElementById('branchSelect');
            const storeSelect = document.getElementById('storeSelect');

            const discountInput = document.getElementById('discountInput');

            const salesTaxToggle = document.getElementById('salesTaxToggle');
            const salesTaxBody = document.getElementById('salesTaxBody');
            const salesTaxRateInput = document.getElementById('salesTaxRateInput');
            const salesTaxInput = document.getElementById('salesTaxInput');
            const salesTaxAmountDisplay = document.getElementById('salesTaxAmountDisplay');

            const vatToggle = document.getElementById('vatToggle');
            const vatBody = document.getElementById('vatBody');
            const taxRateInput = document.getElementById('taxRateInput');
            const taxInput = document.getElementById('taxInput');
            const taxAmountDisplay = document.getElementById('taxAmountDisplay');

            const subTotalEl = document.getElementById('subTotal');
            const grandTotalEl = document.getElementById('grandTotal');
            const itemsCountEl = document.getElementById('itemsCount');

            const supplierStats = document.getElementById('supplierStats');
            const supplierBalance = document.getElementById('supplierBalance');
            const supplierPortal = document.getElementById('supplierPortal');

            const token = () => {
                const el = document.querySelector('input[name="__RequestVerificationToken"]');
                return el ? el.value : '';
            };

            // ═══════════ Supplier info ═══════════
            async function loadSupplierInfo(supplierId) {
                if (!supplierId || parseInt(supplierId) <= 0) {
                    supplierStats.style.display = 'none';
                    return;
                }

                supplierStats.style.display = 'grid';
                supplierBalance.innerHTML = '<span class="pi-loading"></span>';
                supplierPortal.innerHTML = '<span class="pi-loading"></span>';

                try {
                    const res = await fetch(`/PurchaseInvoice/GetSupplierInfo?id=${supplierId}`, {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!res.ok) throw new Error();
                    const data = await res.json();

                    if (!data.ok) {
                        supplierStats.style.display = 'none';
                        return;
                    }

                    const bal = parseFloat(data.balance) || 0;
                    if (bal > 0.005) {
                        supplierBalance.className = 'pi-stat-val is-credit';
                        supplierBalance.innerHTML =
                            bal.toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) +
                            ' <small>دائن (له عندنا)</small>';
                    } else if (bal < -0.005) {
                        supplierBalance.className = 'pi-stat-val is-debit';
                        supplierBalance.innerHTML =
                            Math.abs(bal).toLocaleString('ar-EG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) +
                            ' <small>مدين (لنا عنده)</small>';
                    } else {
                        supplierBalance.className = 'pi-stat-val';
                        supplierBalance.textContent = '0.00';
                    }

                    if (data.hasPortalAccount) {
                        supplierPortal.innerHTML =
                            '<span class="pi-portal-badge" style="color:var(--pi-green);">' +
                            '<i class="bi bi-check-circle-fill"></i> مُفعّل</span>';
                    } else if (data.portalApproved) {
                        supplierPortal.innerHTML =
                            '<span class="pi-portal-badge" style="color:var(--pi-amber);">' +
                            '<i class="bi bi-clock-history"></i> بانتظار الإنشاء</span>';
                    } else if (data.portalRequested) {
                        supplierPortal.innerHTML =
                            '<span class="pi-portal-badge" style="color:var(--pi-muted);">' +
                            '<i class="bi bi-hourglass-split"></i> قيد المراجعة</span>';
                    } else {
                        supplierPortal.innerHTML =
                            '<span class="pi-portal-badge" style="color:var(--pi-muted);">' +
                            '<i class="bi bi-dash-circle"></i> غير مُفعّل</span>';
                    }
                } catch {
                    supplierBalance.textContent = '—';
                    supplierPortal.textContent = '—';
                }
            }

            supplierSelect.addEventListener('change', function() {
                loadSupplierInfo(this.value);
                // إعادة حساب كل السطور لأن آخر تعبئة تعتمد على المورد
                document.querySelectorAll('tr.pi-row').forEach(tr => {
                    if (tr.querySelector('.product-select').value) {
                        syncConversionFactor(tr);
                    }
                });
            });

            // ═══════════ Stores filter ═══════════
            function populateStores(branchId) {
                const current = storeSelect.value;
                storeSelect.innerHTML = '<option value="">— اختر المخزن —</option>';
                stores.filter(s => !branchId || s.BranchId === branchId).forEach(s => {
                    const opt = document.createElement('option');
                    opt.value = s.Id;
                    opt.textContent = (s.BranchName ? s.BranchName + ' — ' : '') + s.Name;
                    opt.dataset.branch = s.BranchId;
                    storeSelect.appendChild(opt);
                });
                if (current && storeSelect.querySelector(`option[value="${current}"]`)) {
                    storeSelect.value = current;
                }
            }

            branchSelect.addEventListener('change', function() {
                populateStores(parseInt(this.value) || 0);
            });

            storeSelect.addEventListener('change', function() {
                const st = stores.find(s => s.Id === parseInt(this.value));
                if (st && String(st.BranchId) !== branchSelect.value) {
                    branchSelect.value = st.BranchId;
                    populateStores(st.BranchId);
                    storeSelect.value = st.Id;
                }
            });

            // ═══════════ Rows ═══════════
            let rowIndex = 0;

            function renumber() {
                const rows = itemsBody.querySelectorAll('tr.pi-row');
                rows.forEach((tr, i) => {
                    const idx = tr.querySelector('.pi-idx');
                    if (idx) idx.textContent = i + 1;
                    tr.querySelectorAll('[name]').forEach(el => {
                        el.name = el.name.replace(/Items\[\d+\]/, `Items[${i}]`);
                    });
                });
                const n = rows.length;
                itemsCountEl.textContent = `(${n})`;
                emptyRow.style.display = n ? 'none' : '';
            }

            function buildRowHtml(idx) {
                let productOpts = '<option value="">— اختر —</option>';
                products.forEach(p => {
                    productOpts += `<option value="${p.Id}">${p.Name}</option>`;
                });
                return `
                                    <td class="pi-idx">${idx + 1}</td>
                                    <td>
                                        <select name="Items[${idx}].ProductId" class="product-select" data-idx="${idx}">
                                            ${productOpts}
                                        </select>
                                    </td>
                                    <td>
                                        <select name="Items[${idx}].UnitId" class="unit-select" data-idx="${idx}">
                                            <option value="">— اختر —</option>
                                        </select>
                                        <button type="button" class="btn btn-sm btn-link p-0 add-unit-btn"
                                                data-idx="${idx}" style="font-size:.7rem; text-decoration:none;">
                                            <i class="bi bi-plus-circle"></i> وحدة
                                        </button>
                                    </td>
                                    <td>
                                        <input type="number" step="0.001" min="0" value="1"
                                               name="Items[${idx}].Quantity" class="qty-input" data-idx="${idx}" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.0001" min="0" value="1"
                                               name="Items[${idx}].ConversionFactor" class="conversion-factor" data-idx="${idx}"
                                               title="عدد القطع داخل الوحدة (12 للدستة)" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.0001" min="0" value="0"
                                               name="Items[${idx}].UnitPrice" class="price-input" data-idx="${idx}" />
                                    </td>
                                    <td><span class="pi-linetotal">0.00</span></td>
                                    <td><button type="button" class="pi-del" title="حذف">&times;</button></td>`;
            }

            function fillUnits(tr, product) {
                const unitSel = tr.querySelector('.unit-select');
                unitSel.innerHTML = '<option value="">— اختر —</option>';
                (product?.Units || []).forEach(u => {
                    const o = document.createElement('option');
                    o.value = u.UnitId;
                    o.textContent = u.UnitName;
                    o.dataset.factor = u.ConversionFactor ?? 1;
                    o.dataset.kind = u.Kind ?? 1;                 // 0=Standard, 1=Variable
                    o.dataset.pieces = u.PiecesPerUnit ?? '';     // للوحدات الثابتة
                    unitSel.appendChild(o);
                });

                // افتراضياً: اختر "قطعة" إن وُجدت، وإلا أول وحدة
                const idx = (product?.Units || []).findIndex(u => (u.UnitName || '').trim() === 'قطعة');
                if (idx >= 0) unitSel.selectedIndex = idx + 1;
                else if (product?.Units?.length) unitSel.selectedIndex = 1;

                syncConversionFactor(tr);
            }

            // ✅ جديد: مزامنة عمود "قطع/وحدة" حسب نوع الوحدة
            function syncConversionFactor(tr) {
                const sel = tr.querySelector('.unit-select');
                const cfInp = tr.querySelector('.conversion-factor');
                const opt = sel.selectedOptions[0];

                if (!opt || !opt.value) {
                    cfInp.value = 1;
                    cfInp.readOnly = true;
                    cfInp.classList.remove('is-variable');
                    recalcRow(tr);
                    return;
                }

                const kind = parseInt(opt.dataset.kind);          // 0=Standard, 1=Variable
                const pieces = parseFloat(opt.dataset.pieces);
                const factor = parseFloat(opt.dataset.factor) || 0;

                if (kind === 0) {
                    // ═══ وحدة ثابتة (قطعة، دستة) ═══
                    // القيمة من PiecesPerUnit
                    cfInp.value = (pieces > 0) ? pieces : 1;
                    cfInp.readOnly = true;
                    cfInp.classList.remove('is-variable');
                    recalcRow(tr);
                } else {
                    // ═══ وحدة متغيرة (كرتونة، طقم) ═══
                    // قابل للتعديل + تمييز بصري
                    cfInp.readOnly = false;
                    cfInp.classList.add('is-variable');

                    // ابدأ بـ ProductUnit.ConversionFactor
                    cfInp.value = (factor > 0) ? factor : 1;

                    // اطلب آخر تعبئة من السيرفر
                    const supplierId = parseInt(supplierSelect.value) || 0;
                    const productId = parseInt(tr.querySelector('.product-select').value) || 0;
                    const unitId = parseInt(opt.value) || 0;

                    if (supplierId > 0 && productId > 0 && unitId > 0) {
                        fetch(`/PurchaseInvoice/GetLastPacking?supplierId=${supplierId}&productId=${productId}&unitId=${unitId}`)
                            .then(r => r.json())
                            .then(d => {
                                if (d.ok && d.conversionFactor > 0) {
                                    cfInp.value = d.conversionFactor;
                                    recalcRow(tr);
                                }
                            })
                            .catch(() => { /* تجاهل */ });
                    }

                    recalcRow(tr);
                }
            }

            function recalcRow(tr) {
                const qty = parseFloat(tr.querySelector('.qty-input').value) || 0;
                const cf = parseFloat(tr.querySelector('.conversion-factor').value) || 0;
                const price = parseFloat(tr.querySelector('.price-input').value) || 0;
                const total = qty * cf * price;
                tr.dataset.total = total;
                tr.querySelector('.pi-linetotal').textContent = total.toFixed(2);
                updateTotals();
            }

            function setRowProduct(tr, product) {
                const sel = tr.querySelector('.product-select');
                const priceInp = tr.querySelector('.price-input');
                sel.value = product.Id;
                fillUnits(tr, product);
                if (!parseFloat(priceInp.value)) {
                    const dp = product.LastPurchasePrice ?? product.PurchasePrice ?? product.CostPrice ?? 0;
                    priceInp.value = Number(dp) ? Number(dp).toFixed(2) : '0';
                }
                recalcRow(tr);
            }

            function createRow() {
                const idx = rowIndex++;
                const tr = document.createElement('tr');
                tr.className = 'pi-row';
                tr.dataset.total = 0;
                tr.innerHTML = buildRowHtml(idx);
                itemsBody.appendChild(tr);

                const productSel = tr.querySelector('.product-select');
                const unitSel = tr.querySelector('.unit-select');
                const qtyInp = tr.querySelector('.qty-input');
                const cfInp = tr.querySelector('.conversion-factor');
                const priceInp = tr.querySelector('.price-input');

                productSel.addEventListener('change', function() {
                    const p = products.find(x => x.Id === parseInt(this.value));
                    if (p) {
                        fillUnits(tr, p);
                        if (!parseFloat(priceInp.value)) {
                            const dp = p.LastPurchasePrice ?? p.PurchasePrice ?? p.CostPrice ?? 0;
                            priceInp.value = Number(dp) ? Number(dp).toFixed(2) : '0';
                        }
                    } else {
                        unitSel.innerHTML = '<option value="">— اختر —</option>';
                        cfInp.value = 1;
                        cfInp.readOnly = true;
                        cfInp.classList.remove('is-variable');
                    }
                    recalcRow(tr);
                });

                unitSel.addEventListener('change', function() {
                    syncConversionFactor(tr);
                });

                [qtyInp, cfInp, priceInp].forEach(inp => {
                    inp.addEventListener('input', () => recalcRow(tr));
                });

                tr.querySelector('.add-unit-btn').addEventListener('click', () => {
                    const pid = parseInt(productSel.value) || 0;
                    if (pid <= 0) { alert('اختر الصنف أولًا.'); return; }
                    document.getElementById('addUnitProductId').value = pid;
                    document.getElementById('addUnitName').value = '';
                    document.getElementById('addUnitShort').value = '';
                    document.getElementById('addUnitFactor').value = '1';
                    document.getElementById('addUnitPrice').value = '0';
                    document.getElementById('addUnitMsg').textContent = '';
                    document.getElementById('addUnitKindVariable').checked = true;
                    toggleAddUnitFactor();
                    new bootstrap.Modal(document.getElementById('addUnitModal')).show();
                });

                tr.querySelector('.pi-del').addEventListener('click', () => {
                    tr.remove();
                    renumber();
                    updateTotals();
                });

                [qtyInp, cfInp, priceInp].forEach(inp => {
                    inp.addEventListener('keydown', e => {
                        if (e.key !== 'Enter') return;
                        e.preventDefault();
                        const fields = [qtyInp, cfInp, priceInp].filter(f => !f.readOnly);
                        const i = fields.indexOf(e.target);
                        if (i > -1 && i < fields.length - 1) {
                            fields[i + 1].focus(); fields[i + 1].select();
                        } else {
                            barcodeInput.focus();
                        }
                    });
                });

                // في البداية: لا منتج محدد → disabled
                cfInp.readOnly = true;

                renumber();
                return tr;
            }

            // ═══════════ Quick add ═══════════
            function findProductByBarcode(code) {
                code = (code || '').trim().toLowerCase();
                if (!code) return null;
                return products.find(p => (p.Barcode || '').trim().toLowerCase() === code);
            }
            function findProductByName(name) {
                name = (name || '').trim().toLowerCase();
                if (!name) return null;
                return products.find(p => (p.Name || '').trim().toLowerCase() === name);
            }

            function addProduct(product) {
                if (!product) return false;
                const qty = parseFloat(quickQty.value) || 1;
                const pInput = parseFloat(quickPrice.value);
                const price = isNaN(pInput)
                    ? Number(product.LastPurchasePrice ?? product.PurchasePrice ?? product.CostPrice ?? 0)
                    : pInput;

                const tr = createRow();
                setRowProduct(tr, product);
                tr.querySelector('.qty-input').value = qty;
                tr.querySelector('.price-input').value = price;
                recalcRow(tr);

                quickQty.value = '1';
                quickPrice.value = '';
                barcodeInput.focus();
                return true;
            }

            barcodeInput.addEventListener('keydown', function(e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                const val = this.value.trim();
                if (!val) return;

                const p = findProductByBarcode(val) || findProductByName(val);
                if (p) {
                    addProduct(p);
                    this.value = '';
                    this.classList.remove('is-invalid');
                } else {
                    this.classList.add('is-invalid');
                    this.setAttribute('title', 'لا يوجد منتج بهذا الاسم/الباركود');
                    setTimeout(() => this.classList.remove('is-invalid'), 1500);
                }
            });

            quickQty.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); barcodeInput.focus(); }
            });
            quickPrice.addEventListener('keydown', e => {
                if (e.key === 'Enter') { e.preventDefault(); barcodeInput.focus(); }
            });

            addItemBtn.addEventListener('click', () => {
                const val = barcodeInput.value.trim();
                if (val) {
                    const p = findProductByBarcode(val) || findProductByName(val);
                    if (p) {
                        addProduct(p);
                        barcodeInput.value = '';
                        return;
                    }
                }
                createRow();
            });

            // ═══════════ Totals ═══════════
            function parseNum(v) {
                const n = parseFloat(String(v ?? '').replace(',', '.'));
                return isNaN(n) ? 0 : n;
            }

            function updateTotals() {
                let sub = 0;
                itemsBody.querySelectorAll('tr.pi-row').forEach(tr => {
                    sub += parseFloat(tr.dataset.total) || 0;
                });

                const discount = Math.max(0, parseNum(discountInput.value));
                const taxable = Math.max(0, sub - discount);

                let salesTaxAmount = 0;
                if (salesTaxToggle.checked) {
                    const rate = parseNum(salesTaxRateInput.value);
                    salesTaxAmount = Math.round(taxable * rate * 100) / 10000;
                }
                salesTaxInput.value = salesTaxAmount.toFixed(2);
                salesTaxAmountDisplay.textContent = salesTaxAmount.toFixed(2);

                let vatAmount = 0;
                if (vatToggle.checked) {
                    const rate = parseNum(taxRateInput.value);
                    vatAmount = Math.round(taxable * rate * 100) / 10000;
                }
                taxInput.value = vatAmount.toFixed(2);
                taxAmountDisplay.textContent = vatAmount.toFixed(2);

                const grand = taxable + salesTaxAmount + vatAmount;
                subTotalEl.textContent = sub.toFixed(2);
                grandTotalEl.textContent = grand.toFixed(2);
            }

            discountInput.addEventListener('input', updateTotals);
            salesTaxRateInput.addEventListener('input', updateTotals);
            taxRateInput.addEventListener('input', updateTotals);

            salesTaxToggle.addEventListener('change', function() {
                if (this.checked) {
                    salesTaxBody.classList.add('is-on');
                    if (!parseNum(salesTaxRateInput.value)) {
                        salesTaxRateInput.value = '0';
                    }
                    salesTaxRateInput.focus();
                } else {
                    salesTaxBody.classList.remove('is-on');
                    salesTaxRateInput.value = '0';
                    salesTaxInput.value = '0';
                }
                updateTotals();
            });

            vatToggle.addEventListener('change', function() {
                if (this.checked) {
                    vatBody.classList.add('is-on');
                    if (!parseNum(taxRateInput.value)) {
                        taxRateInput.value = '14';
                    }
                    taxRateInput.focus();
                } else {
                    vatBody.classList.remove('is-on');
                    taxRateInput.value = '0';
                    taxInput.value = '0';
                }
                updateTotals();
            });

            // ═══════════ Tabs ═══════════
            document.querySelectorAll('.pi-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    const target = tab.dataset.tab;
                    document.querySelectorAll('.pi-tab').forEach(t =>
                        t.classList.toggle('is-active', t === tab));
                    document.querySelectorAll('.pi-tab-panel').forEach(p =>
                        p.classList.toggle('is-active', p.dataset.tabPanel === target));
                });
            });

            // ═══════════ Quick Supplier ═══════════
            const quickSupplierModal = new bootstrap.Modal(document.getElementById('quickSupplierModal'));
            const qsName = document.getElementById('qsName');
            const qsPhone = document.getElementById('qsPhone');
            const qsMsg = document.getElementById('qsMsg');

            document.getElementById('quickSupplierBtn').addEventListener('click', () => {
                qsName.value = ''; qsPhone.value = ''; qsMsg.textContent = '';
                quickSupplierModal.show();
                setTimeout(() => qsName.focus(), 300);
            });

            async function submitQuickSupplier() {
                const name = qsName.value.trim();
                const phone = qsPhone.value.trim();
                if (!name) { qsMsg.textContent = 'اسم المورد مطلوب.'; return; }
                if (!phone) { qsMsg.textContent = 'رقم الهاتف مطلوب.'; return; }

                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', token());
                body.append('name', name);
                body.append('phone', phone);

                try {
                    const res = await fetch('@Url.Action("CreateQuickSupplier", "PurchaseInvoice")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: body.toString()
                    });
                    const data = await res.json();
                    if (!data.ok) { qsMsg.textContent = data.message || 'تعذر الحفظ.'; return; }

                    const opt = document.createElement('option');
                    opt.value = data.id;
                    opt.textContent = data.name + (data.phone ? ' — ' + data.phone : '');
                    opt.dataset.phone = data.phone || '';
                    supplierSelect.appendChild(opt);
                    supplierSelect.value = data.id;
                    loadSupplierInfo(data.id);
                    quickSupplierModal.hide();
                } catch {
                    qsMsg.textContent = 'تعذر الاتصال بالخادم.';
                }
            }
            document.getElementById('qsSave').addEventListener('click', submitQuickSupplier);
            qsName.addEventListener('keydown', e => { if (e.key === 'Enter') submitQuickSupplier(); });
            qsPhone.addEventListener('keydown', e => { if (e.key === 'Enter') submitQuickSupplier(); });

            // ═══════════ Quick Store ═══════════
            const quickStoreModal = new bootstrap.Modal(document.getElementById('quickStoreModal'));
            const qsStoreName = document.getElementById('qsStoreName');
            const qsStoreBranch = document.getElementById('qsStoreBranch');
            const qsStoreMsg = document.getElementById('qsStoreMsg');

            document.getElementById('quickStoreBtn').addEventListener('click', () => {
                qsStoreName.value = ''; qsStoreMsg.textContent = '';
                qsStoreBranch.innerHTML = '';
                Array.from(branchSelect.options).filter(o => o.value).forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value; opt.textContent = o.textContent;
                    qsStoreBranch.appendChild(opt);
                });
                if (branchSelect.value) qsStoreBranch.value = branchSelect.value;
                quickStoreModal.show();
                setTimeout(() => qsStoreName.focus(), 300);
            });

            async function submitQuickStore() {
                const name = qsStoreName.value.trim();
                if (!name) { qsStoreMsg.textContent = 'اسم المخزن مطلوب.'; return; }
                if (!qsStoreBranch.value) { qsStoreMsg.textContent = 'اختر الفرع.'; return; }

                const body = new URLSearchParams();
                body.append('__RequestVerificationToken', token());
                body.append('name', name);
                body.append('branchId', qsStoreBranch.value);

                try {
                    const res = await fetch('@Url.Action("CreateQuickStore", "PurchaseInvoice")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: body.toString()
                    });
                    const data = await res.json();
                    if (!data.ok) { qsStoreMsg.textContent = data.message || 'تعذر الحفظ.'; return; }

                    const opt = document.createElement('option');
                    opt.value = data.id;
                    opt.textContent = (data.branchName ? data.branchName + ' — ' : '') + data.name;
                    opt.dataset.branch = data.branchId;
                    storeSelect.appendChild(opt);
                    storeSelect.value = data.id;
                    quickStoreModal.hide();
                } catch {
                    qsStoreMsg.textContent = 'تعذر الاتصال بالخادم.';
                }
            }
            document.getElementById('qsStoreSave').addEventListener('click', submitQuickStore);
            qsStoreName.addEventListener('keydown', e => { if (e.key === 'Enter') submitQuickStore(); });

            // ═══════════ Add Unit Modal ═══════════
            window.toggleAddUnitFactor = function() {
                const kind = parseInt(document.querySelector('input[name="addUnitKind"]:checked').value);
                const label = document.getElementById('addUnitFactorLabel');
                const help = document.getElementById('addUnitFactorHelp');
                const input = document.getElementById('addUnitFactor');

                if (kind === 0) {
                    // Standard
                    label.textContent = 'عدد القطع (ثابت) *';
                    help.textContent = 'مثال: 12 للدستة. القيمة ثابتة ولا يمكن تعديلها في الفواتير.';
                    input.min = '0.0001';
                } else {
                    // Variable
                    label.textContent = 'عدد القطع (افتراضي)';
                    help.textContent = 'قيمة اقتراحية تُستخدم عند عدم وجود تعبئة سابقة. يمكن تعديلها في كل فاتورة.';
                    input.min = '0';
                }
            };

            let addUnitInFlight = false;
            document.getElementById('addUnitSaveBtn').addEventListener('click', async function() {
                if (addUnitInFlight) return;
                const btn = this;
                const pid = parseInt(document.getElementById('addUnitProductId').value) || 0;
                const unitName = document.getElementById('addUnitName').value.trim();
                const unitShort = document.getElementById('addUnitShort').value.trim();
                const factor = parseFloat(document.getElementById('addUnitFactor').value) || 0;
                const price = parseFloat(document.getElementById('addUnitPrice').value) || 0;
                const unitKind = parseInt(document.querySelector('input[name="addUnitKind"]:checked').value);
                const msg = document.getElementById('addUnitMsg');

                if (!unitName) { msg.textContent = 'اسم الوحدة مطلوب.'; return; }
                if (unitKind === 0 && factor <= 0) {
                    msg.textContent = 'الوحدة الثابتة يجب أن يكون لها عدد قطع > 0.';
                    return;
                }

                const body = new URLSearchParams();
                body.append('productId', pid);
                body.append('unitName', unitName);
                body.append('unitShort', unitShort);
                body.append('conversionFactor', factor);
                body.append('salePrice', price);
                body.append('unitKind', unitKind);

                try {
                    addUnitInFlight = true;
                    btn.disabled = true;
                    const res = await fetch('@Url.Action("AddUnitForProduct")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token()
                        },
                        body: body.toString()
                    });
                    const result = await res.json();
                    if (!result.ok) { msg.textContent = result.message || 'حدث خطأ.'; return; }

                    const product = products.find(p => p.Id === pid);
                    if (product) {
                        product.Units = product.Units || [];
                        if (!product.Units.some(u => u.UnitId === result.unitId)) {
                            product.Units.push({
                                UnitId: result.unitId,
                                UnitName: result.unitName,
                                ConversionFactor: result.conversionFactor,
                                Kind: result.kind ?? 1,
                                PiecesPerUnit: result.piecesPerUnit ?? null
                            });
                        }
                    }

                    document.querySelectorAll('.product-select').forEach(sel => {
                        if (parseInt(sel.value) === pid) {
                            const tr = sel.closest('tr');
                            const unitSel = tr.querySelector('.unit-select');
                            const keep = unitSel.value;
                            fillUnits(tr, product);
                            if (keep) {
                                unitSel.value = keep;
                                syncConversionFactor(tr);
                            }
                            recalcRow(tr);
                        }
                    });

                    bootstrap.Modal.getInstance(document.getElementById('addUnitModal')).hide();
                } catch {
                    msg.textContent = 'تعذر الاتصال بالخادم.';
                } finally {
                    addUnitInFlight = false;
                    btn.disabled = false;
                }
            });

            // ═══════════ Restore state on POST-back ═══════════
            const serverSalesTaxRate = @(Model.SalesTaxRate.ToString(System.Globalization.CultureInfo.InvariantCulture));
            const serverSalesTaxAmount = @(Model.SalesTaxAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
            const serverVatRate = @(Model.TaxRate.ToString(System.Globalization.CultureInfo.InvariantCulture));
            const serverVatAmount = @(Model.TaxAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));
            const serverDiscount = @(Model.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture));

            if (serverSalesTaxRate > 0) {
                salesTaxToggle.checked = true;
                salesTaxBody.classList.add('is-on');
                salesTaxRateInput.value = serverSalesTaxRate;
                salesTaxInput.value = serverSalesTaxAmount.toFixed(2);
                salesTaxAmountDisplay.textContent = serverSalesTaxAmount.toFixed(2);
            }

            if (serverVatRate > 0) {
                vatToggle.checked = true;
                vatBody.classList.add('is-on');
                taxRateInput.value = serverVatRate;
                taxInput.value = serverVatAmount.toFixed(2);
                taxAmountDisplay.textContent = serverVatAmount.toFixed(2);
            }

            if (serverDiscount > 0) {
                discountInput.value = serverDiscount;
            }

            @if (Model.SupplierId > 0)
                {
                    <text>supplierSelect.value = '@Model.SupplierId';</text>
            }
                @if (Model.BranchId.HasValue && Model.BranchId.Value > 0)
                {
                    <text>branchSelect.value = '@Model.BranchId.Value';</text>
            }
                @if (Model.StoreId > 0)
                {
                    <text>storeSelect.value = '@Model.StoreId';</text>
            }

                // ═══════════ Init ═══════════
                populateStores(parseInt(branchSelect.value) || 0);

            @if (Model.StoreId > 0)
                {
                    <text>storeSelect.value = '@Model.StoreId';</text>
            }

                // ✅ في البداية: أضف سطر فارغ واحد للاستخدام
                // (يمكن للمستخدم إضافة باقي السطور من شريط الإضافة)

                updateTotals();

            if (supplierSelect.value) {
                loadSupplierInfo(supplierSelect.value);
            }

            barcodeInput.focus();

            // ═══════════ Keyboard shortcuts ═══════════
            document.addEventListener('keydown', e => {
                if (e.ctrlKey && e.key === 'Enter') {
                    e.preventDefault();
                    const btn = document.querySelector('button[name="saveAndConfirm"]');
                    if (btn) btn.click();
                }
            });

            // ═══════════ Client-side validation ═══════════
            document.getElementById('invoiceForm').addEventListener('submit', function(e) {
                if (!supplierSelect.value) {
                    e.preventDefault();
                    alert('اختر المورد أولًا'); supplierSelect.focus(); return false;
                }
                if (!storeSelect.value) {
                    e.preventDefault();
                    alert('اختر المخزن أولًا'); storeSelect.focus(); return false;
                }
                const hasItems = Array.from(itemsBody.querySelectorAll('.product-select'))
                    .some(s => s.value);
                if (!hasItems) {
                    e.preventDefault();
                    alert('أضف بندًا واحدًا على الأقل'); return false;
                }
            });
        })();
    </script>
}