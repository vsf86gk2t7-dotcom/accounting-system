@model AccountingSystem.Models.ViewModels.Treasury.TreasuryDailyCloseViewModel

@{
	ViewData["Title"] = "الإغلاق اليومي للخزينة";

	string TypeLabel(AccountingSystem.Models.TreasuryTransactionType t)
	{
		return t switch
		{
			AccountingSystem.Models.TreasuryTransactionType.Receive => "قبض",
			AccountingSystem.Models.TreasuryTransactionType.Pay => "صرف",
			AccountingSystem.Models.TreasuryTransactionType.Transfer => "تحويل",
			AccountingSystem.Models.TreasuryTransactionType.Adjust => "تسوية",
			_ => "حركة"
		};
	}

	string TypeBadge(AccountingSystem.Models.TreasuryTransactionType t)
	{
		return t switch
		{
			AccountingSystem.Models.TreasuryTransactionType.Receive => "bg-success",
			AccountingSystem.Models.TreasuryTransactionType.Pay => "bg-danger",
			AccountingSystem.Models.TreasuryTransactionType.Transfer => "bg-primary",
			AccountingSystem.Models.TreasuryTransactionType.Adjust => "bg-warning text-dark",
			_ => "bg-dark"
		};
	}
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
	<div class="alert alert-success">@TempData["Success"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>الإغلاق اليومي للخزينة</h3>

	<a asp-action="Index" class="btn btn-outline-secondary">
		العودة للخزينة
	</a>
</div>

<form method="get"
	  asp-action="DailyClose"
	  class="card shadow-sm mb-3">
	<div class="card-body py-3">
		<div class="row g-2 align-items-end">

			<div class="col-md-4">

				<label class="form-label mb-1">
					اليوم
				</label>

				<input type="date"
					   name="date"
					   value="@Model.Date.ToString("yyyy-MM-dd")"
					   class="form-control" />

			</div>

			<div class="col-md-4 d-flex gap-2">

				<button type="submit"
						class="btn btn-primary">
					عرض
				</button>

				<a asp-action="DailyClose"
				   class="btn btn-outline-secondary">
					اليوم
				</a>

			</div>

		</div>
	</div>
</form>

<div class="row g-3 mb-3">

	<div class="col-md-3">

		<div class="card shadow-sm h-100">
			<div class="card-body">
				<small class="text-muted d-block">رصيد افتتاحي</small>
				<h5 class="mb-0">@Model.TotalOpening.ToString("N2")</h5>
			</div>
		</div>

	</div>

	<div class="col-md-3">

		<div class="card shadow-sm h-100">
			<div class="card-body">
				<small class="text-muted d-block">إجمالي الوارد</small>
				<h5 class="mb-0 text-success">
					@Model.TotalIn.ToString("N2")
				</h5>
			</div>
		</div>

	</div>

	<div class="col-md-3">

		<div class="card shadow-sm h-100">
			<div class="card-body">
				<small class="text-muted d-block">إجمالي الصادر</small>
				<h5 class="mb-0 text-danger">
					@Model.TotalOut.ToString("N2")
				</h5>
			</div>
		</div>

	</div>

	<div class="col-md-3">

		<div class="card shadow-sm h-100">
			<div class="card-body">
				<small class="text-muted d-block">الرصيد الختامي المتوقع</small>
				<h5 class="mb-0">@Model.TotalClosing.ToString("N2")</h5>
			</div>
		</div>

	</div>

</div>

<div class="card shadow-sm mb-3">
	<div class="card-header fw-bold">
		أرصدة المراكز النقدية ليوم @Model.Date.ToString("yyyy-MM-dd")
	</div>

	<div class="table-responsive">

		<table class="table table-striped table-hover mb-0">
			<thead class="table-dark">
				<tr>
					<th>المركز النقدي</th>
					<th>رصيد افتتاحي</th>
					<th>وارد</th>
					<th>صادر</th>
					<th>رصيد ختامي</th>
					<th>عدد الحركات</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.Rows.Count == 0)
				{
					<tr>
						<td colspan="6" class="text-center text-muted">
							لا توجد مراكز نقدية نشطة.
						</td>
					</tr>
				}
				else
				{
					@foreach (var row in Model.Rows)
					{
						<tr>
							<td><strong>@row.AccountName</strong></td>
							<td>@row.Opening.ToString("N2")</td>
							<td class="text-success">
								@row.TotalIn.ToString("N2")
							</td>
							<td class="text-danger">
								@row.TotalOut.ToString("N2")
							</td>
							<td><strong>@row.Closing.ToString("N2")</strong></td>
							<td>@row.Count</td>
						</tr>
					}
				}
			</tbody>
			<tfoot class="table-light">
				<tr>
					<th>الإجمالي</th>
					<th>@Model.TotalOpening.ToString("N2")</th>
					<th class="text-success">
						@Model.TotalIn.ToString("N2")
					</th>
					<th class="text-danger">
						@Model.TotalOut.ToString("N2")
					</th>
					<th>@Model.TotalClosing.ToString("N2")</th>
					<th>@Model.Transactions.Count</th>
				</tr>
			</tfoot>
		</table>

	</div>
</div>

<div class="card shadow-sm">
	<div class="card-header fw-bold">
		حركات اليوم
	</div>

	<div class="table-responsive">

		<table class="table table-striped table-hover mb-0">
			<thead class="table-dark">
				<tr>
					<th>المستند</th>
					<th>النوع</th>
					<th>المركز</th>
					<th>الطرف</th>
					<th>البيان</th>
					<th>المبلغ</th>
					<th>الوقت</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.Transactions.Count == 0)
				{
					<tr>
						<td colspan="7" class="text-center text-muted">
							لا توجد حركات في هذا اليوم.
						</td>
					</tr>
				}
				else
				{
					@foreach (var t in Model.Transactions)
					{
						<tr>
							<td><strong>@t.TransactionNumber</strong></td>
							<td>
								<span class="badge @TypeBadge(t.Type)">
									@TypeLabel(t.Type)
								</span>
							</td>
							<td>
								@t.AccountName
								@if (!string.IsNullOrWhiteSpace(t.TransferToAccountName))
								{
									<small class="text-muted d-block">← @t.TransferToAccountName</small>
								}
							</td>
							<td>@(t.PartyName ?? "-")</td>
							<td>@(t.Reason ?? "-")</td>
							<td>@Math.Abs(t.Amount).ToString("N2")</td>
							<td>@t.CreatedAt.ToString("HH:mm")</td>
						</tr>
					}
				}
			</tbody>
		</table>

	</div>
</div>
