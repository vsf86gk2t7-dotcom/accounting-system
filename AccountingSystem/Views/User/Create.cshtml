@model AccountingSystem.Models.ViewModels.Users.EmployeeCreateViewModel

@{
	ViewData["Title"] = "إضافة موظف";
}

<div class="container mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2>
				<i class="bi bi-person-plus"></i>
				إضافة موظف جديد
			</h2>

			<p class="text-muted mb-0">
				إنشاء ملف الموظف وحساب الدخول وتحديد الدور ونطاق العمل.
			</p>
		</div>

		<a asp-controller="User"
		   asp-action="Index"
		   class="btn btn-secondary">
			<i class="bi bi-arrow-right"></i>
			العودة للمستخدمين
		</a>
	</div>

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">
			<i class="bi bi-exclamation-triangle"></i>
			@TempData["Error"]
		</div>
	}

	<div asp-validation-summary="ModelOnly"
		 class="alert alert-danger">
	</div>

	<form asp-controller="User"
		  asp-action="Create"
		  method="post">

		@Html.AntiForgeryToken()

		<div class="row">

			<!-- =========================================
			     بيانات الموظف
			     ========================================= -->

			<div class="col-lg-6 mb-4">

				<div class="card shadow-sm h-100">

					<div class="card-header">
						<strong>
							<i class="bi bi-person"></i>
							بيانات الموظف
						</strong>
					</div>

					<div class="card-body">

						<div class="mb-3">
							<label asp-for="Name"
								   class="form-label">
								اسم الموظف
							</label>

							<input asp-for="Name"
								   class="form-control"
								   autocomplete="name"
								   placeholder="أدخل اسم الموظف" />

							<span asp-validation-for="Name"
								  class="text-danger">
							</span>
						</div>

						<div class="mb-3">
							<label asp-for="JobTitle"
								   class="form-label">
								المسمى الوظيفي
							</label>

							<input asp-for="JobTitle"
								   class="form-control"
								   placeholder="مثال: كاشير" />

							<span asp-validation-for="JobTitle"
								  class="text-danger">
							</span>
						</div>

						<div class="mb-3">
							<label asp-for="Phone"
								   class="form-label">
								رقم الهاتف
							</label>

							<input asp-for="Phone"
								   type="tel"
								   class="form-control"
								   autocomplete="tel"
								   placeholder="01xxxxxxxxx" />

							<span asp-validation-for="Phone"
								  class="text-danger">
							</span>
						</div>

						<div class="mb-3">
							<label asp-for="Email"
								   class="form-label">
								البريد الإلكتروني
							</label>

							<input asp-for="Email"
								   type="email"
								   class="form-control"
								   autocomplete="email" />

							<span asp-validation-for="Email"
								  class="text-danger">
							</span>
						</div>

						<div class="mb-3">
							<label asp-for="Salary"
								   class="form-label">
								الراتب
							</label>

							<div class="input-group">

								<input asp-for="Salary"
									   type="number"
									   step="0.01"
									   min="0"
									   class="form-control" />

								<span class="input-group-text">
									ج.م
								</span>

							</div>

							<span asp-validation-for="Salary"
								  class="text-danger">
							</span>
						</div>

					</div>

				</div>

			</div>

			<!-- =========================================
			     الحساب والدور
			     ========================================= -->

			<div class="col-lg-6 mb-4">

				<div class="card shadow-sm h-100">

					<div class="card-header">
						<strong>
							<i class="bi bi-shield-lock"></i>
							الحساب والدور
						</strong>
					</div>

					<div class="card-body">

						<div class="mb-3">

							<label asp-for="RoleId"
								   class="form-label">
								الدور الوظيفي
							</label>

							<select asp-for="RoleId"
									class="form-select">

								<option value="">
									-- اختر الدور --
								</option>

								@foreach (var role in Model.Roles)
								{
									<option value="@role.Id">
										@role.Name
										(@role.Code)
									</option>
								}

							</select>

							<span asp-validation-for="RoleId"
								  class="text-danger">
							</span>

						</div>

						<div class="alert alert-info">
							<i class="bi bi-info-circle"></i>

							الصلاحيات لا يتم تحديدها للموظف هنا.
							الموظف يرث صلاحيات الدور الذي تم اختياره له.
						</div>

						<div class="mb-3">

							<label asp-for="Password"
								   class="form-label">
								كلمة المرور
							</label>

							<input asp-for="Password"
								   type="password"
								   class="form-control"
								   autocomplete="new-password" />

							<span asp-validation-for="Password"
								  class="text-danger">
							</span>

						</div>

						<div class="mb-3">

							<label asp-for="ConfirmPassword"
								   class="form-label">
								تأكيد كلمة المرور
							</label>

							<input asp-for="ConfirmPassword"
								   type="password"
								   class="form-control"
								   autocomplete="new-password" />

							<span asp-validation-for="ConfirmPassword"
								  class="text-danger">
							</span>

						</div>

					</div>

				</div>

			</div>

		</div>

		<!-- =========================================
		     الفروع
		     ========================================= -->

		<div class="card shadow-sm mb-4">

			<div class="card-header d-flex justify-content-between align-items-center">

				<strong>
					<i class="bi bi-building"></i>
					الفروع
				</strong>

				<span class="text-muted small">
					يمكن اختيار أكثر من فرع
				</span>

			</div>

			<div class="card-body">

				@if (!Model.Branches.Any())
				{
					<div class="alert alert-warning mb-0">
						لا توجد فروع نشطة متاحة.
					</div>
				}
				else
				{
					<div class="row">

						@foreach (var branch in Model.Branches)
						{
							<div class="col-md-4 col-lg-3 mb-3">

								<div class="border rounded p-3 h-100">

									<div class="form-check">

										<input class="form-check-input branch-checkbox"
											   type="checkbox"
											   name="BranchIds"
											   value="@branch.Id"
											   id="branch_@branch.Id"
										@(branch.IsSelected ? "checked" : "") />

										<label class="form-check-label"
											   for="branch_@branch.Id">

											<strong>
												@branch.Name
											</strong>

										</label>

									</div>

								</div>

							</div>
						}

					</div>
				}

			</div>

		</div>

		<!-- =========================================
		     المخازن
		     ========================================= -->

		<div class="card shadow-sm mb-4">

			<div class="card-header d-flex justify-content-between align-items-center">

				<strong>
					<i class="bi bi-box-seam"></i>
					المخازن
				</strong>

				<span class="text-muted small">
					يمكن اختيار أكثر من مخزن
				</span>

			</div>

			<div class="card-body">

				@if (!Model.Stores.Any())
				{
					<div class="alert alert-warning mb-0">
						لا توجد مخازن نشطة متاحة.
					</div>
				}
				else
				{
					<div class="row">

						@foreach (var store in Model.Stores)
						{
							<div class="col-md-6 col-lg-4 mb-3 store-item"
								 data-branch-id="@store.BranchId">

								<div class="border rounded p-3 h-100">

									<div class="form-check">

										<input class="form-check-input store-checkbox"
											   type="checkbox"
											   name="StoreIds"
											   value="@store.Id"
											   data-branch-id="@store.BranchId"
											   id="store_@store.Id"
										@(store.IsSelected ? "checked" : "") />

										<label class="form-check-label"
											   for="store_@store.Id">

											<strong>
												@store.Name
											</strong>

											@if (!string.IsNullOrWhiteSpace(
												store.Code))
											{
												<div class="small text-muted">
													@store.Code
												</div>
											}

										</label>

									</div>

								</div>

							</div>
						}

					</div>
				}

			</div>

		</div>

		<!-- =========================================
		     أزرار الحفظ
		     ========================================= -->

		<div class="d-flex gap-2 mb-5">

			<button type="submit"
					class="btn btn-success btn-lg">

				<i class="bi bi-check-circle"></i>
				إنشاء الموظف

			</button>

			<a asp-controller="User"
			   asp-action="Index"
			   class="btn btn-secondary btn-lg">

				إلغاء

			</a>

		</div>

	</form>

</div>

@section Scripts
{
	<partial name="_ValidationScriptsPartial" />

	<script>

		document.addEventListener(
			"DOMContentLoaded",
			function () {

				const branchCheckboxes =
					document.querySelectorAll(
						".branch-checkbox");

				const storeItems =
					document.querySelectorAll(
						".store-item");

				const storeCheckboxes =
					document.querySelectorAll(
						".store-checkbox");


				function getSelectedBranchIds() {

					const selected = [];

					branchCheckboxes.forEach(
						function (checkbox) {

							if (checkbox.checked) {
								selected.push(
									checkbox.value);
							}

						});

					return selected;
				}


				function updateStores() {

					const selectedBranchIds =
						getSelectedBranchIds();

					storeItems.forEach(
						function (item) {

							const branchId =
								item.dataset.branchId;

							const isAllowed =
								selectedBranchIds.includes(
									branchId);

							item.style.display =
								isAllowed
									? ""
									: "none";

							if (!isAllowed) {

								const checkbox =
									item.querySelector(
										".store-checkbox");

								if (checkbox) {
									checkbox.checked = false;
								}
							}

						});
				}


				branchCheckboxes.forEach(
					function (checkbox) {

						checkbox.addEventListener(
							"change",
							updateStores);

					});


				updateStores();

			});

	</script>
}