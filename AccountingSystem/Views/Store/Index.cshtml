@model IEnumerable<AccountingSystem.Models.Store>

@{
	ViewData["Title"] = "المخازن";
}

<div class="container mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">

		<div>
			<h2>المخازن</h2>

			<p class="text-muted mb-0">
				إدارة المخازن التابعة للفروع
			</p>
		</div>

		<a asp-action="Create"
		   class="btn btn-primary">
			+ إضافة مخزن
		</a>

	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success">
			@TempData["Success"]
		</div>
	}

	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger">
			@TempData["Error"]
		</div>
	}

	<div class="card shadow-sm">

		<div class="card-body">

			<div class="table-responsive">

				<table class="table table-bordered table-hover align-middle">

					<thead class="table-light">
						<tr>
							<th>الرقم</th>
							<th>المخزن</th>
							<th>الفرع</th>
							<th>الشركة</th>
							<th>الكود</th>
							<th>الحالة</th>
							<th>الإجراء</th>
						</tr>
					</thead>

					<tbody>

						@foreach (var store in Model)
						{
							<tr>

								<td>
									@store.Id
								</td>

								<td>
									<strong>
										@store.Name
									</strong>
								</td>

								<td>
									@store.Branch?.Name
								</td>

								<td>
									@store.Branch?.Company?.Name
								</td>

								<td>
									@(string.IsNullOrWhiteSpace(store.Code)
										? "-"
										: store.Code)
								</td>

								<td>

									@if (store.IsActive)
									{
										<span class="badge bg-success">
											نشط
										</span>
									}
									else
									{
										<span class="badge bg-danger">
											غير نشط
										</span>
									}

								</td>

								<td>

									<a asp-action="Edit"
									   asp-route-id="@store.Id"
									   class="btn btn-warning btn-sm">
										✏ تعديل
									</a>

									<form asp-action="ToggleActive"
										  method="post"
										  class="d-inline">

										@Html.AntiForgeryToken()

										<input type="hidden"
											   name="id"
											   value="@store.Id" />

										@if (store.IsActive)
										{
											<button type="submit"
													class="btn btn-outline-danger btn-sm">
												تعطيل
											</button>
										}
										else
										{
											<button type="submit"
													class="btn btn-outline-success btn-sm">
												تفعيل
											</button>
										}

									</form>

									<form asp-action="Delete"
										  asp-route-id="@store.Id"
										  method="post"
										  class="d-inline"
										  onsubmit="return confirm('هل أنت متأكد من حذف المخزن؟');">

										@Html.AntiForgeryToken()

										<button type="submit"
												class="btn btn-outline-danger btn-sm">
											🗑 حذف
										</button>

									</form>

								</td>

							</tr>
						}

						@if (!Model.Any())
						{
							<tr>
								<td colspan="7"
									class="text-center text-muted py-4">
									لا توجد مخازن حاليًا.
								</td>
							</tr>
						}

					</tbody>

				</table>

			</div>

		</div>

	</div>

</div>