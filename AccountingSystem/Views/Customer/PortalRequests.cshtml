@model IEnumerable<AccountingSystem.Models.Customer>

@{
    ViewData["Title"] = "طلبات حسابات العملاء";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">طلبات حسابات العملاء</h2>
            <p class="text-muted mb-0">
                إدارة طلبات الدخول إلى بوابة العملاء
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            العودة للعملاء
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    @if (TempData["ActivationQr"] != null)
    {
        <div class="card border-success mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    ✅ تم إنشاء الحساب — شارك الكود مع العميل
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-7">
                        <p>
                            <strong>العميل:</strong>
                            @TempData["ActivationPhone"]
                        </p>

                        <p>
                            <strong>كود التفعيل:</strong>
                            <br />
                            <span style="font-size: 1.8rem; letter-spacing: 4px; font-family: monospace; background: #f1f5f9; padding: 4px 12px; border-radius: 6px; display: inline-block; margin-top: 4px;">
                                @TempData["ActivationCode"]
                            </span>
                        </p>

                        <p class="mt-3">
                            <strong>لينك التفعيل:</strong>
                            <br />
                            <a href="@TempData["ActivationUrl"]"
                               target="_blank"
                               style="word-break: break-all;">
                                @TempData["ActivationUrl"]
                            </a>
                        </p>

                        <button type="button"
                                class="btn btn-outline-primary"
                                onclick="navigator.clipboard.writeText('@TempData["ActivationUrl"]'); this.textContent='✅ تم النسخ';">
                            📋 نسخ اللينك
                        </button>
                    </div>

                    <div class="col-md-5 text-center">
                        <p class="mb-2">
                            <strong>امسح الكود للتفعيل:</strong>
                        </p>

                        <a href="@TempData["ActivationUrl"]" target="_blank">
                            <img src="data:image/png;base64,@TempData["ActivationQr"]"
                                 alt="QR Code"
                                 style="max-width: 220px; border: 1px solid #e5e7eb; border-radius: 12px; padding: 10px; cursor: pointer;" />
                        </a>

                        <p class="text-muted small mt-2">
                            (اضغط على الصورة لفتح اللينك مباشرة)
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>رقم العميل</th>
                            <th>اسم العميل</th>
                            <th>رقم الهاتف</th>
                            <th>البريد الإلكتروني</th>
                            <th>حالة العميل</th>
                            <th>حالة البوابة</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var customer in Model)
                        {
                            <tr>

                                <!-- رقم العميل -->
                                <td>
                                    @customer.Id
                                </td>

                                <!-- اسم العميل -->
                                <td>
                                    <strong>
                                        @customer.Name
                                    </strong>
                                </td>

                                <!-- الهاتف -->
                                <td>
                                    @customer.Phone
                                </td>

                                <!-- البريد -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(customer.Email)
                                        ? "-"
                                        : customer.Email)
                                </td>

                                <!-- حالة العميل -->
                                <td>

                                    @if (customer.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            غير نشط
                                        </span>
                                    }

                                </td>

                                <!-- حالة البوابة -->
                                <td>

                                    @if (!customer.PortalRequested)
                                    {
                                        <span class="badge bg-secondary">
                                            لم يطلب
                                        </span>
                                    }
                                    else if (customer.PortalRequested &&
                                             !customer.PortalApproved)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            في انتظار الموافقة
                                        </span>
                                    }
                                    else if (customer.PortalApproved &&
                                             !customer.HasPortalAccount)
                                    {
                                        <span class="badge bg-info text-dark">
                                            تمت الموافقة
                                        </span>
                                    }
                                    else if (customer.HasPortalAccount)
                                    {
                                        <span class="badge bg-success">
                                            الحساب موجود
                                        </span>
                                    }

                                </td>

                                <!-- الإجراءات -->
                                <td>

                                    @if (!customer.PortalRequested)
                                    {
                                        <span class="text-muted">
                                            لا يوجد طلب
                                        </span>
                                    }
                                    else if (!customer.PortalApproved)
                                    {
                                        <!-- موافقة الإدارة -->
                                        <form asp-action="ApprovePortal"
                                              asp-route-id="@customer.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                ✅ موافقة
                                            </button>

                                        </form>
                                    }
                                    else if (customer.PortalApproved &&
                                             !customer.HasPortalAccount)
                                    {
                                        <!-- إنشاء الحساب وإرسال كود التفعيل -->
                                        <form asp-action="CreatePortalAccount"
                                              asp-route-id="@customer.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-primary">
                                                📱 إنشاء الحساب وإرسال الكود
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-success">
                                            ✅ الحساب جاهز للتفعيل
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-4">

                                    لا توجد طلبات حسابات عملاء حاليًا.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>