@model AccountingSystem.Models.Employee

@{
	ViewData["Title"] = $"ملف الموظف - {Model.Name}";

	var user = ViewBag.User as AccountingSystem.Models.User;

	var rolePermissions = ViewBag.RolePermissions
		as List<AccountingSystem.Models.Permission>
		?? new List<AccountingSystem.Models.Permission>();

	var branches = ViewBag.Branches
		as List<AccountingSystem.Models.Branch>
		?? new List<AccountingSystem.Models.Branch>();

	var stores = ViewBag.Stores
		as List<AccountingSystem.Models.Store>
		?? new List<AccountingSystem.Models.Store>();

	var role = user?.Role;
}

<div class="d-flex justify-content-between align-items-center mb-4">

	<div>
		<a asp-action="Index"
		   class="text-decoration-none text-muted small">
			← رجوع للموظفين
		</a>

		<h2 class="mb-1 mt-2">@Model.Name</h2>

		@if (role != null)
		{
			<span class="badge bg-primary">@role.Name</span>
		}
	</div>

	<div class="d-flex gap-2">
		<a asp-action="Edit"
		   asp-route-id="@Model.Id"
		   class="btn btn-outline-primary">
			✏️ تعديل
		</a>

		@if (!Model.HasPortalAccount && Model.PortalRequested)
		{
			<a asp-action="PortalRequests"
			   class="btn btn-warning">
				🔑 إدارة الحساب
			</a>
		}
	</div>

</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<!-- Tabs -->
<ul class="nav nav-tabs mb-4" id="employeeTabs" role="tablist">

	<li class="nav-item" role="presentation">
		<button class="nav-link active"
				id="tab-personal"
				data-bs-toggle="tab"
				data-bs-target="#personal"
				type="button">
			👤 البيانات الشخصية
		</button>
	</li>

	<li class="nav-item" role="presentation">
		<button class="nav-link"
				id="tab-job"
				data-bs-toggle="tab"
				data-bs-target="#job"
				type="button">
			💼 البيانات الوظيفية
		</button>
	</li>

	<li class="nav-item" role="presentation">
		<button class="nav-link"
				id="tab-role"
				data-bs-toggle="tab"
				data-bs-target="#role"
				type="button">
			🔐 الدور والصلاحيات
		</button>
	</li>

	<li class="nav-item" role="presentation">
		<button class="nav-link"
				id="tab-scope"
				data-bs-toggle="tab"
				data-bs-target="#scope"
				type="button">
			🏢 الفروع والمخازن
		</button>
	</li>

	<li class="nav-item" role="presentation">
		<button class="nav-link"
				id="tab-account"
				data-bs-toggle="tab"
				data-bs-target="#account"
				type="button">
			🔑 الحساب
		</button>
	</li>

</ul>

<!-- Tab Content -->
<div class="tab-content">

	<!-- البيانات الشخصية -->
	<div class="tab-pane fade show active" id="personal">

		<div class="card border-0 shadow-sm">
			<div class="card-body">

				<div class="row">

					<div class="col-md-6 mb-3">
						<label class="text-muted small">الاسم</label>
						<div class="fw-semibold">@Model.Name</div>
					</div>

					<div class="col-md-6 mb-3">
						<label class="text-muted small">الهاتف</label>
						<div class="fw-semibold">@(Model.Phone ?? "-")</div>
					</div>

					<div class="col-md-6 mb-3">
						<label class="text-muted small">البريد الإلكتروني</label>
						<div class="fw-semibold">@(Model.Email ?? "-")</div>
					</div>

					<div class="col-md-6 mb-3">
						<label class="text-muted small">الحالة</label>
						<div>
							@if (Model.IsActive)
							{
								<span class="badge bg-success">نشط</span>
							}
							else
							{
								<span class="badge bg-danger">غير نشط</span>
							}
						</div>
					</div>

					<div class="col-md-6 mb-3">
						<label class="text-muted small">تاريخ الإضافة</label>
						<div class="fw-semibold">
							@Model.CreatedAt.ToString("yyyy-MM-dd")
						</div>
					</div>

				</div>

			</div>
		</div>

	</div>

	<!-- البيانات الوظيفية -->
	<div class="tab-pane fade" id="job">

		<div class="card border-0 shadow-sm">
			<div class="card-body">

				<div class="row">

					<div class="col-md-6 mb-3">
						<label class="text-muted small">المسمى الوظيفي</label>
						<div class="fw-semibold">
							@(Model.JobTitle ?? "-")
						</div>
					</div>

					<div class="col-md-6 mb-3">
						<label class="text-muted small">الراتب</label>
						<div class="fw-semibold">
							@Model.Salary.ToString("N2") ج.م
						</div>
					</div>

				</div>

			</div>
		</div>

	</div>

	<!-- الدور والصلاحيات -->
	<div class="tab-pane fade" id="role">

		@if (user == null)
		{
			<div class="alert alert-warning">
				⚠️ لم يتم إنشاء حساب لهذا الموظف بعد.
			</div>
		}
		else
		{
			<div class="card border-0 shadow-sm mb-3">
				<div class="card-body">

					<div class="row">

						<div class="col-md-6 mb-3">
							<label class="text-muted small">الدور</label>
							<div>
								@if (role != null)
								{
									<span class="badge bg-primary fs-6">
										@role.Name
									</span>
								}
								else
								{
									<span class="text-muted">—</span>
								}
							</div>
						</div>

						<div class="col-md-6 mb-3">
							<label class="text-muted small">
								عدد الصلاحيات
							</label>
							<div class="fw-semibold">
								@rolePermissions.Count
							</div>
						</div>

					</div>

				</div>
			</div>

			@if (rolePermissions.Any())
			{
				<div class="card border-0 shadow-sm">
					<div class="card-header bg-light">
						<strong>الصلاحيات</strong>
					</div>

					<div class="card-body">

						@foreach (var group in rolePermissions
							.GroupBy(x => x.Group)
							.OrderBy(x => x.Key))
						{
							<div class="mb-3">

								<div class="fw-semibold text-primary mb-2">
									@group.Key
								</div>

								<div class="row">

									@foreach (var permission in group)
									{
										<div class="col-md-4 mb-2">
											<div class="d-flex align-items-center gap-2">
												<span class="text-success">✓</span>
												<span class="small">
													@permission.Name
												</span>
											</div>
										</div>
									}

								</div>

							</div>
						}

					</div>
				</div>
			}
		}

	</div>

	<!-- الفروع والمخازن -->
	<div class="tab-pane fade" id="scope">

		<div class="row">

			<!-- الفروع -->
			<div class="col-md-6 mb-3">
				<div class="card border-0 shadow-sm h-100">
					<div class="card-header bg-light">
						<strong>🏢 الفروع</strong>
					</div>

					<div class="card-body">

						@if (!branches.Any())
						{
							<div class="text-muted small">
								لم يتم تحديد فروع.
							</div>
						}
						else
						{
							<ul class="list-unstyled mb-0">
								@foreach (var branch in branches)
								{
									<li class="mb-2">
										<span class="text-primary">•</span>
										@branch.Name
									</li>
								}
							</ul>
						}

					</div>
				</div>
			</div>

			<!-- المخازن -->
			<div class="col-md-6 mb-3">
				<div class="card border-0 shadow-sm h-100">
					<div class="card-header bg-light">
						<strong>📦 المخازن</strong>
					</div>

					<div class="card-body">

						@if (!stores.Any())
						{
							<div class="text-muted small">
								لم يتم تحديد مخازن.
							</div>
						}
						else
						{
							<ul class="list-unstyled mb-0">
								@foreach (var store in stores)
								{
									<li class="mb-2">
										<span class="text-primary">•</span>
										@store.Name
									</li>
								}
							</ul>
						}

					</div>
				</div>
			</div>

		</div>

	</div>

	<!-- الحساب -->
	<div class="tab-pane fade" id="account">

		<div class="card border-0 shadow-sm">
			<div class="card-body">

				@if (user == null)
				{
					<div class="alert alert-warning mb-0">
						⚠️ لم يتم إنشاء حساب لهذا الموظف بعد.

						@if (Model.PortalRequested)
						{
							<a asp-action="PortalRequests"
							   class="btn btn-sm btn-warning ms-2">
								🔑 إدارة الحساب
							</a>
						}
					</div>
				}
				else
				{
					<div class="row">

						<div class="col-md-6 mb-3">
							<label class="text-muted small">حالة الحساب</label>
							<div>
								@if (user.IsActive)
								{
									<span class="badge bg-success">نشط</span>
								}
								else
								{
									<span class="badge bg-danger">معطّل</span>
								}
							</div>
						</div>

						<div class="col-md-6 mb-3">
							<label class="text-muted small">
								كلمة المرور
							</label>
							<div>
								@if (user.IsPasswordSet)
								{
									<span class="badge bg-success">تم التعيين</span>
								}
								else
								{
									<span class="badge bg-warning text-dark">
										لم يتم التعيين بعد
									</span>
								}
							</div>
						</div>

						<div class="col-md-6 mb-3">
							<label class="text-muted small">
								حالة الحساب
							</label>
							<div>
								@switch (user.Status)
								{
									case AccountingSystem.Models.UserStatus.Approved:
										<span class="badge bg-success">معتمد</span>
										break;
									case AccountingSystem.Models.UserStatus.Pending:
										<span class="badge bg-warning text-dark">معلّق</span>
										break;
									case AccountingSystem.Models.UserStatus.Rejected:
										<span class="badge bg-danger">مرفوض</span>
										break;
									case AccountingSystem.Models.UserStatus.Suspended:
										<span class="badge bg-secondary">موقوف</span>
										break;
								}
							</div>
						</div>

						<div class="col-md-6 mb-3">
							<label class="text-muted small">
								حساب البوابة
							</label>
							<div>
								@if (Model.HasPortalAccount)
								{
									<span class="badge bg-primary">مُنشأ</span>
								}
								else
								{
									<span class="badge bg-secondary">لا يوجد</span>
								}
							</div>
						</div>

					</div>
				}

			</div>
		</div>

	</div>

</div>

@section Scripts {
	<script>
		// تفعيل الـ Tabs لو الرابط فيه hash
		document.addEventListener("DOMContentLoaded", function() {
			const hash = window.location.hash;

			if (hash) {
				const tabButton = document.querySelector(
					`[data-bs-target="${hash}"]`
				);

				if (tabButton) {
					new bootstrap.Tab(tabButton).show();
				}
			}
		});
	</script>
}