@model AccountingSystem.Models.ViewModels.ActivateSupplierAccountViewModel

@{
	ViewData["Title"] = "تفعيل حساب المورد";

	var phoneFromQuery = Context.Request.Query["phone"].ToString();
}

<div class="row justify-content-center">
	<div class="col-md-6">
		<div class="card shadow-sm">
			<div class="card-body">
				<h3 class="card-title mb-4 text-center">
					تفعيل حساب المورد
				</h3>

				<p class="text-muted text-center mb-4">
					أدخل رقم هاتفك، وكود التفعيل الذي وصلك عبر WhatsApp،
					ثم اختر كلمة مرور جديدة.
				</p>

				@if (!string.IsNullOrWhiteSpace(phoneFromQuery))
				{
					<div class="alert alert-info">
						📱 تم تحميل رقم هاتفك تلقائيًا. اكتب كود التفعيل اللي وصلك.
					</div>
				}

				<form asp-action="Supplier" method="post">
					@Html.AntiForgeryToken()

					<div asp-validation-summary="ModelOnly"
						 class="alert alert-danger">
					</div>

					<div class="mb-3">
						<label asp-for="Phone" class="form-label">
							رقم الهاتف
						</label>
						<input asp-for="Phone"
							   class="form-control"
							   readonly
							   value="@phoneFromQuery"
							   style="background: #f1f5f9;" />
						<span asp-validation-for="Phone"
							  class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="ActivationCode" class="form-label">
							كود التفعيل (6 أرقام)
						</label>
						<input asp-for="ActivationCode"
							   class="form-control"
							   maxlength="6"
							   placeholder="******" />
						<span asp-validation-for="ActivationCode"
							  class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Password" class="form-label">
							كلمة المرور الجديدة
						</label>
						<input asp-for="Password"
							   type="password"
							   class="form-control" />
						<span asp-validation-for="Password"
							  class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="ConfirmPassword" class="form-label">
							تأكيد كلمة المرور
						</label>
						<input asp-for="ConfirmPassword"
							   type="password"
							   class="form-control" />
						<span asp-validation-for="ConfirmPassword"
							  class="text-danger"></span>
					</div>

					<button type="submit"
							class="btn btn-primary w-100">
						تفعيل الحساب
					</button>
				</form>

				<hr class="my-4" />

				<p class="text-center mb-0">
					<a asp-controller="Account" asp-action="Login">
						← رجوع لتسجيل الدخول
					</a>
				</p>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}