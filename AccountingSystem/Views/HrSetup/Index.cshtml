@model AccountingSystem.ViewModels.HrSetupViewModel

@{
ViewData["Title"] = "إعدادات الموارد البشرية";
}

<div class="mb-4">
<h2 class="mb-1">إعدادات الموارد البشرية</h2>
<p class="text-muted mb-0 small">الأقسام والمسميات الوظيفية</p>
</div>

<div class="row g-4">
<div class="col-lg-6">
<div class="card shadow-sm border-0">
<div class="card-header bg-white fw-bold">الأقسام</div>
<div class="card-body">
<form asp-action="AddDepartment" method="post" class="d-flex gap-2 mb-3">
<input name="name" class="form-control" maxlength="100"
   placeholder="اسم القسم (مثال: المبيعات)" autocomplete="off" required />
<button type="submit" class="btn btn-primary text-nowrap">إضافة</button>
</form>

<table class="table table-sm align-middle mb-0">
<thead>
<tr><th>الاسم</th><th>الموظفون</th><th>الحالة</th><th></th></tr>
</thead>
<tbody>
@foreach (var item in Model.Departments)
{
<tr>
<td>@item.Name</td>
<td>@item.EmployeesCount</td>
<td>
<span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
@(item.IsActive ? "فعّال" : "معطّل")
</span>
</td>
<td class="text-end">
<form asp-action="ToggleDepartment" asp-route-id="@item.Id" method="post">
<button type="submit" class="btn btn-sm btn-outline-secondary">
@(item.IsActive ? "تعطيل" : "تفعيل")
</button>
</form>
</td>
</tr>
}
@if (!Model.Departments.Any())
{
<tr><td colspan="4" class="text-center text-muted">لا توجد بيانات</td></tr>
}
</tbody>
</table>
</div>
</div>
</div>
<div class="col-lg-6">
<div class="card shadow-sm border-0">
<div class="card-header bg-white fw-bold">المسميات الوظيفية</div>
<div class="card-body">
<form asp-action="AddPosition" method="post" class="d-flex gap-2 mb-3">
<input name="name" class="form-control" maxlength="100"
   placeholder="المسمى (مثال: مندوب مبيعات)" autocomplete="off" required />
<button type="submit" class="btn btn-primary text-nowrap">إضافة</button>
</form>

<table class="table table-sm align-middle mb-0">
<thead>
<tr><th>الاسم</th><th>الموظفون</th><th>الحالة</th><th></th></tr>
</thead>
<tbody>
@foreach (var item in Model.Positions)
{
<tr>
<td>@item.Name</td>
<td>@item.EmployeesCount</td>
<td>
<span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
@(item.IsActive ? "فعّال" : "معطّل")
</span>
</td>
<td class="text-end">
<form asp-action="TogglePosition" asp-route-id="@item.Id" method="post">
<button type="submit" class="btn btn-sm btn-outline-secondary">
@(item.IsActive ? "تعطيل" : "تفعيل")
</button>
</form>
</td>
</tr>
}
@if (!Model.Positions.Any())
{
<tr><td colspan="4" class="text-center text-muted">لا توجد بيانات</td></tr>
}
</tbody>
</table>
</div>
</div>
</div>
</div>