@model AccountingSystem.Models.ViewModels.Products.ProductEditViewModel

@{
    ViewData["Title"] = "تعديل منتج";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                تعديل منتج
            </h2>

            <p class="text-muted mb-0">
                تعديل المنتج والتصنيفات والوحدات وأسعار البيع
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-outline-secondary">
            العودة للمنتجات
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <form asp-controller="Product"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <!-- =========================================
             بيانات المنتج
             ========================================= -->

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">
                    بيانات المنتج
                </h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            اسم المنتج
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="مثال: مياه معدنية 600 مل" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Barcode"
                               class="form-label fw-semibold">
                            الباركود
                        </label>

                        <input asp-for="Barcode"
                               class="form-control"
                               placeholder="الباركود" />

                        <span asp-validation-for="Barcode"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Code"
                               class="form-label fw-semibold">
                            كود المنتج
                        </label>

                        <input asp-for="Code"
                               class="form-control"
                               placeholder="كود المنتج" />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            الوصف
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="وصف اختياري للمنتج"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="BaseUnitId"
                               class="form-label fw-semibold">
                            الوحدة الأساسية
                        </label>

                        <select asp-for="BaseUnitId"
                                class="form-select"
                                id="baseUnitSelect">

                            <option value="0">
                                -- اختر الوحدة الأساسية --
                            </option>

                            @foreach (var unit in Model.AvailableUnits)
                            {
                                if (unit.Id == Model.BaseUnitId)
                                {
                                    <option value="@unit.Id" selected>
                                        @unit.Name
                                        @if (!string.IsNullOrWhiteSpace(unit.ShortName))
                                        {
                                            @: (@unit.ShortName)
                                        }
                                    </option>
                                }
                                else
                                {
                                    <option value="@unit.Id">
                                        @unit.Name
                                        @if (!string.IsNullOrWhiteSpace(unit.ShortName))
                                        {
                                            @: (@unit.ShortName)
                                        }
                                    </option>
                                }
                            }

                        </select>

                        <small class="text-muted d-block mt-1">
                            هذه هي الوحدة التي سيحسب بها المخزون داخليًا.
                        </small>

                        <span asp-validation-for="BaseUnitId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="MinQuantity"
                               class="form-label fw-semibold">
                            الحد الأدنى للمخزون
                        </label>

                        <input asp-for="MinQuantity"
                               type="number"
                               step="0.001"
                               min="0"
                               class="form-control" />

                        <small class="text-muted d-block mt-1">
                            يتم التنبيه عند انخفاض الرصيد عن هذا الحد.
                        </small>

                        <span asp-validation-for="MinQuantity"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-8">

                        <label class="form-label fw-bold">
                            تصنيفات المنتج
                        </label>

                        <div class="border rounded p-3 bg-light">

                            @if (Model.AvailableCategories != null &&
                                 Model.AvailableCategories.Any())
                            {
                                <div class="row g-2">

                                    @foreach (var category in Model.AvailableCategories)
                                    {
                                        var selected =
                                            Model.CategoryIds != null &&
                                            Model.CategoryIds.Contains(category.Id);

                                        <div class="col-md-4">

                                            <label class="category-option">

                                                <input type="checkbox"
                                                       name="CategoryIds"
                                                       value="@category.Id"
                                                @(selected ? "checked" : null)
                                                       class="category-checkbox" />

                                                <span class="category-name">
                                                    @category.Name
                                                </span>

                                            </label>

                                        </div>
                                    }

                                </div>

                                <div class="mt-3">

                                    <span id="selectedCategoriesCount"
                                          class="badge bg-primary">
                                        0 تصنيف محدد
                                    </span>

                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">

                                    لا توجد تصنيفات نشطة حاليًا.

                                    <a asp-controller="Category"
                                       asp-action="Create"
                                       class="alert-link">
                                        إضافة تصنيف جديد
                                    </a>

                                </div>
                            }

                        </div>

                        <small class="text-muted d-block mt-1">
                            يمكنك اختيار أكثر من تصنيف لنفس المنتج.
                        </small>

                    </div>

                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-white">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-1 fw-bold">
                            وحدات المنتج
                        </h5>

                        <small class="text-muted">
                            أضف الوحدات التي يمكن بيع المنتج بها
                        </small>

                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            id="addUnitBtn">

                        + إضافة وحدة

                    </button>

                </div>

            </div>

            <div class="card-body">

                <div class="alert alert-info">

                    <strong>مثال:</strong>

                    قطعة = 1،
                    دستة = 12،
                    كرتونة = 30.

                    النظام يستخدم معامل التحويل تلقائيًا أثناء البيع والمخزون.

                </div>

                <div class="table-responsive">

                    <table class="table table-bordered align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    الوحدة
                                </th>

                                <th>
                                    معامل التحويل
                                </th>

                                <th>
                                    سعر البيع
                                </th>

                                <th>
                                    الحالة
                                </th>

                                <th>
                                    إجراء
                                </th>

                            </tr>

                        </thead>

                        <tbody id="unitsBody">

                            @if (Model.Units != null &&
                                 Model.Units.Any())
                            {
                                for (var i = 0;
                                     i < Model.Units.Count;
                                     i++)
                                {
                                    <tr class="unit-row">

                                        <td>

                                            <select name="Units[@i].UnitId"
                                                    class="form-select unit-select">

                                                <option value="0">
                                                    -- اختر الوحدة --
                                                </option>

                                                @foreach (var unit in Model.AvailableUnits)
                                                {
                                                    if (unit.Id == Model.Units[i].UnitId)
                                                    {
                                                        <option value="@unit.Id" selected>
                                                            @unit.Name
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@unit.Id">
                                                            @unit.Name
                                                        </option>
                                                    }
                                                }

                                            </select>

                                        </td>

                                        <td>

                                            <input type="number"
                                                   name="Units[@i].ConversionFactor"
                                                   class="form-control conversion-input"
                                                   value="@Model.Units[i].ConversionFactor"
                                                   min="0.000001"
                                                   step="0.000001" />

                                        </td>

                                        <td>

                                            <input type="number"
                                                   name="Units[@i].SalePrice"
                                                   class="form-control sale-price-input"
                                                   value="@Model.Units[i].SalePrice"
                                                   min="0"
                                                   step="0.01" />

                                        </td>

                                        <td class="text-center">

                                            @if (Model.Units[i].IsActive)
                                            {
                                                <input type="checkbox"
                                                       name="Units[@i].IsActive"
                                                       value="true"
                                                       class="form-check-input"
                                                       checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox"
                                                       name="Units[@i].IsActive"
                                                       value="true"
                                                       class="form-check-input" />
                                            }

                                            <input type="hidden"
                                                   name="Units[@i].IsActive"
                                                   value="false" />

                                        </td>

                                        <td>

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm remove-unit">

                                                حذف

                                            </button>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

                <div id="noUnitsMessage"
                     class="text-center text-muted py-4">

                    لم تتم إضافة أي وحدة بعد.

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end gap-2">

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-outline-secondary">

                إلغاء

            </a>

            <button type="submit"
                    class="btn btn-success px-4">

                حفظ التعديلات

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <style>
        .category-option {
            display: flex;
            align-items: center;
            gap: 10px;
            border: 1px solid #dee2e6;
            background: white;
            padding: 10px 12px;
            border-radius: 8px;
            cursor: pointer;
            user-select: none;
            width: 100%;
        }

        .category-option:hover {
            background: #f8f9fa;
        }

        .category-checkbox {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .category-name {
            font-weight: 500;
        }
    </style>

    <script>

        // =========================================
        // عداد التصنيفات
        // =========================================

        function updateSelectedCategoriesCount() {
            const checkboxes =
                document.querySelectorAll(
                    ".category-checkbox"
                );

            let count = 0;

            checkboxes.forEach(
                checkbox => {
                    if (checkbox.checked) {
                        count++;
                    }
                }
            );

            const counter =
                document.getElementById(
                    "selectedCategoriesCount"
                );

            if (!counter) {
                return;
            }

            counter.textContent =
                `${count} تصنيف محدد`;
        }

        document
            .querySelectorAll(".category-checkbox")
            .forEach(
                checkbox => {
                    checkbox.addEventListener(
                        "change",
                        updateSelectedCategoriesCount
                    );
                }
            );

        // =========================================
        // بيانات الوحدات
        // =========================================

        // ✅ Html.Raw ضرورية لمنع Razor من ترميز JSON إلى HTML entities (&quot; &amp;)
        const availableUnits =
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.AvailableUnits.Select(x => new
                {
                    id = x.Id,
                    name = x.Name,
                    shortName = x.ShortName
                }),
                new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }
            ));

        const unitsBody =
            document.getElementById("unitsBody");

        const addUnitBtn =
            document.getElementById("addUnitBtn");

        const noUnitsMessage =
            document.getElementById("noUnitsMessage");

        const baseUnitSelect =
            document.getElementById("baseUnitSelect");

        function updateNoUnitsMessage() {
            if (!noUnitsMessage) {
                return;
            }

            const rows =
                unitsBody.querySelectorAll(".unit-row");

            noUnitsMessage.style.display =
                rows.length === 0
                    ? "block"
                    : "none";
        }

        function createUnitOptions() {
            let html =
                '<option value="0">-- اختر الوحدة --</option>';

            availableUnits.forEach(
                unit => {
                    const text =
                        unit.shortName
                            ? `${unit.name} (${unit.shortName})`
                            : unit.name;

                    html +=
                        `<option value="${unit.id}">
                                ${text}
                            </option>`;
                }
            );

            return html;
        }

        if (addUnitBtn) {
            addUnitBtn.addEventListener(
                "click",
                function() {
                    const index =
                        unitsBody.querySelectorAll(
                            ".unit-row"
                        ).length;

                    const row =
                        document.createElement("tr");

                    row.className =
                        "unit-row";

                    row.innerHTML = `
                        <td>

                            <select
                                name="Units[${index}].UnitId"
                                class="form-select unit-select">

                                ${createUnitOptions()}

                            </select>

                        </td>

                        <td>

                            <input
                                type="number"
                                name="Units[${index}].ConversionFactor"
                                class="form-control conversion-input"
                                value="1"
                                min="0.000001"
                                step="0.000001" />

                        </td>

                        <td>

                            <input
                                type="number"
                                name="Units[${index}].SalePrice"
                                class="form-control sale-price-input"
                                value="0"
                                min="0"
                                step="0.01" />

                        </td>

                        <td class="text-center">

                            <input
                                type="checkbox"
                                name="Units[${index}].IsActive"
                                value="true"
                                class="form-check-input"
                                checked />

                            <input
                                type="hidden"
                                name="Units[${index}].IsActive"
                                value="false" />

                        </td>

                        <td>

                            <button
                                type="button"
                                class="btn btn-outline-danger btn-sm remove-unit">

                                حذف

                            </button>

                        </td>
                    `;

                    unitsBody.appendChild(row);

                    updateNoUnitsMessage();
                }
            );
        }

        if (unitsBody) {
            unitsBody.addEventListener(
                "click",
                function(event) {
                    if (!event.target.classList.contains(
                        "remove-unit")) {
                        return;
                    }

                    const row =
                        event.target.closest(".unit-row");

                    if (row) {
                        row.remove();

                        reindexUnits();

                        updateNoUnitsMessage();
                    }
                }
            );
        }

        function reindexUnits() {
            const rows =
                unitsBody.querySelectorAll(".unit-row");

            rows.forEach(
                (row, index) => {
                    const select =
                        row.querySelector(
                            ".unit-select"
                        );

                    const conversion =
                        row.querySelector(
                            ".conversion-input"
                        );

                    const salePrice =
                        row.querySelector(
                            ".sale-price-input"
                        );

                    const checkbox =
                        row.querySelector(
                            'input[type="checkbox"]'
                        );

                    const hidden =
                        row.querySelector(
                            'input[type="hidden"]'
                        );

                    if (select) {
                        select.name =
                            `Units[${index}].UnitId`;
                    }

                    if (conversion) {
                        conversion.name =
                            `Units[${index}].ConversionFactor`;
                    }

                    if (salePrice) {
                        salePrice.name =
                            `Units[${index}].SalePrice`;
                    }

                    if (checkbox) {
                        checkbox.name =
                            `Units[${index}].IsActive`;
                    }

                    if (hidden) {
                        hidden.name =
                            `Units[${index}].IsActive`;
                    }
                }
            );
        }

        if (baseUnitSelect) {
            baseUnitSelect.addEventListener(
                "change",
                function() {
                    const baseUnitId =
                        parseInt(this.value);

                    const rows =
                        unitsBody.querySelectorAll(
                            ".unit-row"
                        );

                    rows.forEach(
                        row => {
                            const select =
                                row.querySelector(
                                    ".unit-select"
                                );

                            const conversion =
                                row.querySelector(
                                    ".conversion-input"
                                );

                            if (!select ||
                                !conversion) {
                                return;
                            }

                            if (
                                parseInt(select.value) ===
                                baseUnitId
                            ) {
                                conversion.value = "1";
                            }
                        }
                    );
                }
            );
        }

        updateSelectedCategoriesCount();

        updateNoUnitsMessage();

    </script>
}