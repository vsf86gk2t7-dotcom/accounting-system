@model AccountingSystem.Models.Supplier

@{
	ViewData["Title"] = "فواتير الشراء";

	var invoices =
		ViewBag.Invoices as List<AccountingSystem.Models.PurchaseInvoice>
		?? new List<AccountingSystem.Models.PurchaseInvoice>();
}

<h2 class="mb-4">فواتير الشراء</h2>

@if (!invoices.Any())
{
	<div class="alert alert-info">
		لا يوجد فواتير شراء حتى الآن.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover">
			<thead class="table-dark">
				<tr>
					<th>#</th>
					<th>رقم الفاتورة</th>
					<th>التاريخ</th>
					<th>المخزن</th>
					<th>عدد البنود</th>
					<th>الإجمالي</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var invoice in invoices)
				{
					<tr>
						<td>@invoice.Id</td>
						<td>@invoice.InvoiceNumber</td>
						<td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
						<td>@(invoice.Store?.Name ?? "-")</td>
						<td>@invoice.Items.Count</td>
						<td>@invoice.TotalAmount.ToString("N2")</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr class="table-secondary">
					<th colspan="5" class="text-end">الإجمالي الكلي:</th>
					<th>@invoices.Sum(x => x.TotalAmount).ToString("N2")</th>
				</tr>
			</tfoot>
		</table>
	</div>
}