@model AccountingSystem.Models.Branch

@{
	ViewData["Title"] = "تعديل الفرع";
}

<div class="container mt-4">

	<h2 class="mb-4">تعديل بيانات الفرع</h2>

	<div class="card shadow-sm">

		<div class="card-body">

			<form asp-action="Edit"
				  method="post">

				@Html.AntiForgeryToken()

				<input asp-for="Id" type="hidden" />

				<div asp-validation-summary="ModelOnly"
					 class="text-danger mb-3">
				</div>

				<div class="mb-3">
					<label asp-for="Name"
						   class="form-label">
						اسم الفرع
					</label>

					<input asp-for="Name"
						   class="form-control"
						   required />

					<span asp-validation-for="Name"
						  class="text-danger">
					</span>
				</div>

				<div class="mb-3">
					<label asp-for="Phone"
						   class="form-label">
						رقم الهاتف
					</label>

					<input asp-for="Phone"
						   type="tel"
						   class="form-control" />
				</div>

				<div class="mb-3">
					<label asp-for="Address"
						   class="form-label">
						العنوان
					</label>

					<textarea asp-for="Address"
							  class="form-control"
							  rows="3"></textarea>
				</div>

				<button type="submit"
						class="btn btn-success">
					حفظ التعديلات
				</button>

				<a asp-action="Index"
				   class="btn btn-secondary">
					إلغاء
				</a>

			</form>

		</div>

	</div>

</div>