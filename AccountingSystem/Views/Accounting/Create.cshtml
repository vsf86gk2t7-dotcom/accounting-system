@model AccountingSystem.Models.ViewModels.Accounting.JournalEntryViewModel

@{
	ViewData["Title"] = Model.Id > 0 ? "تعديل قيد" : "قيد محاسبي جديد";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>@(Model.Id > 0 ? "تعديل قيد" : "قيد محاسبي جديد")</h3>

	<a asp-action="Journal" class="btn btn-outline-secondary">
		العودة للقيود
	</a>
</div>

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="@(Model.Id > 0 ? "Edit" : "Create")"
	  method="post">

	@Html.AntiForgeryToken()

	<input asp-for="Id" type="hidden" />

	<div class="card shadow-sm mb-3">

		<div class="card-header">
			<h5 class="mb-0">بيانات القيد</h5>
		</div>

		<div class="card-body">

			<div class="row g-3">

				<div class="col-md-4">

					<label asp-for="EntryDate" class="form-label fw-semibold">
						تاريخ القيد
					</label>

					<input asp-for="EntryDate"
						   class="form-control"
						   type="date" />

					<span asp-validation-for="EntryDate" class="text-danger"></span>

				</div>

				<div class="col-md-8">

					<label asp-for="Description" class="form-label fw-semibold">
						بيان القيد
					</label>

					<input asp-for="Description"
						   class="form-control"
						   placeholder="مثال: صرف نثريات" />

				</div>

			</div>

		</div>

	</div>

	<div class="card shadow-sm mb-3">

		<div class="card-header d-flex justify-content-between align-items-center">

			<h5 class="mb-0">بنود القيد (مدين / دائن)</h5>

			<button type="button"
					class="btn btn-primary btn-sm"
					id="addLineBtn">
				+ إضافة بند
			</button>

		</div>

		<div class="card-body">

			<div class="table-responsive">

				<table class="table table-bordered align-middle mb-0">

					<thead class="table-light">
						<tr>
							<th>الحساب</th>
							<th style="width:160px">مدين</th>
							<th style="width:160px">دائن</th>
							<th style="width:80px">إجراء</th>
						</tr>
					</thead>

					<tbody id="linesBody">

						@if (Model.Lines != null && Model.Lines.Any())
						{
							for (var i = 0; i < Model.Lines.Count; i++)
							{
								<tr class="line-row">

									<td>

										<select name="Lines[@i].ChartAccountId"
												class="form-select account-select">

											<option value="0">
												-- اختر الحساب --
											</option>

											@foreach (var account in Model.Accounts)
											{
												<option value="@account.Key"
														selected="@(account.Key == Model.Lines[i].ChartAccountId ? "selected" : null)">
													@account.Value
												</option>
											}

										</select>

									</td>

									<td>

										<input type="number"
											   name="Lines[@i].Debit"
											   class="form-control debit-input"
											   value="@Model.Lines[i].Debit"
											   min="0"
											   step="0.01" />

									</td>

									<td>

										<input type="number"
											   name="Lines[@i].Credit"
											   class="form-control credit-input"
											   value="@Model.Lines[i].Credit"
											   min="0"
											   step="0.01" />

									</td>

									<td>

										<button type="button"
												class="btn btn-outline-danger btn-sm remove-line">
											حذف
										</button>

									</td>

								</tr>
							}
						}

					</tbody>

				</table>

			</div>

			<div class="mt-3 d-flex gap-3">

				<span class="badge bg-primary">
					المدين: <span id="debitTotal">0.00</span>
				</span>

				<span class="badge bg-info text-dark">
					الدائن: <span id="creditTotal">0.00</span>
				</span>

				<span id="balanceBadge" class="badge bg-success">
					متوازن
				</span>

			</div>

		</div>

	</div>

	<div class="d-flex justify-content-end gap-2">

		<a asp-action="Journal"
		   class="btn btn-outline-secondary">
			إلغاء
		</a>

		<button type="submit"
				class="btn btn-success px-4">
			@(Model.Id > 0 ? "حفظ التعديلات" : "حفظ القيد (مسودة)")
		</button>

	</div>

</form>

@section Scripts
{
	<partial name="_ValidationScriptsPartial" />

	<script>
		// ✅ Html.Raw ضرورية لمنع Razor من ترميز JSON إلى HTML entities (&quot; &amp;)
		const accountsJson =
			@Html.Raw(System.Text.Json.JsonSerializer.Serialize(
				Model.Accounts.Select(x => new
				{
					id = x.Key,
					name = x.Value
				}),
				new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }
			));

		const linesBody =
			document.getElementById("linesBody");

		const addLineBtn =
			document.getElementById("addLineBtn");

		const debitTotal =
			document.getElementById("debitTotal");

		const creditTotal =
			document.getElementById("creditTotal");

		const balanceBadge =
			document.getElementById("balanceBadge");

		function accountOptions(selectedId) {
			let html =
				'<option value="0">-- اختر الحساب --</option>';

			accountsJson.forEach(
				account => {
					html +=
						`<option value="${account.id}"${account.id === selectedId ? " selected" : ""}>
                                ${account.name}
                            </option>`;
				}
			);

			return html;
		}

		if (addLineBtn) {
			addLineBtn.addEventListener(
				"click",
				function() {
					const index =
						linesBody.querySelectorAll(".line-row").length;

					const tr =
						document.createElement("tr");

					tr.className = "line-row";

					tr.innerHTML = `
                        <td>
                            <select name="Lines[${index}].ChartAccountId"
                                    class="form-select account-select">
                                ${accountOptions(0)}
                            </select>
                        </td>
                        <td>
                            <input type="number"
                                   name="Lines[${index}].Debit"
                                   class="form-control debit-input"
                                   value="0"
                                   min="0"
                                   step="0.01" />
                        </td>
                        <td>
                            <input type="number"
                                   name="Lines[${index}].Credit"
                                   class="form-control credit-input"
                                   value="0"
                                   min="0"
                                   step="0.01" />
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm remove-line">
                                حذف
                            </button>
                        </td>
                    `;

					linesBody.appendChild(tr);
				}
			);
		}

		if (linesBody) {
			linesBody.addEventListener(
				"click",
				function(event) {
					if (!event.target.classList.contains("remove-line")) {
						return;
					}

					const row =
						event.target.closest(".line-row");

					if (row) {
						row.remove();
						reindex();
					}
				}
			);

			linesBody.addEventListener(
				"input",
				updateTotals
			);
		}

		function reindex() {
			const rows =
				linesBody.querySelectorAll(".line-row");

			rows.forEach(
				(row, i) => {
					row.querySelector("select").name =
						`Lines[${i}].ChartAccountId`;

					const inputs =
						row.querySelectorAll("input");

					inputs[0].name = `Lines[${i}].Debit`;
					inputs[1].name = `Lines[${i}].Credit`;
				}
			);
		}

		function updateTotals() {
			let debit = 0;
			let credit = 0;
			let invalidLine = false;

			linesBody
				.querySelectorAll(".line-row")
				.forEach(row => {
					const d =
						parseFloat(
							row.querySelector(".debit-input").value
						) || 0;

					const c =
						parseFloat(
							row.querySelector(".credit-input").value
						) || 0;

					if (d > 0 && c > 0) {
						invalidLine = true;
					}

					debit += d;
					credit += c;
				});

			debitTotal.textContent = debit.toFixed(2);
			creditTotal.textContent = credit.toFixed(2);

			if (invalidLine) {
				balanceBadge.className = "badge bg-warning text-dark";
				balanceBadge.textContent =
					"لا يجوز مدين ودائن في نفس السطر";
				return;
			}

			if (Math.abs(debit - credit) > 0.005) {
				balanceBadge.className = "badge bg-danger";
				balanceBadge.textContent =
					`الفرق ${Math.abs(debit - credit).toFixed(2)}`;
			} else {
				balanceBadge.className = "badge bg-success";
				balanceBadge.textContent = "متوازن";
			}
		}

		updateTotals();
	</script>
}