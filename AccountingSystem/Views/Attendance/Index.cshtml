@model List<AccountingSystem.Models.Attendance>

@{
	ViewData["Title"] = "سجل الحضور";

	var employees = ViewBag.Employees as List<AccountingSystem.Models.Employee>
		?? new List<AccountingSystem.Models.Employee>();

	var search = ViewBag.Search as string ?? "";
	var employeeId = ViewBag.EmployeeId as int?;
	var status = ViewBag.Status as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="mb-1">سجل الحضور</h2>
		<p class="text-muted mb-0 small">متابعة حضور وانصراف الموظفين</p>
	</div>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="card mb-3 shadow-sm border-0">
	<div class="card-body">
		<form asp-action="Index" method="get">
			<div class="row g-2">
				<div class="col-md-4">
					<input type="text" name="search" value="@search"
						   class="form-control" placeholder="🔎 بحث باسم الموظف" />
				</div>
				<div class="col-md-3">
					<select name="employeeId" class="form-select">
						<option value="">كل الموظفين</option>
						@foreach (var emp in employees)
						{
							<option value="@emp.Id" selected="@(employeeId == emp.Id)">@emp.Name</option>
						}
					</select>
				</div>
				<div class="col-md-3">
					<select name="status" class="form-select">
						<option value="">كل الحالات</option>
						<option value="Present" selected="@(status == "Present")">حاضر</option>
						<option value="Absent" selected="@(status == "Absent")">غائب</option>
						<option value="Late" selected="@(status == "Late")">متأخر</option>
						<option value="OnLeave" selected="@(status == "OnLeave")">في إجازة</option>
					</select>
				</div>
				<div class="col-md-2">
					<button type="submit" class="btn btn-secondary w-100">تصفية</button>
				</div>
			</div>
		</form>
	</div>
</div>

@if (Model == null || !Model.Any())
{
	<div class="alert alert-info">لا يوجد سجلات حضور حتى الآن.</div>
}
else
{
	<div class="card border-0 shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover mb-0">
					<thead class="table-light">
						<tr>
							<th>الموظف</th>
							<th>التاريخ</th>
							<th>وقت الحضور</th>
							<th>وقت الانصراف</th>
							<th>الحالة</th>
							<th>ملاحظات</th>
							<th style="width: 120px;">إجراءات</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var record in Model)
						{
							<tr>
								<td>
									<div class="fw-semibold">@(record.Employee?.Name ?? "-")</div>
								</td>
								<td>@record.Date.ToString("yyyy-MM-dd")</td>
								<td>@(record.CheckIn?.ToString("HH:mm") ?? "-")</td>
								<td>@(record.CheckOut?.ToString("HH:mm") ?? "-")</td>
								<td>
									@if (record.Status == AttendanceStatus.Present)
									{
										<span class="badge bg-success">حاضر</span>
									}
									else if (record.Status == AttendanceStatus.Absent)
									{
										<span class="badge bg-danger">غائب</span>
									}
									else if (record.Status == AttendanceStatus.Late)
									{
										<span class="badge bg-warning text-dark">متأخر</span>
									}
									else if (record.Status == AttendanceStatus.OnLeave)
									{
										<span class="badge bg-info text-dark">في إجازة</span>
									}
								</td>
								<td>@(record.Notes ?? "-")</td>
								<td>
									<div class="d-flex gap-1">
										@if (!record.CheckIn.HasValue)
										{
											<form asp-action="CheckIn" asp-route-employeeId="@record.EmployeeId" method="post">
												@Html.AntiForgeryToken()
												<button type="submit" class="btn btn-sm btn-success">حضور</button>
											</form>
										}
										else if (!record.CheckOut.HasValue)
										{
											<form asp-action="CheckOut" asp-route-employeeId="@record.EmployeeId" method="post">
												@Html.AntiForgeryToken()
												<button type="submit" class="btn btn-sm btn-danger">انصراف</button>
											</form>
										}
										else
										{
											<span class="text-muted small">مكتمل</span>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
