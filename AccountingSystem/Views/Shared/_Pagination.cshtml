@using AccountingSystem.Models.ViewModels.Pagination
@model IPagedResult

@if (Model.TotalPages > 1)
{
	<nav aria-label="Page navigation">
		<ul class="pagination justify-content-center">
			<li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
				<a class="page-link" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">السابق</a>
			</li>
			@for (int i = 1; i <= Model.TotalPages; i++)
			{
				<li class="page-item @(i == Model.PageNumber ? "active" : "")">
					<a class="page-link" asp-route-page="@i" asp-route-pageSize="@Model.PageSize">@i</a>
				</li>
			}
			<li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
				<a class="page-link" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">التالي</a>
			</li>
		</ul>
	</nav>
}