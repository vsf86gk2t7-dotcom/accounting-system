@model AccountingSystem.Models.LeaveRequest

@{
	ViewData["Title"] = "طلب إجازة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="mb-1">طلب إجازة جديد</h2>
		<p class="text-muted mb-0 small">إرسال طلب إجازة جديد</p>
	</div>
	<a asp-action="MyLeaves" class="btn btn-outline-secondary">← رجوع</a>
</div>

<div class="card shadow-sm border-0">
	<div class="card-body">
		<form asp-action="Create" method="post">
			@Html.AntiForgeryToken()

			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

			<div class="row g-3">
				<div class="col-md-6">
					<label asp-for="StartDate" class="form-label">من تاريخ <span class="text-danger">*</span></label>
					<input asp-for="StartDate" type="date" class="form-control" required />
					<span asp-validation-for="StartDate" class="text-danger small"></span>
				</div>

				<div class="col-md-6">
					<label asp-for="EndDate" class="form-label">إلى تاريخ <span class="text-danger">*</span></label>
					<input asp-for="EndDate" type="date" class="form-control" required />
					<span asp-validation-for="EndDate" class="text-danger small"></span>
				</div>

				<div class="col-12">
					<label asp-for="Reason" class="form-label">سبب الإجازة <span class="text-danger">*</span></label>
					<textarea asp-for="Reason" class="form-control" rows="3" maxlength="500"
							  placeholder="اكتب سبب الإجازة" required></textarea>
					<span asp-validation-for="Reason" class="text-danger small"></span>
				</div>
			</div>

			<hr class="my-4" />

			<button type="submit" class="btn btn-success">إرسال الطلب</button>
		</form>
	</div>
</div>
