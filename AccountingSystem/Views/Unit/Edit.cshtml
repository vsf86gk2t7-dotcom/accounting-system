@model AccountingSystem.Models.Unit

@{
	ViewData["Title"] = "تعديل الوحدة";
}

<div class="container mt-4">

	<h2 class="mb-4">تعديل الوحدة</h2>

	<div class="card shadow-sm">

		<div class="card-body">

			<form asp-action="Edit"
				  method="post">

				@Html.AntiForgeryToken()

				<input asp-for="Id" type="hidden" />

				<div asp-validation-summary="ModelOnly"
					 class="text-danger mb-3">
				</div>

				<div class="mb-3">

					<label asp-for="Name"
						   class="form-label">
						اسم الوحدة
					</label>

					<input asp-for="Name"
						   class="form-control"
						   required />

					<span asp-validation-for="Name"
						  class="text-danger">
					</span>

				</div>

				<div class="mb-3">

					<label asp-for="ShortName"
						   class="form-label">
						الاختصار
					</label>

					<input asp-for="ShortName"
						   class="form-control" />

					<span asp-validation-for="ShortName"
						  class="text-danger">
					</span>

				</div>

				<button type="submit"
						class="btn btn-success">
					حفظ التعديلات
				</button>

				<a asp-action="Index"
				   class="btn btn-secondary">
					إلغاء
				</a>

			</form>

		</div>

	</div>

</div>