@model List<AccountingSystem.ViewModels.SalesRepListItem>

@{
ViewData["Title"] = "المناديب";
string TypeLabel(AccountingSystem.Models.CommissionType t, decimal r) => t switch
{
AccountingSystem.Models.CommissionType.PercentOfSales => $"{r:0.##}% من المبيعات",
AccountingSystem.Models.CommissionType.PercentOfCollections => $"{r:0.##}% من التحصيل",
_ => $"{r:0.##} ج لكل فاتورة"
};
}

<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h2 class="mb-1">المناديب</h2>
<p class="text-muted mb-0 small">مبيعات الشهر الحالي، العمولة، والعملاء</p>
</div>
<a asp-action="Create" class="btn btn-primary">إضافة مندوب</a>
</div>

<div class="card shadow-sm border-0">
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>المندوب</th>
<th>العمولة</th>
<th>مبيعات الشهر</th>
<th>الهدف</th>
<th>العملاء</th>
<th>مخزن العهدة</th>
<th>الحالة</th>
<th></th>
</tr>
</thead>
<tbody>
@foreach (var r in Model)
{
var pct = r.MonthlyTarget > 0 ? Math.Min(100, (int)(r.MonthSales * 100 / r.MonthlyTarget)) : 0;
<tr>
<td>
<a asp-action="Details" asp-route-id="@r.Id">@r.EmployeeName</a>
<div class="small text-muted">@r.Phone</div>
</td>
<td>@TypeLabel(r.CommissionType, r.CommissionRate)</td>
<td>@r.MonthSales.ToString("N2")</td>
<td style="min-width:140px">
@if (r.MonthlyTarget > 0)
{
<div class="small">@r.MonthlyTarget.ToString("N0") (@pct%)</div>
<div class="progress" style="height:6px">
<div class="progress-bar" style="width:@pct%"></div>
</div>
}
else
{
<span class="text-muted small">—</span>
}
</td>
<td>@r.CustomersCount</td>
<td>@(r.StoreName ?? "—")</td>
<td>
<span class="badge @(r.IsActive ? "bg-success" : "bg-secondary")">
@(r.IsActive ? "فعّال" : "معطّل")
</span>
</td>
<td class="text-end text-nowrap">
<a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
<form asp-action="ToggleActive" asp-route-id="@r.Id" method="post" class="d-inline">
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-sm btn-outline-secondary">
@(r.IsActive ? "تعطيل" : "تفعيل")
</button>
</form>
</td>
</tr>
}
@if (!Model.Any())
{
<tr><td colspan="8" class="text-center text-muted py-4">لا يوجد مناديب بعد</td></tr>
}
</tbody>
</table>
</div>
</div>