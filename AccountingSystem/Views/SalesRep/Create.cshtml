@model AccountingSystem.ViewModels.SalesRepCreateViewModel

@{
ViewData["Title"] = "إضافة مندوب";
var employees = (IEnumerable<AccountingSystem.Models.Employee>)ViewBag.Employees;
var branches = (IEnumerable<AccountingSystem.Models.Branch>)ViewBag.Branches;
}

<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h2 class="mb-1">إضافة مندوب</h2>
<p class="text-muted mb-0 small">
سيتم إنشاء مخزن عهدة وخزنة نقدية للمندوب تلقائيًا، وتقييد صلاحياته بهما.
</p>
</div>
<a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
</div>

<div class="card shadow-sm border-0">
<div class="card-body">
<form asp-action="Create" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
<div class="col-md-6">
<label asp-for="EmployeeId" class="form-label">الموظف <span class="text-danger">*</span></label>
<select asp-for="EmployeeId" class="form-select"
asp-items="@(new SelectList(employees, "Id", "Name"))">
<option value="">— اختر —</option>
</select>
<span asp-validation-for="EmployeeId" class="text-danger small"></span>
</div>

<div class="col-md-6">
<label asp-for="BranchId" class="form-label">فرع العهدة <span class="text-danger">*</span></label>
<select asp-for="BranchId" class="form-select"
asp-items="@(new SelectList(branches, "Id", "Name"))">
<option value="">— اختر —</option>
</select>
<span asp-validation-for="BranchId" class="text-danger small"></span>
</div>

<div class="col-md-4">
<label asp-for="CommissionType" class="form-label">نوع العمولة</label>
<select asp-for="CommissionType" class="form-select">
<option value="1">نسبة من المبيعات</option>
<option value="2">نسبة من التحصيل</option>
<option value="3">مبلغ ثابت لكل فاتورة</option>
</select>
</div>

<div class="col-md-4">
<label asp-for="CommissionRate" class="form-label">النسبة (%) أو المبلغ</label>
<input asp-for="CommissionRate" type="number" step="0.01" min="0" class="form-control" />
<span asp-validation-for="CommissionRate" class="text-danger small"></span>
</div>

<div class="col-md-4">
<label asp-for="MonthlyTarget" class="form-label">الهدف الشهري (جنيه)</label>
<input asp-for="MonthlyTarget" type="number" step="0.01" min="0" class="form-control" />
<span asp-validation-for="MonthlyTarget" class="text-danger small"></span>
</div>
</div>

<div class="mt-4">
<button type="submit" class="btn btn-primary">حفظ</button>
</div>
</form>
</div>
</div>