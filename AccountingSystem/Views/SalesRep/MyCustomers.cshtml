@model List<AccountingSystem.Models.Customer>

@{
ViewData["Title"] = "عملائي";
}

<div class="d-flex justify-content-between align-items-center mb-4">
<div>
<h2 class="mb-1">عملائي</h2>
<p class="text-muted mb-0 small">العملاء المرتبطون بك فقط (@Model.Count)</p>
</div>
<a asp-action="Dashboard" class="btn btn-outline-secondary"><i class="bi bi-speedometer2"></i> لوحة التحكم</a>
</div>

<div class="card shadow-sm border-0">
<div class="table-responsive">
<table class="table align-middle mb-0">
<thead>
<tr>
<th>العميل</th>
<th>الهاتف</th>
<th>البريد</th>
<th>العنوان</th>
<th>أيام الائتمان</th>
<th>الحالة</th>
</tr>
</thead>
<tbody>
@foreach (var c in Model)
{
<tr>
<td class="fw-bold">@c.Name</td>
<td class="small">@c.Phone</td>
<td class="small text-muted">@(c.Email ?? "—")</td>
<td class="small text-muted">@(c.Address ?? "—")</td>
<td>@c.CreditDays</td>
<td>
<span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
@(c.IsActive ? "نشط" : "موقوف")
</span>
</td>
</tr>
}
@if (!Model.Any())
{
<tr><td colspan="6" class="text-center text-muted py-4">لا يوجد عملاء مرتبطون بك بعد</td></tr>
}
</tbody>
</table>
</div>
</div>
