@model AccountingSystem.Models.ViewModels.Pagination.PagedResult<AccountingSystem.Models.PurchaseInvoice>

@{
	ViewData["Title"] = "فواتير الشراء";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h3>فواتير الشراء</h3>

	<a asp-action="Create" class="btn btn-primary">
		+ فاتورة شراء جديدة
	</a>
</div>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show">
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show">
		@TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (Model == null || !Model.Items.Any())
{
	<div class="alert alert-info">
		لا يوجد فواتير شراء حتى الآن.
	</div>
}
else
{
	<table class="table table-striped table-hover">
		<thead class="table-dark">
			<tr>
				<th>#</th>
				<th>رقم الفاتورة</th>
				<th>المورد</th>
				<th>المخزن</th>
				<th>التاريخ</th>
				<th>الإجمالي</th>
				<th>الحالة</th>
				<th>إجراءات</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var invoice in Model.Items)
			{
				<tr>
					<td>@invoice.Id</td>
					<td>@invoice.InvoiceNumber</td>
					<td>@(invoice.Supplier?.Name ?? "-")</td>
					<td>@(invoice.Store?.Name ?? "-")</td>
					<td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
					<td>@invoice.TotalAmount.ToString("N2")</td>
					<td>
						@switch (invoice.Status)
						{
							case AccountingSystem.Models.PurchaseInvoiceStatus.Draft:
								<span class="badge bg-warning text-dark">مسودة</span>
								break;
							case AccountingSystem.Models.PurchaseInvoiceStatus.Posted:
								<span class="badge bg-success">مُرحّلة</span>
								break;
							case AccountingSystem.Models.PurchaseInvoiceStatus.Cancelled:
								<span class="badge bg-danger">ملغاة</span>
								break;
						}
					</td>
					<td>
						<a asp-action="Details"
						   asp-route-id="@invoice.Id"
						   class="btn btn-sm btn-outline-primary">
							تفاصيل
						</a>

						@if (invoice.Status == AccountingSystem.Models.PurchaseInvoiceStatus.Draft)
						{
							<form asp-action="Post"
								  asp-route-id="@invoice.Id"
								  method="post"
								  class="d-inline">
								@Html.AntiForgeryToken()
								<button type="submit"
										class="btn btn-sm btn-success"
										onclick="return confirm('سيتم ترحيل الفاتورة وإضافة الكميات إلى المخزون. متابعة؟');">
									ترحيل
								</button>
							</form>
						}

						@if (invoice.Status != AccountingSystem.Models.PurchaseInvoiceStatus.Cancelled)
						{
							<form asp-action="Cancel"
								  asp-route-id="@invoice.Id"
								  method="post"
								  class="d-inline">
								@Html.AntiForgeryToken()
								<button type="submit"
										class="btn btn-sm btn-outline-danger"
										onclick="return confirm('سيتم إلغاء الفاتورة. متابعة؟');">
									إلغاء
								</button>
							</form>
						}
						else
						{
							<span class="text-muted">—</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>

	<partial name="_Pagination" model="Model" />
}