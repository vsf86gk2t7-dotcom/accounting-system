@model AccountingSystem.Models.Company

@{
	ViewData["Title"] = "إضافة الشركة";
}

<div class="container mt-4">

	<h2 class="mb-4">بيانات الشركة</h2>

	<div class="card shadow-sm">
		<div class="card-body">

			<form asp-action="Create"
				  method="post"
				  enctype="multipart/form-data">

				@Html.AntiForgeryToken()

				<div asp-validation-summary="ModelOnly"
					 class="text-danger mb-3">
				</div>

				<div class="mb-3">
					<label asp-for="Name"
						   class="form-label">
						اسم الشركة
					</label>

					<input asp-for="Name"
						   class="form-control"
						   required />

					<span asp-validation-for="Name"
						  class="text-danger">
					</span>
				</div>

				<div class="mb-3">
					<label asp-for="Phone"
						   class="form-label">
						رقم الهاتف
					</label>

					<input asp-for="Phone"
						   type="tel"
						   class="form-control" />
				</div>

				<div class="mb-3">
					<label asp-for="Email"
						   class="form-label">
						البريد الإلكتروني
					</label>

					<input asp-for="Email"
						   type="email"
						   class="form-control" />
				</div>

				<div class="mb-3">
					<label asp-for="Address"
						   class="form-label">
						العنوان
					</label>

					<textarea asp-for="Address"
							  class="form-control"
							  rows="3">
					</textarea>
				</div>

				<div class="mb-3">
					<label asp-for="TaxNumber"
						   class="form-label">
						الرقم الضريبي
					</label>

					<input asp-for="TaxNumber"
						   class="form-control" />
				</div>

				<div class="mb-3">
					<label asp-for="CommercialRegister"
						   class="form-label">
						السجل التجاري
					</label>

					<input asp-for="CommercialRegister"
						   class="form-control" />
				</div>

				<div class="mb-3">
					<label class="form-label">
						شعار الشركة (اختياري)
					</label>

					<input type="file"
						   name="logo"
						   accept="image/*"
						   class="form-control" />
				</div>

				<button type="submit"
						class="btn btn-success">
					حفظ الشركة
				</button>

			</form>

		</div>
	</div>

</div>